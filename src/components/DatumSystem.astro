---
// Datum, drawn as a system. One plate per part, laid out in the layers a
// request passes through, with the tenant boundary drawn around the three
// layers that enforce it. Rest on a plate and the caption underneath explains
// it. Every figure and claim here is already on this page or in the decision
// logs it links; the drawing adds no number the site does not state elsewhere.

import copy from '../data/copy/work-datum.json';

// the words live in work-datum.json under "system"
const groups = copy.system.groups;

const first = groups[0].layers[0].nodes[0];
---

<div class="sys" id="sys">
  <p class="sys-head">{copy.system.heading}</p>
  <p class="sys-note">
    {copy.system.note}
  </p>

  <div class="sys-body">
    {
      groups.map((g) => (
        <div class:list={['sys-group', { 'sys-inside': g.inside }]}>
          {g.inside && <span class="sys-inside-label">{copy.system.insideLabel}</span>}
          {g.layers.map((layer) => (
            <div class="sys-layer">
              <span class="sys-key">{layer.label}</span>
              <div class="sys-plates" style={`--n: ${layer.nodes.length}`}>
                {layer.nodes.map((n) => (
                  <button
                    type="button"
                    class:list={['sys-plate', { 'is-on': n === first }]}
                    data-name={n.name}
                    data-text={n.text}
                  >
                    <span class="sys-name">{n.name}</span>
                    <span class="sys-fig">{n.fig}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>

  <div class="sys-caption" aria-live="polite">
    <p class="sys-cap-name" id="sys-cap-name">{first.name}</p>
    <p class="sys-cap-text" id="sys-cap-text">{first.text}</p>
  </div>
</div>

<script>
  const sys = document.getElementById('sys');
  if (sys) {
    const name = document.getElementById('sys-cap-name')!;
    const text = document.getElementById('sys-cap-text')!;
    const plates = Array.from(sys.querySelectorAll<HTMLButtonElement>('.sys-plate'));
    const pick = (b: HTMLButtonElement): void => {
      plates.forEach((p) => p.classList.toggle('is-on', p === b));
      name.textContent = b.dataset.name ?? '';
      text.textContent = b.dataset.text ?? '';
    };
    plates.forEach((b) => {
      b.addEventListener('pointerenter', () => pick(b));
      b.addEventListener('focus', () => pick(b));
      b.addEventListener('click', () => pick(b));
    });
  }
</script>

<style>
  .sys {
    margin-top: 4rem;
    --line: rgba(243, 241, 236, 0.28);
    --line-soft: rgba(243, 241, 236, 0.14);
    --dim: #b7ad9c;
  }
  .sys-head {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sunflower);
  }
  .sys-note {
    margin-top: 0.5rem;
    color: var(--dim);
  }
  .sys-body {
    margin-top: 2rem;
    display: grid;
    gap: 0;
  }
  .sys-group {
    display: grid;
    gap: 1.1rem;
    position: relative;
    padding: 0.2rem 0;
  }
  /* the boundary: a dashed fence with its label on the post */
  .sys-inside {
    margin: 1.2rem 0;
    padding: 1.6rem 1.1rem 1.1rem;
    border: 1px dashed var(--line);
  }
  .sys-inside-label {
    position: absolute;
    top: -0.55rem;
    left: 0.9rem;
    padding: 0 0.5rem;
    background: #1e2022;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sunflower);
  }
  /* the line a request follows: a short stem between every layer, drawn as an
     absolutely placed pseudo-element so it never becomes a grid item itself */
  .sys-layer,
  .sys-group {
    position: relative;
  }
  .sys-layer + .sys-layer {
    margin-top: 1.1rem;
  }
  .sys-group + .sys-group {
    margin-top: 1.4rem;
  }
  .sys-layer + .sys-layer::before,
  .sys-group + .sys-group::before {
    content: '';
    position: absolute;
    top: -1.1rem;
    height: 1.1rem;
    width: 1px;
    /* centred over the plates column, which starts after the key column */
    left: calc(7.5rem + (100% - 7.5rem) / 2);
    background: var(--line);
  }
  .sys-group + .sys-group::before {
    top: -1.4rem;
    height: 1.4rem;
    left: 50%;
  }
  .sys-layer {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    align-items: start;
  }
  .sys-key {
    padding-top: 0.85rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .sys-plates {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 0.6rem;
  }
  .sys-plate {
    display: grid;
    gap: 0.3rem;
    justify-items: start;
    text-align: left;
    padding: 0.8rem 0.9rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0;
    background: rgba(243, 241, 236, 0.03);
    color: #f3f1ec;
    cursor: default;
    transition:
      border-color 0.35s var(--ease-warm),
      background 0.35s var(--ease-warm);
  }
  .sys-plate:hover,
  .sys-plate:focus-visible,
  .sys-plate.is-on {
    border-color: var(--sunflower);
    background: rgba(217, 151, 30, 0.1);
    outline: none;
  }
  .sys-plate:focus-visible {
    box-shadow: 0 0 0 2px rgba(217, 151, 30, 0.45);
  }
  .sys-name {
    font-family: var(--display);
    font-variation-settings: 'opsz' 40, 'SOFT' 40, 'WONK' 0;
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.15;
  }
  .sys-fig {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .sys-caption {
    margin-top: 1.8rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    min-height: 7.5rem;
  }
  .sys-cap-name {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sunflower);
  }
  .sys-cap-text {
    margin-top: 0.5rem;
    color: #d9d2c4;
  }
  @media (max-width: 700px) {
    .sys-layer {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .sys-key {
      padding-top: 0;
    }
    .sys-plates {
      grid-template-columns: 1fr;
    }
    .sys-layer + .sys-layer::before {
      left: 50%;
    }
    .sys-caption {
      min-height: 9rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sys-plate {
      transition: none;
    }
  }
</style>
