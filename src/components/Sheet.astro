---
// A proof sheet of frames. Each frame is a plate: it opens in the viewer at
// full size when the page mounts one (see Viewer.astro).
interface Props {
  label: string;
  frames: { src: string; alt: string }[];
}
const { label, frames } = Astro.props;
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="sheet-block">
  <p class="sheet-label">{label}</p>
  <div class="sheet">
    {
      frames.map((f, i) => (
        <figure
          data-plate
          data-title={label}
          data-meta={`Frame ${num(i)}`}
          tabindex="0"
          role="button"
          aria-label={`Open frame ${num(i)} at full size`}
        >
          <img src={f.src} alt={f.alt} width="900" height="600" loading="lazy" />
          <figcaption>{num(i)}</figcaption>
        </figure>
      ))
    }
  </div>
</section>
