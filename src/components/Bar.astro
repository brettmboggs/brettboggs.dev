---
// The top bar every page shares: the name, the sections, the one action.
// Links point at the homepage's sections so they work from any page.
import copy from '../data/copy/home.json';

const { nav } = copy;
const onHome = Astro.url.pathname === '/';
const href = (url: string): string => (url.startsWith('#') && !onHome ? `/${url}` : url);
---

<header class="bar">
  <div class="bar-in">
    <a class="mark" href="/">
      <span class="mark-name">{nav.name}</span>
      <span class="mark-role">{nav.role}</span>
    </a>
    <nav class="bar-nav" aria-label={nav.label}>
      {nav.links.map((l) => <a href={href(l.url)}>{l.text}</a>)}
      <a class="bar-sb" href={nav.switchboard.url}>{nav.switchboard.text}</a>
    </nav>
    <a class="bar-cta" href={href('#start')}>{nav.cta}</a>
    <details class="bar-menu">
      <summary>{nav.menu}</summary>
      <nav aria-label={nav.label}>
        {nav.links.map((l) => <a href={href(l.url)}>{l.text}</a>)}
        <a class="bar-sb" href={nav.switchboard.url}>{nav.switchboard.text}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 30;
    view-transition-name: site-bar;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .bar-in {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 1280px;
    height: 68px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  .bar a {
    background-image: none;
  }
  .mark {
    display: grid;
    gap: 5px;
    line-height: 1;
    color: var(--ink);
  }
  .mark:hover {
    color: var(--ink);
  }
  .mark-name {
    font-family: var(--display);
    font-weight: 850;
    font-stretch: 125%;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .mark-name::after {
    content: '.';
    color: var(--sig);
  }
  .mark-role {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--soft);
  }
  .bar-nav {
    display: flex;
    gap: 1.6rem;
    margin-left: auto;
  }
  .bar-nav a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-2);
    transition: color 0.2s;
  }
  .bar-nav a:hover {
    color: var(--ink);
  }
  .bar-nav a.bar-sb,
  .bar-menu nav a.bar-sb {
    color: var(--sig-text);
    font-weight: 600;
  }
  .bar-nav a.bar-sb:hover,
  .bar-menu nav a.bar-sb:hover {
    color: var(--ink);
  }
  .bar-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 1.15rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--sheet);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition: transform 0.35s var(--ease), background-color 0.25s, color 0.25s;
  }
  .bar-cta:hover {
    transform: translateY(-2px);
    color: var(--sheet);
  }
  .bar-cta:active {
    transform: translateY(1px) scale(0.98);
  }
  .bar-menu {
    display: none;
  }
  @media (max-width: 900px) {
    .bar-in {
      gap: 0.75rem;
    }
    .bar-nav {
      display: none;
    }
    .bar-cta {
      margin-left: auto;
      padding: 0.7rem 1rem;
    }
    .bar-menu {
      display: block;
    }
    .bar-menu summary {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 1rem;
      border: 1px solid var(--hair);
      border-radius: 999px;
      font-family: var(--mono);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink);
      cursor: pointer;
      list-style: none;
    }
    .bar-menu summary::-webkit-details-marker {
      display: none;
    }
    .bar-menu[open] summary {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--sheet);
    }
    .bar-menu nav {
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      display: grid;
      padding: 0.5rem clamp(20px, 4vw, 48px) 1rem;
      background: var(--sheet);
      border-bottom: 1px solid var(--hair);
      box-shadow: 0 12px 24px -16px rgb(21 23 28 / 0.25);
    }
    .bar-menu nav a {
      display: flex;
      align-items: center;
      min-height: 48px;
      border-bottom: 1px solid var(--grid);
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--ink);
    }
    .bar-menu nav a:last-child {
      border-bottom: 0;
    }
  }
  @media (max-width: 460px) {
    .mark-role {
      display: none;
    }
  }
</style>
