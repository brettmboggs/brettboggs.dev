---
// The top bar every page shares: the name, the sections, the one action.
// Links point at the homepage's sections so they work from any page.
import copy from '../data/copy/home.json';

const { nav } = copy;
const onHome = Astro.url.pathname === '/';
const href = (url: string): string => (url.startsWith('#') && !onHome ? `/${url}` : url);
---

<header class="bar">
  <div class="bar-in">
    <a class="mark" href="/">
      <span class="mark-name">{nav.name}</span>
      <span class="mark-role">{nav.role}</span>
    </a>
    <nav class="bar-nav" aria-label={nav.label}>
      {nav.links.map((l) => <a href={href(l.url)}>{l.text}</a>)}
    </nav>
    <a class="bar-cta" href={href('#start')}>{nav.cta}</a>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 30;
    view-transition-name: site-bar;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .bar-in {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 1280px;
    height: 68px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  .bar a {
    background-image: none;
  }
  .mark {
    display: grid;
    gap: 5px;
    line-height: 1;
    color: var(--ink);
  }
  .mark:hover {
    color: var(--ink);
  }
  .mark-name {
    font-family: var(--display);
    font-weight: 850;
    font-stretch: 125%;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .mark-name::after {
    content: '.';
    color: var(--sig);
  }
  .mark-role {
    font-family: var(--mono);
    font-size: 0.56rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .bar-nav {
    display: flex;
    gap: 1.6rem;
    margin-left: auto;
  }
  .bar-nav a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-2);
    transition: color 0.2s;
  }
  .bar-nav a:hover {
    color: var(--ink);
  }
  .bar-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 1.15rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--sheet);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition: transform 0.35s var(--ease), background-color 0.25s, color 0.25s;
  }
  .bar-cta:hover {
    transform: translateY(-2px);
    color: var(--sheet);
  }
  .bar-cta:active {
    transform: translateY(1px) scale(0.98);
  }
  @media (max-width: 900px) {
    .bar-nav {
      display: none;
    }
    .bar-cta {
      margin-left: auto;
      padding: 0.7rem 1rem;
    }
  }
</style>
