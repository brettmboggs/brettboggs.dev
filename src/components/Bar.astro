---
// The top bar every page shares: the name, the sections, the one action.
// Links point at the homepage's sections so they work from any page.
import copy from '../data/copy/home.json';

const { nav } = copy;
const onHome = Astro.url.pathname === '/';
const href = (url: string): string => (url.startsWith('#') && !onHome ? `/${url}` : url);
---

<header class="bar">
  <div class="bar-in">
    <a class="mark" href="/">
      <span class="mark-name">{nav.name}</span>
      <span class="mark-role">{nav.role}</span>
    </a>
    <p class="coords" id="coords" aria-hidden="true"><span>X 0000</span><span>Y 0000</span></p>
    <nav class="bar-nav" aria-label={nav.label}>
      {nav.links.map((l) => <a href={href(l.url)}>{l.text}</a>)}
    </nav>
    <a class="bar-cta" href={href('#start')}>{nav.cta}</a>
  </div>
</header>

<script>
  // a drafting readout: where the pointer sits on the sheet, in page pixels.
  // decoration only, so it stays quiet for reduced motion and touch.
  const out = document.getElementById('coords');
  const fine = window.matchMedia('(pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (out && fine && !reduced) {
    const [x, y] = Array.from(out.querySelectorAll('span'));
    const pad = (n: number): string => String(Math.max(0, Math.round(n))).padStart(4, '0');
    let raf = 0;
    window.addEventListener(
      'pointermove',
      (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          x.textContent = `X ${pad(e.pageX)}`;
          y.textContent = `Y ${pad(e.pageY)}`;
        });
      },
      { passive: true },
    );
    out.classList.add('is-live');
  }
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 30;
    view-transition-name: site-bar;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1px solid var(--ink);
  }
  .bar-in {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 1280px;
    height: 68px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  .bar a {
    background-image: none;
  }
  .mark {
    display: grid;
    gap: 4px;
    line-height: 1;
    color: var(--ink);
  }
  .mark:hover {
    color: var(--ink);
  }
  .mark-name {
    font-weight: 800;
    font-stretch: 72%;
    font-size: 1.35rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .mark-name::after {
    content: '.';
    color: var(--sig);
  }
  .mark-role {
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .coords {
    display: none;
    gap: 0.9rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  @media (min-width: 1180px) {
    .coords {
      display: flex;
    }
    .coords:global(.is-live) {
      opacity: 1;
    }
  }
  .bar-nav {
    display: flex;
    gap: 2rem;
    margin-left: auto;
  }
  .bar-nav a {
    position: relative;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--ink);
  }
  .bar-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--sig);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .bar-nav a:hover {
    color: var(--ink);
  }
  .bar-nav a:hover::after {
    transform: scaleX(1);
  }
  .bar-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1rem;
    border: 1.5px solid var(--ink);
    background: var(--ink);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .bar-cta:hover {
    background: var(--sig);
    border-color: var(--sig);
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .bar-nav {
      display: none;
    }
    .bar-cta {
      margin-left: auto;
    }
  }
</style>
