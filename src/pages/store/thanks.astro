---
import Base from '../../layouts/Base.astro';

// This page reports, it does not decide. Stripe sends the buyer here after a
// payment attempt, and the outcome is read back from the PaymentIntent rather
// than assumed from the fact that the redirect happened. Fulfillment itself is
// the webhook's job and has very likely already run by the time this loads.
---

<Base title="Thank you · Brett Boggs" description="Order received." noindex={true} puck={false} noServiceWorker={true}>
  <script slot="head" is:inline src="https://js.stripe.com/v3/"></script>

  <header class="page-head">
    <p class="eyebrow">Store</p>
    <h1 id="headline">Checking</h1>
    <p class="lede" id="detail">One moment.</p>
  </header>

  <p class="next" id="next" hidden></p>

  <a class="back-link" href="/store/">&larr; Store</a>
</Base>

<style>
  .next {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid color-mix(in oklab, var(--ink) 18%, transparent);
    max-width: var(--measure);
    color: var(--ink-soft);
  }
</style>

<script>
  import { clearCart } from '../../scripts/store';

  const headline = document.getElementById('headline')!;
  const detail = document.getElementById('detail')!;
  const next = document.getElementById('next')!;

  const say = (title: string, body: string, footer?: string) => {
    headline.textContent = title;
    detail.textContent = body;
    if (footer) {
      next.textContent = footer;
      next.hidden = false;
    }
  };

  const pk = import.meta.env.PUBLIC_STRIPE_PK ?? '';
  const secret = new URLSearchParams(window.location.search).get('payment_intent_client_secret');

  if (!secret) {
    say('Nothing to show', 'This page is where Stripe sends you after a payment.');
  } else if (!pk || !(window as any).Stripe) {
    say('Order received', 'Your receipt is on its way by email.');
  } else {
    (window as any)
      .Stripe(pk)
      .retrievePaymentIntent(secret)
      .then(({ paymentIntent }: any) => {
        switch (paymentIntent?.status) {
          case 'succeeded':
            clearCart();
            say(
              'Thank you',
              'The payment went through and the order is in.',
              'Stripe has emailed your receipt. Anything printed is sent to the printer automatically, and download links follow by email.',
            );
            break;
          case 'processing':
            clearCart();
            say(
              'Payment processing',
              'Your bank is still working on it. Nothing more is needed from you.',
              'You will get an email once it settles.',
            );
            break;
          case 'requires_payment_method':
            say(
              'Payment not completed',
              'The card was not charged. Nothing has been sent.',
              'You can try again from the store with the same cart.',
            );
            break;
          default:
            say('Order received', 'Your receipt is on its way by email.');
        }
      })
      .catch(() => say('Order received', 'Your receipt is on its way by email.'));
  }
</script>
