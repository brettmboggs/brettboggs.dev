---
import Base from '../../layouts/Base.astro';
import copy from '../../data/copy/store-thanks.json';

// This page reports, it does not decide. Stripe sends the buyer here after a
// payment attempt, and the outcome is read back from the PaymentIntent rather
// than assumed from the fact that the redirect happened. Fulfillment itself is
// the webhook's job and has very likely already run by the time this loads.
---

<Base title={copy.title} description={copy.description} noindex={true} puck={false} noServiceWorker={true} edit="pages/store-thanks">
  <script slot="head" is:inline src="https://js.stripe.com/v3/"></script>

  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="headline">{copy.headline}</h1>
    <p class="lede" id="detail">{copy.detail}</p>
  </header>

  <p class="next" id="next" hidden></p>

  <a class="back-link" href="/store/">{copy.backLink}</a>
</Base>

<style>
  .next {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid color-mix(in oklab, var(--ink) 18%, transparent);
    max-width: var(--measure);
    color: var(--ink-soft);
  }
</style>

<script>
  import { clearCart, STRIPE_PK } from '../../scripts/store';
  import copy from '../../data/copy/store-thanks.json';

  const headline = document.getElementById('headline')!;
  const detail = document.getElementById('detail')!;
  const next = document.getElementById('next')!;

  const say = (title: string, body: string, footer?: string) => {
    headline.textContent = title;
    detail.textContent = body;
    if (footer) {
      next.textContent = footer;
      next.hidden = false;
    }
  };

  const pk = STRIPE_PK;
  const secret = new URLSearchParams(window.location.search).get('payment_intent_client_secret');

  if (!secret) {
    say(copy.noSecret.title, copy.noSecret.body);
  } else if (!pk || !(window as any).Stripe) {
    say(copy.received.title, copy.received.body);
  } else {
    (window as any)
      .Stripe(pk)
      .retrievePaymentIntent(secret)
      .then(({ paymentIntent }: any) => {
        switch (paymentIntent?.status) {
          case 'succeeded':
            clearCart();
            say(copy.succeeded.title, copy.succeeded.body, copy.succeeded.footer);
            break;
          case 'processing':
            clearCart();
            say(copy.processing.title, copy.processing.body, copy.processing.footer);
            break;
          case 'requires_payment_method':
            say(copy.failed.title, copy.failed.body, copy.failed.footer);
            break;
          default:
            say(copy.received.title, copy.received.body);
        }
      })
      .catch(() => say(copy.received.title, copy.received.body));
  }
</script>
