---
import { execSync } from 'node:child_process';
import Base from '../layouts/Base.astro';
import astroPkg from 'astro/package.json';
import copy from '../data/copy/colophon.json';
import { md } from '../data/copy';

// How the site is made, with the build stamping itself at the bottom. The
// weight table is written in after the build by tools/weigh.mjs, which
// replaces the marker below with what it measured.

let commit = '';
try {
  commit = execSync('git rev-parse --short HEAD', { encoding: 'utf8' }).trim();
} catch {
  commit = '';
}
const built = new Date();
const builtOn = built.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const repo = 'https://github.com/brettmboggs/brettboggs.dev';
---

<Base title={copy.title} description={copy.description} edit="pages/colophon">
  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  <p class="stamp">
    <span>{copy.stampBuild} {commit || 'local'}</span>
    <span>{builtOn}</span>
    <span>Astro {astroPkg.version}</span>
    <a href={repo} rel="noopener">{copy.stampSource}</a>
  </p>

  <div class="prose">
    {copy.sections.map((s) => (
      <>
        <h2>{s.heading}</h2>
        <Fragment set:html={md(s.body)} />
      </>
    ))}

    <h2>{copy.weightHeading}</h2>
    <Fragment set:html={md(copy.weightBody)} />
    <div class="weigh"><!--weigh--></div>
  </div>

  <a class="back-link" href="/">{copy.backLink}</a>
</Base>

<style>
  .stamp {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    margin-top: 2.6rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    max-width: none;
  }
  .stamp a {
    font-weight: 400;
    color: var(--rust);
  }
  code {
    font-family: var(--mono);
    font-size: 0.88em;
    color: var(--rust);
  }
  .weigh {
    margin-top: 1.6em;
  }
  .weigh :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .weigh :global(th) {
    text-align: left;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.7rem;
    color: var(--ink-soft);
    border-bottom: 2px solid var(--ink);
    padding: 0 1.4rem 0.55rem 0;
  }
  .weigh :global(td) {
    border-bottom: 1px solid var(--paper-deep);
    padding: 0.5rem 1.4rem 0.5rem 0;
    white-space: nowrap;
  }
  .weigh :global(td:not(:first-child)),
  .weigh :global(th:not(:first-child)) {
    text-align: right;
  }
  .weigh :global(th:last-child),
  .weigh :global(td:last-child) {
    padding-right: 0;
  }
  .weigh :global(td a) {
    font-weight: 400;
    color: var(--ink);
  }
  .weigh :global(.weigh-note) {
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
</style>
