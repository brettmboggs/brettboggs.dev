    const joints = drawing.querySelectorAll('.joints circle');
    const calls = drawing.querySelectorAll('.call');
    const fig = drawing.querySelector('.fig');

    gsap.set(wires, { strokeDasharray: 1, strokeDashoffset: 1 });
    gsap.set([...nodes, ...calls, ...joints, ...dims, fig], { opacity: 0 });
    gsap.set(nodes, { y: 8 });

    const start = (): void => {
      drawing.classList.add('is-running');
      drawing.querySelectorAll<SVGAnimationElement>('animateMotion').forEach((m) => {
        // each dot stays hidden until its own run starts, or it waits at the origin
        window.setTimeout(() => {
          m.beginElement();
          (m.parentNode as SVGElement).style.opacity = '1';
        }, Number(m.dataset.offset ?? 0) * 1000);
      });
    };

    const tl = gsap
      .timeline({ paused: true, delay: 0.3, defaults: { ease: 'power3.out' } })
      .to([fig, ...dims], { opacity: 1, duration: 0.6 })
      .to(nodes[0], { opacity: 1, y: 0, duration: 0.5 }, '<0.1')
      .to(wires[0], { strokeDashoffset: 0, duration: 0.55, ease: 'power2.inOut' })
      .to(nodes[1], { opacity: 1, y: 0, duration: 0.5 }, '-=0.1')
      .to(calls[0], { opacity: 1, duration: 0.4 }, '<')
      .to([wires[1], wires[2]], { strokeDashoffset: 0, duration: 0.6, ease: 'power2.inOut' })
      .to(joints[0], { opacity: 1, duration: 0.2 }, '<0.2')
      .to([nodes[2], nodes[3]], { opacity: 1, y: 0, duration: 0.5, stagger: 0.1 }, '-=0.15')
      .to([wires[3], wires[4]], { strokeDashoffset: 0, duration: 0.6, ease: 'power2.inOut' })
      .to(joints[1], { opacity: 1, duration: 0.2 }, '<0.3')
      .to(nodes[4], { opacity: 1, y: 0, duration: 0.5 }, '-=0.1')
      .to(calls[1], { opacity: 1, duration: 0.4 })
      .add(start);

    // draw once the drawing is actually in view; on a phone it sits below the copy
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        tl.play();
        seen.disconnect();
      },
      { threshold: 0.3 },
    );
    seen.observe(drawing);

    // the pulses are decoration; rest them while the drawing is off screen
    new IntersectionObserver((entries) => {
      if (!drawing.classList.contains('is-running')) return;
      if (entries.some((e) => e.isIntersecting)) svg.unpauseAnimations();
      else svg.pauseAnimations();
    }).observe(drawing);
  }

  // the proof sheet: one department at a time. it runs on its own while it is
  // on screen, and stops for good the moment the visitor picks a tab
  const deck = document.getElementById('deck');
  if (deck) {
    const tabs = Array.from(deck.querySelectorAll<HTMLButtonElement>('.deck-tab'));
    const panes = Array.from(deck.querySelectorAll<HTMLElement>('.deck-pane'));
    const strip = deck.querySelector<HTMLElement>('.deck-tabs')!;
    const MS = 4500;
    let at = 0;
    let timer = 0;
    let manual = false;
    deck.style.setProperty('--deck-ms', `${MS}ms`);

    const show = (i: number, focus = false): void => {
      at = (i + tabs.length) % tabs.length;
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === at));
        t.tabIndex = j === at ? 0 : -1;
      });
      panes.forEach((p, j) => p.classList.toggle('is-on', j === at));
      if (focus) tabs[at].focus();
      // restart the timer bar on the newly selected tab
      const bar = tabs[at].querySelector<HTMLElement>('.deck-timer');
      if (bar) {
        bar.style.animation = 'none';
        void bar.offsetWidth;
        bar.style.animation = '';
      }
      // keep the selected tab in view inside the strip, without moving the page
      const t = tabs[at];
      strip.scrollTo({ left: t.offsetLeft - (strip.clientWidth - t.offsetWidth) / 2, behavior: 'smooth' });
    };
    const stop = (): void => {
      manual = true;
      window.clearInterval(timer);
      deck.classList.remove('is-auto');
    };
    const run = (): void => {
      if (manual || reduced) return;
      window.clearInterval(timer);
      deck.classList.add('is-auto');
      timer = window.setInterval(() => show(at + 1), MS);
    };

    tabs.forEach((t, i) =>
      t.addEventListener('click', () => {
        stop();
        show(i);
      }),
    );
    strip.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      stop();
      show(at + (e.key === 'ArrowRight' ? 1 : -1), true);
    });

    new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) run();
        else {
          window.clearInterval(timer);
          deck.classList.remove('is-auto');
        }
      },
      { threshold: 0.4 },
    ).observe(deck);
  }
</script>
