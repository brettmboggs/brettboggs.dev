---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const workNote = work[0] ? `latest · ${work[0].data.title}` : 'case studies';
---

<Base title="Brett Boggs" description="Brett Boggs. Work and experiments." home>
  <section class="film full-bleed" id="film">
    <picture>
      <source id="poster-alt" media="(max-width: 500px) and (max-aspect-ratio: 3/4)" srcset="/film/poster-portrait.webp" />
      <img class="film-poster" src="/film/poster.webp" alt="" />
    </picture>
    <canvas class="film-canvas" id="film-canvas" aria-hidden="true"></canvas>
    <div class="film-fade" id="film-fade" aria-hidden="true"></div>

    <div class="hero-copy" id="hero-copy">
      <h1 class="hero-title">Walk through the&nbsp;work.</h1>
    </div>

    <div class="portal" id="portal">
      <div class="index-wrap">
        <header class="arrive index-head">
          <p class="eyebrow">Contents</p>
          <p class="index-lede">Everything here is mine, end to end. Start&nbsp;anywhere.</p>
        </header>
        <nav class="index" aria-label="Site sections">
          <a class="row arrive" href="/work/">
            <span class="row-num">01</span>
            <span class="row-title">Work</span>
            <span class="row-note">{workNote}</span>
          </a>
          <a class="row arrive" href="/lab/">
            <span class="row-num">02</span>
            <span class="row-title">Lab</span>
            <span class="row-note">experiments</span>
          </a>
          <a class="row arrive" href="mailto:brettmboggs@gmail.com">
            <span class="row-num">03</span>
            <span class="row-title">Contact</span>
            <span class="row-note">brettmboggs@gmail.com</span>
          </a>
        </nav>
        <p class="arrive index-status">Now · building Datum</p>
      </div>
    </div>

    <span class="scroll-line" aria-hidden="true"></span>
  </section>
</Base>

<style>
  .full-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }
  .film {
    position: relative;
    /* large viewport, not small: ScrollTrigger freezes the pin at whatever height
       it measures, so sizing to svh leaves a paper gap the height of the toolbar
       once iOS collapses it mid-scroll. lvh covers both states; the surplus sits
       below the fold while the toolbar is up. */
    height: 100lvh;
    overflow: hidden;
    background: var(--paper);
  }
  .film-poster,
  .film-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film-fade {
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: 0;
    pointer-events: none;
  }
  .hero-copy {
    position: absolute;
    top: 16svh;
    left: 0;
    right: 0;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    padding: 0 1.5rem;
    text-align: center;
    pointer-events: none;
  }
  .hero-title {
    font-variation-settings: 'opsz' 144, 'SOFT' 60, 'WONK' 1;
    font-size: clamp(2.3rem, 5.8vw, 4.4rem);
    color: var(--ink);
  }
  .portal {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
  }
  .index-wrap {
    width: 100%;
    max-width: 62rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .index-head {
    margin-bottom: 2.2rem;
  }
  .index-lede {
    margin-top: 0.7rem;
    font-family: var(--display);
    font-variation-settings: 'opsz' 40, 'SOFT' 60, 'WONK' 0;
    font-weight: 500;
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    color: var(--ink);
  }
  .index-status {
    margin-top: 1.6rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .scroll-line {
    position: absolute;
    /* sits on the fold rather than under the toolbar. 0 wherever lvh == svh. */
    bottom: calc(100lvh - 100svh);
    left: 50%;
    width: 2px;
    height: 4rem;
    background: var(--ink);
    transform-origin: top center;
  }

  .row {
    display: grid;
    grid-template-columns: 3.2rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.55rem 0;
    border-top: 2px solid var(--ink);
    color: var(--ink);
    background-image: none;
  }
  .row-num {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }
  .row-title {
    font-family: var(--display);
    font-variation-settings: 'opsz' 90, 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
    font-size: clamp(2rem, 5.2vw, 3.4rem);
    line-height: 1.05;
    transition: translate 0.45s var(--ease-warm);
  }
  .row-note {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 0.45s var(--ease-warm);
    text-align: right;
  }
  .row:hover .row-title,
  .row:focus-visible .row-title {
    translate: 0.85rem 0;
  }
  .row:hover .row-note,
  .row:focus-visible .row-note {
    color: var(--sienna);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 2.2rem 1fr;
      gap: 0.2rem 0.8rem;
      padding: 1.3rem 0;
    }
    .row-note {
      grid-column: 2;
      text-align: left;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row-title,
    .row-note {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;
  const film = document.getElementById('film')!;
  const poster = film.querySelector<HTMLImageElement>('.film-poster')!;
  const posterAlt = document.getElementById('poster-alt') as HTMLSourceElement;

  // the <source> wins over img.src, so the end frame has to replace both
  function showEndPoster(): void {
    posterAlt.srcset = '/film/poster-end-portrait.webp';
    poster.src = '/film/poster-end.webp';
  }
  const fade = document.getElementById('film-fade')!;
  const portal = document.getElementById('portal')!;
  const rows = Array.from(portal.querySelectorAll<HTMLElement>('.arrive'));

  // the reveal window: camera passes through the structure ~84-97% of the scrub
  const REVEAL_START = 0.84;
  const REVEAL_SPAN = 0.05;
  const ROW_STAGGER = 0.018;

  const scrollLine = film.querySelector<HTMLElement>('.scroll-line')!;
  const heroCopy = document.getElementById('hero-copy')!;

  function applyProgress(p: number): void {
    scrollLine.style.opacity = String(Math.max(0, 1 - p / 0.2));
    const hero = Math.max(0, 1 - p / 0.14);
    heroCopy.style.opacity = String(hero);
    heroCopy.style.translate = `0 ${(1 - hero) * -22}px`;
    fade.style.opacity = String(Math.min(1, Math.max(0, (p - 0.86) / 0.1)));
    rows.forEach((row, i) => {
      const t = Math.min(1, Math.max(0, (p - (REVEAL_START + i * ROW_STAGGER)) / REVEAL_SPAN));
      const e = t * t * (3 - 2 * t);
      row.style.opacity = String(e);
      row.style.translate = `0 ${(1 - e) * 34}px`;
    });
  }

  if (reduced || saveData) {
    showEndPoster();
    fade.style.opacity = '0.55';
    // static end-frame with the nav already visible — the scroll prompt makes no sense here
    heroCopy.style.display = 'none';
  } else {
    applyProgress(0);
    fetch('/film/manifest.json')
      .then((r) => r.json())
      .then(({ count }) => import('../scripts/filmScrub').then((m) =>
        m.initFilm({
          canvas: document.getElementById('film-canvas') as HTMLCanvasElement,
          pinTarget: film,
          frameCount: count,
          onProgress: applyProgress,
        }),
      ))
      .catch(() => {
        showEndPoster();
        fade.style.opacity = '0.55';
        applyProgress(1);
      });

    gsap.set('.scroll-line', { scaleY: 0 });
    gsap.to('.scroll-line', { scaleY: 1, duration: 0.9, ease: 'power2.inOut', delay: 1.0 });
    gsap.from('.hero-title', {
      opacity: 0,
      y: 16,
      duration: 0.9,
      ease: 'power2.out',
      delay: 0.4,
    });
  }
</script>
