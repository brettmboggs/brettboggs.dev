    }
  }
  .start h2 {
    font-weight: 880;
    font-stretch: 118%;
    font-size: clamp(2.8rem, 6.4vw, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .start-body {
    margin-top: 1.2rem;
    font-size: 1.2rem;
    color: var(--ink-2);
  }
  .note {
    display: grid;
    gap: 1rem;
  }
  .pair {
    display: grid;
    gap: 1rem;
