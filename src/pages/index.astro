---
import Base from '../layouts/Base.astro';
---

<Base title="Brett Boggs" description="Brett Boggs. Work, experiments, writing.">
  <nav class="index" aria-label="Site sections">
    <a class="row" href="/work/">
      <span class="row-title">Work</span>
      <span class="row-note">case studies</span>
    </a>
    <a class="row" href="/lab/">
      <span class="row-title">Lab</span>
      <span class="row-note">experiments</span>
    </a>
    <a class="row" href="/writing/">
      <span class="row-title">Writing</span>
      <span class="row-note">notes</span>
    </a>
    <a class="row" href="mailto:brettmboggs@gmail.com">
      <span class="row-title">Contact</span>
      <span class="row-note">brettmboggs@gmail.com</span>
    </a>
  </nav>
</Base>

<style>
  .index {
    display: block;
    padding-top: 22vh;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 2.1rem 0;
    border-top: 2px solid var(--ink);
    color: var(--ink);
    background-image: none;
  }
  .row-title {
    font-family: var(--display);
    font-variation-settings: 'opsz' 90, 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
    font-size: clamp(2.3rem, 6vw, 3.9rem);
    line-height: 1.05;
    transition: translate 0.45s var(--ease-warm);
  }
  .row-note {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 0.45s var(--ease-warm);
    text-align: right;
  }
  .row:hover .row-title,
  .row:focus-visible .row-title {
    translate: 0.85rem 0;
  }
  .row:hover .row-note,
  .row:focus-visible .row-note {
    color: var(--sienna);
  }

  @media (max-width: 640px) {
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
      padding: 1.6rem 0;
    }
    .row-note {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-title,
    .row-note {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    gsap.utils.toArray<HTMLElement>('.row').forEach((row, i) => {
      gsap.from(row, { y: 36, opacity: 0, duration: 0.8, ease: 'power3.out', delay: 0.15 + i * 0.09 });
    });
  }
</script>
