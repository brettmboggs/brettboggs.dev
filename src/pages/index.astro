---
import Base from '../layouts/Base.astro';
import copy from '../data/copy/home.json';
import { md } from '../data/copy';

const { hero, overhead, own, proof, about, process, pricing, contact } = copy;
const st = hero.statement;

// the headline strikes one word through in signal orange
const [before, after] = hero.title.split(hero.strike);
const cents = (n: number): string => n.toFixed(2);
const softTotal = st.rows.filter((r) => r.software).reduce((s, r) => s + r.amount, 0);
const usd = (n: number): string =>
  '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(contact.subject)}`;
const contactApi = import.meta.env.PUBLIC_CONTACT_API ?? 'https://brettboggs-contact.brettmboggs.workers.dev';
const f = contact.form;
---

<Base title={copy.title} description={copy.description} home theme="counter" full edit="pages/home">

  <!-- ===================================================== hero -->
  <section class="hero">
    <div class="c-wrap hero-in">
      <div>
        <h1 class="hero-title">
          {before}<span class="cut">{hero.strike}</span>{after}
        </h1>
        <p class="lede">{hero.lede}</p>
        <div class="acts">
          <a class="btn sig" href="#start">{hero.cta} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn ghost" href={hero.secondaryUrl}>{hero.secondary}</a>
        </div>
      </div>

      <!-- the finished statement is the markup; the script rewinds it and plays it once -->
      <div class="stmt-box">
        <div class="stmt" id="stmt">
          <div class="stmt-top"><b>{st.card}</b><span>{st.period}</span></div>
          <div class="rows">
            {
              st.rows.map((r) => (
                <div class:list={['r', { sw: r.software, gone: r.software }]} data-amount={r.amount}>
                  <span class="d">{r.date}</span>
                  <span class="m">{r.item}</span>
                  <span class="v">{cents(r.amount)}</span>
                </div>
              ))
            }
            <div class="one" id="one">
              <span class="d">{st.oneDate}</span>
              <span class="m">{st.oneItem}</span>
              <span class="v">{cents(st.oneAmount)}</span>
            </div>
          </div>
          <div class="stmt-foot">
            <div class="t"><span>{st.softLabel}</span><b id="soft">{usd(st.oneAmount)}</b></div>
            <div class="t kept"><span>{st.keptLabel}</span><b id="kept">{usd(softTotal - st.oneAmount)}</b></div>
          </div>
          <div class="cancel" id="cancel" aria-hidden="true">{st.stamp}</div>
        </div>
        <div class="stmt-under">
          <p>{st.caption}</p>
          <button class="replay" id="replay" type="button">{st.replay}</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== overhead -->
  <section class="calc" id="overhead">
    <div class="c-wrap">
      <h2 class="h2">{overhead.heading}</h2>
      <p class="sub">{overhead.sub}</p>
      <div class="calc-grid">
        <div>
          <div class="tools" id="tools">
            {
              overhead.tools.map((t, i) => (
                <label class="tool" for={`tool-${i}`}>
                  <input type="checkbox" id={`tool-${i}`} checked={t.on} data-name={t.name} />
                  <span class="tool-name">
                    {t.name}
                    <small>like {t.eg}</small>
                  </span>
                  <span class="price">
                    $<input id={`price-${i}`} inputmode="decimal" value={t.price} aria-label={`${t.name} per month`} />
                    <span>/mo</span>
                  </span>
                </label>
              ))
            }
          </div>
          <div class="hours">
            <label for="hrs">
              <span class="lab">{overhead.hoursLabel} <output id="hrsOut">6</output></span>
              <input id="hrs" type="range" min="0" max="40" value="6" />
              <small>{overhead.hoursHelp}</small>
            </label>
            <label for="wage">
              <span class="lab">{overhead.wageLabel} <output id="wageOut">$25</output></span>
              <input id="wage" type="range" min="15" max="80" step="1" value="25" />
              <small>{overhead.wageHelp}</small>
            </label>
          </div>
        </div>
        <div class="tape-col" id="tapeCol">
          <div class="printer" aria-hidden="true"></div>
          <div class="tape" aria-live="polite">
            <p class="tape-head">{overhead.tapeHead}</p>
            <div class="lines" id="lines"></div>
            <div class="sum">
              <div class="sline"><span>{overhead.softwareLine}</span><span id="softY">$0</span></div>
              <div class="sline"><span>{overhead.hoursLine}</span><span id="hoursY">$0</span></div>
              <div class="big"><span>{overhead.totalLine}</span><b id="totalY">$0</b></div>
            </div>
          </div>
          <div class="cut-row">
            <button class="btn sig" id="cut" type="button">{overhead.cut}</button>
            <p>{overhead.cutNote}</p>
          </div>
          <div class="after">
            <h3>{overhead.afterHeading}</h3>
            <p>{overhead.afterBody}</p>
            <p id="payback" data-text={overhead.afterPayback}>{overhead.afterPayback.replace('{total}', 'your total')}</p>
            <a class="btn sig" href="#start">{hero.cta} <span class="arr" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== ownership -->
  <section class="own" id="own">
    <div class="c-wrap own-in">
      <div class="deed" id="deed">
        <p class="deed-title">{own.certTitle}</p>
        <p class="deed-of">{own.certOf}</p>
        <ul>
          {own.items.map((it) => <li><span>{it.thing}</span><em>{it.how}</em></li>)}
        </ul>
        <div class="seal" aria-hidden="true">{own.seal}</div>
      </div>
      <div>
        <h2 class="h2">{own.heading}</h2>
        <div class="points">
          {own.points.map((pt) => <p><b>{pt.title}</b>{pt.body}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== work -->
  <section class="work" id="work">
    <div class="c-wrap">
      <h2 class="h2">{proof.heading}</h2>
      <div class="cases">
        {
          proof.items.map((it) => (
            <article class="case">
              <a class="shot" href={it.url}>
                <img src={it.image} alt={it.imageAlt} loading="lazy" width="1440" height="960" />
              </a>
              <h3>{it.name}</h3>
              <p>{it.body}</p>
              <div class="stub">
                {it.replaced.map((r) => <span><s>{r}</s></span>)}
                {it.stats.map((s) => <span>{s.value} {s.label}</span>)}
              </div>
              <a class="more" href={it.url}>{it.link}</a>
            </article>
          ))
        }
      </div>
      <a class="all" href="/work/">{proof.more} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- ===================================================== about -->
  <section class="about">
    <div class="c-wrap about-in">
      <img class="portrait" src={about.portrait} alt={about.portraitAlt} width="480" height="600" loading="lazy" />
      <div>
        <h2 class="h2">{about.heading}</h2>
        <div class="about-body" set:html={md(about.body)} />
        <a class="more" href={about.url}>{about.link} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ===================================================== how it goes -->
  <section class="how">
    <div class="c-wrap">
      <h2 class="h2">{process.heading}</h2>
      <ol class="steps">
        {
          process.steps.map((s) => (
            <li class="step">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <span class="t">{s.tag}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================================================== pricing -->
  <section class="pricing" id="pricing">
    <div class="c-wrap">
      <h2 class="h2">{pricing.heading}</h2>
      <div class="prices">
        {
          pricing.rows.map((r) => (
            <div class="pr">
              <h3>{r.name}</h3>
              <p class="amt">{r.price}</p>
              <p>{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================================================== contact -->
  <section class="start" id="start">
    <div class="c-wrap start-in">
      <div>
        <h2>{contact.heading}</h2>
        <p class="start-body">{contact.body}</p>
      </div>
      <div>
        <form class="note" id="note" action={contactApi} method="post">
          <div class="pair">
            <label>
              <span>{f.name}</span>
              <input name="name" autocomplete="name" maxlength="200" required />
            </label>
            <label>
              <span>{f.email}</span>
              <input name="email" type="email" autocomplete="email" maxlength="320" required />
            </label>
          </div>
          <label>
            <span>{f.message}</span>
            <textarea name="message" rows="4" maxlength="5000" required></textarea>
          </label>
          <label class="note-trap" aria-hidden="true">
            Company <input name="company" tabindex="-1" autocomplete="off" />
          </label>
          <div class="note-go">
            <button class="btn sig" type="submit" data-sending={f.sending}>
              <b>{f.send}</b> <span class="arr" aria-hidden="true">→</span>
            </button>
            <p class="note-status" role="status" aria-live="polite"></p>
          </div>
          <p class="note-error" hidden>{f.error} <a href={mailto}>{contact.email}</a></p>
        </form>
        <p class="note-sent" id="sent" tabindex="-1">{f.sent}</p>
        <p class="start-alt">{f.alt} <a href={mailto}>{contact.email}</a></p>
        <p class="start-area">{contact.area}</p>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ================================================================
     The counter: a cool counter-top grey with real paper on it. One
     month's card statement in the hero, a register tape for the
     overhead, a certificate for what the business ends up owning.
     ================================================================ */
  :global(html.counter main) {
    min-height: 0;
  }
  :global(html.counter .foot) {
    margin-top: 0;
  }
  .c-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding-left: max(20px, env(safe-area-inset-left, 0px));
    padding-right: max(20px, env(safe-area-inset-right, 0px));
  }
  p {
    max-width: none;
  }
  section a {
    background-image: none;
  }

  /* --- buttons --- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.9rem 1.3rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--sheet);
    font: 600 0.98rem/1 var(--sans);
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .btn:hover {
    transform: translateY(-2px);
    color: var(--sheet);
  }
  .btn:active {
    transform: translateY(1px) scale(0.98);
  }
  .btn.sig,
  .btn.sig:hover {
    background: var(--sig);
    color: var(--ink);
  }
  .btn.ghost,
  .btn.ghost:hover {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .btn .arr {
    transition: transform 0.35s var(--ease);
  }
  .btn:hover .arr {
    transform: translateX(3px);
  }
  .btn b {
    font-weight: inherit;
  }
  .btn:focus-visible {
    outline: 2.5px solid var(--sig);
    outline-offset: 3px;
  }

  /* --- shared section type --- */
  section {
    padding-block: clamp(72px, 10vw, 128px);
  }
  .h2 {
    font-weight: 860;
    font-stretch: 112%;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .sub {
    margin-top: 1rem;
    font-size: 1.15rem;
    color: var(--ink-2);
    max-width: 52ch;
  }

  /* --- hero --- */
  .hero {
    padding-block: clamp(32px, 6vw, 72px) clamp(48px, 7vw, 88px);
  }
  .hero-in {
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-in {
      grid-template-columns: 1.05fr 1fr;
    }
  }
  .hero-title {
    font-weight: 880;
    font-stretch: 118%;
    font-size: clamp(2.9rem, 6.2vw, 5.6rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .cut {
    position: relative;
    white-space: nowrap;
  }
  .cut::after {
    content: '';
    position: absolute;
    left: -2%;
    right: -2%;
    top: 52%;
    height: 0.1em;
    background: var(--sig);
    transform-origin: left;
    animation: strike 0.7s 0.5s var(--ease) both;
  }
  @keyframes strike {
    from {
      transform: scaleX(0);
    }
  }
  .lede {
    margin-top: 1.6rem;
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 34ch;
  }
  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  /* the statement */
  .stmt-box {
    position: relative;
    min-width: 0;
  }
  .stmt {
    position: relative;
    background: var(--sheet);
    color: var(--ink);
    padding: clamp(18px, 2.6vw, 30px);
    border-radius: 4px;
    font: 400 0.8rem/1.5 var(--mono);
    box-shadow:
      0 1px 0 rgb(21 23 28 / 0.05),
      0 40px 70px -30px rgb(40 48 64 / 0.35);
    transform: rotate(1.4deg);
  }
  @media (max-width: 560px) {
    .stmt {
      font-size: 0.68rem;
      transform: none;
    }
  }
  .stmt-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 12px;
    border-bottom: 1.5px solid var(--ink);
  }
  .stmt-top b {
    font: 850 1rem/1.1 var(--display);
    font-stretch: 120%;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .stmt-top span {
    color: var(--soft);
    text-align: right;
  }
  .rows {
    margin-top: 6px;
  }
  .r,
  .one {
    display: grid;
    grid-template-columns: 3.4em 1fr auto;
    gap: 0.9rem;
  }
  .r {
    position: relative;
    padding: 6px 0;
    border-bottom: 1px dotted var(--hair);
  }
  .r .d {
    color: var(--soft);
  }
  .v {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .r.sw .d,
  .r.sw .m,
  .r.sw .v {
    position: relative;
    z-index: 1;
  }
  /* an orange highlighter, a little uneven, like a real one */
  .r.sw::before {
    content: '';
    position: absolute;
    left: -4px;
    right: -4px;
    top: 4px;
    bottom: 4px;
    background: color-mix(in srgb, var(--sig) 38%, var(--sheet));
    border-radius: 3px 8px 4px 9px / 7px 3px 9px 4px;
    transform-origin: left center;
    transform: scaleX(var(--hl, 1)) skewX(-6deg);
  }
  .r:global(.gone) {
    opacity: 0.4;
  }
  .r:global(.gone) .m,
  .r:global(.gone) .v {
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }
  .one {
    margin: 8px -6px 0;
    padding: 8px 6px;
    background: var(--ink);
    color: var(--sheet);
    border-radius: 4px;
  }
  .one .v {
    color: var(--sig);
  }
  .stmt-foot {
    display: grid;
    gap: 4px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1.5px solid var(--ink);
  }
  .stmt-foot .t {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .stmt-foot b {
    font: 700 1.3rem/1 var(--mono);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .stmt-foot .kept {
    color: var(--sig-text);
  }
  .cancel {
    position: absolute;
    right: 9%;
    top: 36%;
    pointer-events: none;
    padding: 0.35rem 0.75rem;
    border: 3px solid var(--sig);
    border-radius: 6px;
    color: var(--sig-text);
    font: 900 1.5rem/1 var(--display);
    font-stretch: 125%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transform: rotate(-11deg);
    opacity: 0;
    mix-blend-mode: multiply;
  }
  .stmt-under {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  .stmt-under p {
    font: 400 0.7rem/1.4 var(--mono);
    color: var(--soft);
  }
  .replay {
    flex: none;
    padding: 0.3rem 0;
    border: 0;
    background: none;
    font: 500 0.72rem var(--mono);
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    visibility: hidden;
  }
  .replay:global(.on) {
    visibility: visible;
  }

  /* --- overhead: pick the tools, the tape prints --- */
  .calc {
    background: var(--sheet);
    border-radius: 28px 28px 0 0;
  }
  .calc-grid {
    display: grid;
    gap: 3rem;
    margin-top: 3rem;
    align-items: start;
  }
  @media (min-width: 980px) {
    .calc-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
  .tools {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
  .tool {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 0.9rem;
    border-radius: 14px;
    background: var(--bg);
    cursor: pointer;
    transition:
      background-color 0.25s,
      box-shadow 0.25s,
      transform 0.3s var(--ease);
  }
  .tool:hover {
    transform: translateY(-1px);
  }
  .tool input[type='checkbox'] {
    appearance: none;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin: 0;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1.5px var(--ink-2);
    cursor: pointer;
  }
  .tool input[type='checkbox']:checked {
    background: var(--ink);
    box-shadow: none;
  }
  .tool input[type='checkbox']:checked::after {
    content: '';
    width: 9px;
    height: 5px;
    border: 2px solid var(--sheet);
    border-top: 0;
    border-right: 0;
    transform: translateY(-1px) rotate(-45deg);
  }
  .tool input[type='checkbox']:focus-visible {
    outline: 2.5px solid var(--sig);
    outline-offset: 2px;
  }
  .tool:has(input:checked) {
    background: #fff;
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .tool-name {
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.2;
  }
  .tool-name small {
    display: block;
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--soft);
  }
  .price {
    display: flex;
    align-items: center;
    gap: 2px;
    font: 500 0.85rem var(--mono);
    color: var(--ink-2);
  }
  .price input {
    width: 4.2em;
    padding: 0.3rem 0.35rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    font: inherit;
    color: var(--ink);
    text-align: right;
    box-shadow: inset 0 -1.5px 0 var(--hair);
  }
  .price input:focus {
    outline: none;
    box-shadow: inset 0 -2px 0 var(--sig);
  }
  .hours {
    display: grid;
    gap: 1.2rem;
    margin-top: 2rem;
  }
  @media (min-width: 640px) {
    .hours {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hours label {
    display: grid;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.98rem;
  }
  .hours output {
    font: 700 1.05rem var(--mono);
  }
  .lab {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .hours small {
    font-weight: 400;
    font-size: 0.82rem;
    color: var(--soft);
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--ink);
  }

  /* the register tape */
  .tape-col {
    position: relative;
    min-width: 0;
  }
  @media (min-width: 980px) {
    .tape-col {
      position: sticky;
      top: 92px;
    }
  }
  .printer {
    position: relative;
    z-index: 2;
    height: 18px;
    border-radius: 10px 10px 4px 4px;
    background: var(--ink);
  }
  .tape {
    margin: -6px 14px 0;
    padding: 22px 20px 30px;
    background: #fff;
    font: 400 0.78rem/1.6 var(--mono);
    color: var(--ink);
    filter: drop-shadow(0 14px 22px rgb(40 48 64 / 0.14));
    -webkit-mask:
      linear-gradient(#000 0 0) top / 100% calc(100% - 9px) no-repeat,
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / 12px 9px repeat-x;
    mask:
      linear-gradient(#000 0 0) top / 100% calc(100% - 9px) no-repeat,
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / 12px 9px repeat-x;
    transition:
      transform 0.9s var(--ease),
      opacity 0.6s;
  }
  .tape-head {
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--hair);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: var(--soft);
  }
  .lines {
    min-height: 3rem;
    padding: 10px 0;
  }
  .lines :global(.line),
  .sline {
