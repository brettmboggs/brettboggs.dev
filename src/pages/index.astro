---
import Base from '../layouts/Base.astro';
import copy from '../data/copy/home.json';
import { md } from '../data/copy';

const { hero, problems, systems, process, about, proof, pricing, contact } = copy;
const dg = hero.diagram;
const pad = (n: number): string => String(n).padStart(2, '0');

// the headline sets its last word in signal orange
const accent = hero.titleAccent;
const lead = hero.title.endsWith(accent) ? hero.title.slice(0, -accent.length).trim() : hero.title;

const total = pad(6);
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(contact.subject)}`;
const contactApi = import.meta.env.PUBLIC_CONTACT_API ?? 'https://brettboggs-contact.brettmboggs.workers.dev';
const f = contact.form;

// the as-built drawing: every connector, in the order it draws
const wires = [
  'M230 118 V 170 H 300 V 230',
  'M300 308 V 370 H 180 V 420',
  'M300 370 H 420 V 420',
  'M180 498 V 550 H 300 V 600',
  'M420 498 V 550 H 300',
];
// the routes the signal runs, start to finish
const runs = [
  'M230 118 V 170 H 300 V 370 H 180 V 550 H 300 V 640',
  'M230 118 V 170 H 300 V 370 H 420 V 550 H 300 V 640',
];
const nodes = [
  { x: 110, y: 40, w: 240, ...dg.in, tag: 'IN', hot: true },
  { x: 170, y: 230, w: 260, ...dg.core, tag: 'CORE', hot: false },
  { x: 80, y: 420, w: 200, ...dg.left, tag: '', hot: false },
  { x: 320, y: 420, w: 200, ...dg.right, tag: '', hot: false },
  { x: 170, y: 600, w: 260, ...dg.out, tag: 'OUT', hot: true },
];
---

<Base title={copy.title} description={copy.description} home theme="drawing" full edit="pages/home">

  <!-- ===================================================== hero -->
  <section class="hero spot">
    <div class="d-wrap hero-in">
      <div class="hero-copy">
        <p class="tag rise"><i aria-hidden="true"></i>{hero.eyebrow}</p>
        <h1 class="hero-title rise" style="--d: 0.06s">
          {lead} <span>{accent}</span>
        </h1>
        <p class="dim rise" style="--d: 0.14s"><span>{hero.rule}</span></p>
        <p class="hero-lede rise" style="--d: 0.2s">{hero.lede}</p>
        <div class="hero-acts rise" style="--d: 0.26s">
          <a class="btn btn-sig" href="#start">{hero.cta} <span aria-hidden="true">→</span></a>
          <a class="btn btn-line" href={hero.secondaryUrl}>{hero.secondary}</a>
        </div>
        <dl class="tblock rise" style="--d: 0.32s">
          {
            hero.titleBlock.map((c) => (
              <div>
                <dt>{c.label}</dt>
                <dd>{c.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <figure class="drawing" id="drawing">
        <svg viewBox="0 0 560 750" role="img" aria-labelledby="fig-title">
          <title id="fig-title">{hero.figure}: {dg.in.name}, {dg.core.name}, {dg.left.name}, {dg.right.name}, {dg.out.name}.</title>
          <text class="fig" x="556" y="14" text-anchor="end">{hero.figure}</text>

          <!-- dimension line down the left edge -->
          <g class="dimline">
            <path d="M30 40 V 684 M22 40 H 38 M22 684 H 38" />
            <text x="18" y="362" transform="rotate(-90 18 362)" text-anchor="middle">{dg.dimension}</text>
          </g>

          <g class="wires">{wires.map((d) => <path d={d} pathLength="1" />)}</g>
          <g class="joints">
            <circle cx="300" cy="370" r="4" />
            <circle cx="300" cy="550" r="4" />
          </g>

          <!-- the signal runs under the boxes, so it vanishes inside each step -->
          <g class="pulses" aria-hidden="true">
            {
              runs.map((d, i) => (
                <circle r="4.5">
                  <animateMotion dur="4.8s" begin="indefinite" repeatCount="indefinite" path={d} data-offset={i * 2.4} />
                </circle>
              ))
            }
          </g>

          <g class="nodes">
            {
              nodes.map((n) => (
                <g class:list={['node', { hot: n.hot }]}>
                  <rect x={n.x} y={n.y} width={n.w} height="78" />
                  {n.tag && (
                    <g class="ntag">
                      <rect x={n.x + n.w - 40} y={n.y} width="40" height="16" />
                      <text x={n.x + n.w - 20} y={n.y + 11.5} text-anchor="middle">{n.tag}</text>
                    </g>
                  )}
                  <text class="nname" x={n.x + 16} y={n.y + 34}>{n.name}</text>
                  <text class="nnote" x={n.x + 16} y={n.y + 58}>{n.note}</text>
                </g>
              ))
            }
          </g>

          <g class="calls">
            <g class="call">
              <path d="M300 186 H 312" />
              <rect x="312" y="174" width="244" height="24" />
              <text x="322" y="190">① {dg.callA}</text>
            </g>
            <g class="call">
              <path d="M300 678 V 704" />
              <rect x="158" y="704" width="284" height="24" />
              <text x="168" y="720">② {dg.callB}</text>
            </g>
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <!-- ===================================================== 01 problems -->
  <section class="sec" id="problems">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{problems.eyebrow} / {total}</p>
        <h2>{problems.heading}</h2>
      </header>
      <div class="spec" role="table">
        <div class="spec-row spec-cols" role="row">
          <span role="columnheader">No.</span>
          <span role="columnheader">{problems.columns[0]}</span>
          <span role="columnheader">{problems.columns[1]}</span>
        </div>
        {
          problems.items.map((p, i) => (
            <div class="spec-row" role="row">
              <span class="spec-no" role="cell">{pad(i + 1)}</span>
              <p class="spec-problem" role="cell">{p.problem}</p>
              <p class="spec-fix" role="cell">{p.fix}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================================================== 02 systems -->
  <section class="sec" id="systems">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{systems.eyebrow} / {total}</p>
        <h2>{systems.heading}</h2>
      </header>
      <div class="sys-intro">
        <p class="sys-lede">{systems.lede}</p>
      </div>

      <div class="caps">
        <p class="caps-head">{systems.capsHeading}</p>
        <ol class="caps-list">
          {
            systems.caps.map((c, i) => (
              <li>
                <span class="cap-no">{pad(i + 1)}</span>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <p class="proof-label"><span>{systems.proofLabel}</span></p>
      <div class="dsheet project">
        <span class="crop tl" aria-hidden="true"></span><span class="crop tr" aria-hidden="true"></span>
        <span class="crop bl" aria-hidden="true"></span><span class="crop br" aria-hidden="true"></span>
        <dl class="pblock">
          {
            systems.block.map((c) => (
              <div>
                <dt>{c.label}</dt>
                <dd>{c.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="map">
          <p class="map-label">{systems.map.label}</p>
          <div class="map-grid">
            <ul class="map-col map-left">
              {systems.map.left.map((n) => (
                <li class="map-node">
                  <span class="mn-name">{n.name}</span>
                  <span class="mn-note">{n.note}</span>
                </li>
              ))}
            </ul>
            <div class="map-core">
              <span class="core-tag">Core</span>
              <span class="core-name">{systems.map.core.name}</span>
              <span class="core-note">{systems.map.core.note}</span>
            </div>
            <ul class="map-col map-right">
              {systems.map.right.map((n) => (
                <li class="map-node">
                  <span class="mn-name">{n.name}</span>
                  <span class="mn-note">{n.note}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="map-out">
            <p class="map-out-label">{systems.map.outLabel}</p>
            <ul>{systems.map.out.map((o) => <li>{o}</li>)}</ul>
          </div>
        </div>

        <div class="pspec" role="table">
          <div class="pspec-row pspec-cols" role="row">
            {systems.specCols.map((c) => <span role="columnheader">{c}</span>)}
          </div>
          {
            systems.specs.map((r) => (
              <div class="pspec-row" role="row">
                <p class="pspec-cap" role="cell">{r.cap}</p>
                <p class="pspec-detail" role="cell">{r.detail}</p>
              </div>
            ))
          }
        </div>

        <dl class="sheet-foot">
          {
            systems.figures.map((f) => (
              <div class="fig-cell">
                <dt>{f.number}</dt>
                <dd>{f.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <p class="walk"><i aria-hidden="true"></i>{systems.walk}</p>
    </div>
  </section>

  <!-- ===================================================== 03 process -->
  <section class="sec" id="process">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{process.eyebrow} / {total}</p>
        <h2>{process.heading}</h2>
      </header>
      <ol class="steps">
        {
          process.steps.map((s, i) => (
            <li class="step">
              <span class="step-no">{pad(i + 1)}</span>
              <h3>{s.title}</h3>
              <span class="step-tag">{s.tag}</span>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================================================== 04 who -->
  <section class="sec" id="who">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{about.eyebrow} / {total}</p>
        <h2>{about.heading}</h2>
      </header>
      <div class="who">
        <figure class="who-photo">
          <span class="crop tl" aria-hidden="true"></span><span class="crop br" aria-hidden="true"></span>
          <img src={about.portrait} alt={about.portraitAlt} width="480" height="600" loading="lazy" decoding="async" />
        </figure>
        <div>
          <div class="who-body" set:html={md(about.body)} />
          <ol class="revs">
            {
              about.timeline.map((t, i) => (
                <li>
                  <span class="rev-no">{String.fromCharCode(65 + i)}</span>
                  <span class="rev-role">{t.role}</span>
                  <span class="rev-place">{t.place}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== 05 work -->
  <section class="sec" id="work">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{proof.eyebrow} / {total}</p>
        <h2>{proof.heading}</h2>
      </header>
      <div class="cases">
        {
          proof.items.map((c, i) => (
            <article class="case">
              <a class="case-shot" href={c.url} tabindex="-1" aria-hidden="true">
                <span class="case-label">Detail {String.fromCharCode(65 + i)} · {c.name}</span>
                <img src={c.image} alt="" width="1440" height="960" loading="lazy" decoding="async" />
              </a>
              <div class="case-text">
                <p class="case-meta">{c.meta}</p>
                <h3>{c.name}</h3>
                <p class="case-body">{c.body}</p>
                <dl class="case-stats">
                  {c.stats.map((s) => (
                    <div>
                      <dt>{s.value}</dt>
                      <dd>{s.label}</dd>
                    </div>
                  ))}
                </dl>
                <a class="arrow-link" href={c.url}>{c.link} →</a>
              </div>
            </article>
          ))
        }
      </div>
      <a class="arrow-link more" href="/work/">{proof.more} →</a>
    </div>
  </section>

  <!-- ===================================================== 06 pricing -->
  <section class="sec" id="pricing">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{pricing.eyebrow} / {total}</p>
        <h2>{pricing.heading}</h2>
      </header>
      <div class="spec prices" role="table">
        <div class="spec-row spec-cols" role="row">
          {pricing.columns.map((c) => <span role="columnheader">{c}</span>)}
        </div>
        {
          pricing.rows.map((r) => (
            <div class:list={['spec-row', { top: r.name.startsWith('Company') }]} role="row">
              <p class="price-name" role="cell">{r.name}</p>
              <p class="price-amt" role="cell">{r.price}</p>
              <p class="price-body" role="cell">{r.body}</p>
            </div>
          ))
        }
      </div>
      {pricing.note && <p class="founding"><i aria-hidden="true"></i>{pricing.note}</p>}
    </div>
  </section>

  <!-- ===================================================== close -->
  <section class="start" id="start">
    <div class="d-wrap start-in">
      <h2>{contact.heading}</h2>
      <div class="start-side">
        <p class="start-body">{contact.body}</p>
        <form class="note" id="note" action={contactApi} method="post">
          <div class="note-pair">
            <label>
              <span>{f.name}</span>
              <input name="name" autocomplete="name" maxlength="200" required />
            </label>
            <label>
              <span>{f.email}</span>
              <input name="email" type="email" autocomplete="email" maxlength="320" required />
            </label>
          </div>
          <label>
            <span>{f.message}</span>
            <textarea name="message" rows="4" maxlength="5000" required></textarea>
          </label>
          <label class="note-trap" aria-hidden="true">
            Company <input name="company" tabindex="-1" autocomplete="off" />
          </label>
          <div class="note-go">
            <button class="btn btn-sig big" type="submit" data-sending={f.sending}>
              <b>{f.send}</b> <span aria-hidden="true">→</span>
            </button>
            <p class="note-status" role="status" aria-live="polite"></p>
          </div>
          <p class="note-error" hidden>{f.error} <a href={mailto}>{contact.email}</a></p>
        </form>
        <p class="note-sent" id="sent" tabindex="-1">{f.sent}</p>
        <p class="start-alt">{f.alt} <a href={mailto}>{contact.email}</a></p>
        <p class="start-area">{contact.area}</p>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ================================================================
     The drawing set: the homepage's own visual system. White sheet,
     engineering grid, black ink, one signal orange, blueprint blue for
     annotation. Everything else on the site keeps Golden Hour.
     ================================================================ */
  :global(html.drawing) {
    --bg: #f5f5f1;
    --sheet: #ffffff;
    --ink: #111111;
    --ink-2: #33332f;
    --soft: #64645e;
    --hair: #d6d6cf;
    --grid: #e7e7e1;
    --sig: #ff4f00;
    --sig-text: #c23800;
    --blue: #1f4fd8;
    --sans: 'Archivo Variable', 'Helvetica Neue', Arial, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    scroll-padding-top: 84px;
  }
  :global(html.drawing body) {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  :global(html.drawing body::after) {
    display: none;
  }
  :global(html.drawing ::selection) {
    background: var(--sig);
    color: #fff;
  }
  :global(html.drawing main) {
    min-height: 0;
  }
  :global(html.drawing a) {
    color: inherit;
    font-weight: inherit;
    background-image: none;
  }
  :global(html.drawing a:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .d-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  p {
    max-width: none;
  }
  h2,
  h3 {
    font-family: var(--sans);
    font-variation-settings: normal;
    text-wrap: balance;
  }

  /* --- buttons and links --- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.35rem;
    border: 1.5px solid var(--ink);
    font-family: var(--sans);
    font-weight: 650;
    font-size: 0.98rem;
    letter-spacing: 0.005em;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .btn span {
    transition: transform 0.3s var(--ease);
  }
  .btn:hover span {
    transform: translateX(4px);
  }
  .btn-sig {
    background: var(--sig);
    border-color: var(--sig);
    color: var(--ink);
  }
  .btn-sig:hover {
    box-shadow: 4px 4px 0 var(--ink);
    transform: translate(-2px, -2px);
  }
  .btn-ink {
    background: var(--ink);
    color: #fff;
  }
  .btn-ink:hover {
    background: var(--sig);
    border-color: var(--sig);
  }
  .btn-line {
    background: var(--bg);
  }
  .btn-line:hover {
    background: var(--ink);
    color: #fff;
  }
  .btn.big {
    padding: 1.2rem 1.6rem;
    font-size: 1.1rem;
  }
  .arrow-link {
    display: inline-block;
    font-weight: 650;
    border-bottom: 1.5px solid var(--sig);
    padding-bottom: 2px;
    transition: color 0.25s var(--ease);
  }
  .arrow-link:hover {
    color: var(--sig-text);
  }

  /* --- hero --- */
  .hero {
    position: relative;
    border-bottom: 1px solid var(--ink);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
  }
  .hero-in {
    display: grid;
    gap: 3rem;
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }
  @media (min-width: 1000px) {
    .hero-in {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      gap: 0;
      min-height: calc(100svh - 69px);
      align-items: stretch;
    }
    .hero-copy {
      padding-right: clamp(32px, 4vw, 64px);
      border-right: 1px solid var(--ink);
    }
    .drawing {
      padding-left: clamp(24px, 3vw, 48px);
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .tag {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .tag i {
    flex: none;
    width: 9px;
    height: 9px;
    background: var(--sig);
  }
  .hero-title {
    margin-top: 1.5rem;
    font-family: var(--sans);
    font-variation-settings: normal;
    font-weight: 820;
    font-stretch: 68%;
    font-size: clamp(3.6rem, 8vw, 7.2rem);
    line-height: 0.86;
    letter-spacing: -0.012em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .hero-title span {
    color: var(--sig);
  }
  .dim {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.6rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .dim::before,
  .dim::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--blue);
  }
  .dim::before {
    max-width: 2.5rem;
  }
  .hero-lede {
    margin-top: 1.6rem;
    max-width: 33rem;
    font-size: clamp(1.08rem, 1.5vw, 1.22rem);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .hero-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .tblock {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--ink);
    background: var(--sheet);
    font-family: var(--mono);
  }
  .tblock div {
    padding: 0.55rem 0.7rem;
    border-right: 1px solid var(--ink);
    min-width: 0;
  }
  .tblock div:last-child {
    border-right: 0;
  }
  .tblock dt {
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .tblock dd {
    margin: 0.15rem 0 0;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 560px) {
    .tblock {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tblock div:nth-child(2) {
      border-right: 0;
    }
    .tblock div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--ink);
    }
  }

  /* --- the as-built drawing --- */
  .drawing {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .drawing svg {
    width: 100%;
    max-width: 600px;
    height: auto;
    overflow: visible;
  }
  .fig {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--soft);
  }
  .dimline path {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1;
  }
  .dimline text {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: var(--blue);
  }
  .wires path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .joints circle {
    fill: var(--ink);
  }
  .pulses circle {
    fill: var(--sig);
    opacity: 0;
  }
  .node rect {
    fill: var(--sheet);
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .node.hot > rect {
    stroke: var(--sig);
    stroke-width: 2;
  }
  .ntag rect {
    fill: var(--ink);
    stroke: none;
  }
  .node.hot .ntag rect {
    fill: var(--sig);
  }
  .ntag text {
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    fill: #fff;
  }
  .nname {
    font-family: var(--sans);
    font-size: 19px;
    font-weight: 720;
    font-stretch: 88%;
    fill: var(--ink);
  }
  .nnote {
    font-family: var(--mono);
    font-size: 11.5px;
    fill: var(--soft);
  }
  @media (max-width: 640px) {
    .nname {
      font-size: 21px;
    }
    .nnote {
      font-size: 12px;
    }
  }
  .call path {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1;
  }
  .call rect {
    fill: var(--bg);
    stroke: var(--blue);
    stroke-width: 1;
  }
  .call text {
    font-family: var(--mono);
    font-size: 10.5px;
    fill: var(--blue);
  }

  /* --- section frame --- */
  .sec {
    padding: clamp(80px, 11vw, 140px) 0;
    border-bottom: 1px solid var(--ink);
  }
  .sec-head {
    display: grid;
    gap: 1rem;
    padding-bottom: clamp(28px, 4vw, 44px);
  }
  @media (min-width: 900px) {
    .sec-head {
      grid-template-columns: 200px 1fr;
      align-items: end;
    }
  }
  .sec-num {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--sig-text);
    padding-bottom: 0.6rem;
  }
  .sec-head h2 {
    font-weight: 800;
    font-stretch: 70%;
    font-size: clamp(2.6rem, 6.2vw, 5.2rem);
    line-height: 0.9;
    letter-spacing: -0.005em;
    text-transform: uppercase;
  }

  /* spec tables: problems and prices */
  .spec {
    border-top: 2px solid var(--ink);
  }
  .spec-row {
    display: grid;
    gap: 0.4rem 2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--ink);
    transition: background-color 0.3s var(--ease);
  }
  .spec-row:not(.spec-cols):hover {
    background: var(--sheet);
  }
  .spec-cols {
    padding: 0.7rem 0;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }
  @media (min-width: 900px) {
    #problems .spec-row {
      grid-template-columns: 200px 1fr 1fr;
      align-items: baseline;
    }
  }
  @media (max-width: 899px) {
    #problems .spec-cols {
      display: none;
    }
  }
  .spec-no {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--sig-text);
  }
  .spec-problem {
    font-weight: 650;
    font-stretch: 90%;
    font-size: clamp(1.25rem, 2.1vw, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .spec-fix {
    position: relative;
    padding-left: 1.6rem;
    color: var(--ink-2);
  }
  .spec-fix::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--sig);
    font-weight: 700;
  }

  /* --- systems: what gets built, then the proof --- */
  @media (min-width: 900px) {
    .sys-intro,
    .caps {
      display: grid;
      grid-template-columns: 200px 1fr;
      column-gap: 2rem;
    }
    .sys-lede {
      grid-column: 2;
    }
  }
  .sys-lede {
    max-width: 52rem;
    font-weight: 600;
    font-stretch: 92%;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    line-height: 1.3;
  }
  .caps {
    margin-top: clamp(40px, 6vw, 72px);
  }
  .caps-head {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
    padding: 1.2rem 0 1rem;
  }
  .caps-list {
    list-style: none;
    padding: 0;
    display: grid;
    border-top: 2px solid var(--ink);
  }
  .caps-list li {
    padding: 1.4rem 1.4rem 1.6rem 0;
    border-bottom: 1px solid var(--ink);
  }
  @media (min-width: 700px) {
    .caps-list {
      grid-template-columns: repeat(6, 1fr);
    }
    .caps-list li {
      grid-column: span 2;
      padding-left: 1.4rem;
      border-right: 1px solid var(--ink);
    }
    .caps-list li:nth-child(3n + 1) {
      padding-left: 0;
    }
    .caps-list li:nth-child(3),
    .caps-list li:last-child {
      border-right: 0;
    }
    .caps-list li:nth-child(n + 4) {
      grid-column: span 3;
    }
    .caps-list li:nth-child(4) {
      padding-left: 0;
    }
  }
  .cap-no {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--blue);
  }
  .caps-list h3 {
    margin-top: 0.55rem;
    font-weight: 720;
    font-stretch: 85%;
    font-size: 1.35rem;
    line-height: 1.15;
  }
  .caps-list p {
    margin-top: 0.55rem;
    font-size: 0.98rem;
    color: var(--ink-2);
  }
  .proof-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(56px, 8vw, 88px);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .proof-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--blue);
  }
  .dsheet {
    position: relative;
    margin-top: 1.6rem;
    border: 1.5px solid var(--ink);
    background: var(--sheet);
  }
  .crop {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--ink);
    border-style: solid;
    pointer-events: none;
  }
  .crop.tl {
    top: -10px;
    left: -10px;
    border-width: 1.5px 0 0 1.5px;
  }
  .crop.tr {
    top: -10px;
    right: -10px;
    border-width: 1.5px 1.5px 0 0;
  }
  .crop.bl {
    bottom: -10px;
    left: -10px;
    border-width: 0 0 1.5px 1.5px;
  }
  .crop.br {
    bottom: -10px;
    right: -10px;
    border-width: 0 1.5px 1.5px 0;
  }

  /* the project sheet: a title block, a map of how the departments hang off
     one record, what it does, and the figures. no screens, no names */
  .pblock {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1.5px solid var(--ink);
  }
  @media (min-width: 900px) {
    .pblock {
      grid-template-columns: 1.3fr 1.3fr 1.5fr 0.6fr;
    }
  }
  .pblock div {
    padding: 0.8rem 1.2rem 0.9rem;
    border-right: 1px solid var(--ink);
    min-width: 0;
  }
  .pblock div:last-child {
    border-right: 0;
  }
  @media (max-width: 899px) {
    .pblock div:nth-child(2) {
      border-right: 0;
    }
    .pblock div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--ink);
    }
  }
  .pblock dt {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .pblock dd {
    margin: 0.25rem 0 0;
    font-weight: 650;
    font-stretch: 92%;
    font-size: 1.02rem;
    line-height: 1.25;
  }
  .pblock div:last-child dd {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .pblock div:last-child dd::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sig);
    box-shadow: 0 0 0 0 rgb(255 79 0 / 0.5);
    animation: live 2.4s ease-out infinite;
  }
  @keyframes live {
    0% {
      box-shadow: 0 0 0 0 rgb(255 79 0 / 0.45);
    }
    70%,
    100% {
      box-shadow: 0 0 0 9px rgb(255 79 0 / 0);
    }
  }

  .map {
    padding: clamp(24px, 3vw, 36px) clamp(18px, 3vw, 40px) clamp(28px, 3.5vw, 40px);
    border-bottom: 1.5px solid var(--ink);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .map-label,
  .map-out-label {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .map-grid {
    display: grid;
    gap: 14px;
    margin-top: 1.4rem;
  }
  .map-col {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .map-node {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem 0.8rem;
    border: 1.5px solid var(--ink);
    background: var(--sheet);
  }
  .mn-name {
    font-weight: 700;
    font-stretch: 88%;
    font-size: 1.05rem;
    line-height: 1.15;
  }
  .mn-note {
    font-family: var(--mono);
    font-size: 0.66rem;
    line-height: 1.45;
    color: var(--soft);
  }
  .map-core {
    position: relative;
    display: grid;
    gap: 0.4rem;
    align-content: center;
    padding: 1.6rem 1.3rem;
    border: 2px solid var(--sig);
    background: var(--sheet);
    text-align: center;
  }
  .core-tag {
    position: absolute;
    top: -2px;
    right: -2px;
    padding: 0.12rem 0.45rem;
    background: var(--sig);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .core-name {
    font-weight: 820;
    font-stretch: 68%;
    font-size: clamp(2rem, 3.4vw, 2.7rem);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .core-note {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--soft);
  }
  @media (max-width: 899px) {
    .map-core {
      order: -1;
    }
  }

  /* desktop: departments on two buses, both buses tied into the core */
  @media (min-width: 900px) {
    .map-grid {
      grid-template-columns: minmax(0, 1fr) 250px minmax(0, 1fr);
      column-gap: 72px;
      align-items: center;
    }
    .map-col {
      grid-template-columns: 1fr;
      position: relative;
    }
    /* each node's stub to its bus */
    .map-left .map-node::after,
    .map-right .map-node::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 36px;
      height: 1.5px;
      background: var(--ink);
    }
    .map-left .map-node::after {
      left: 100%;
    }
    .map-right .map-node::after {
      right: 100%;
    }
    /* the buses: from the first node's centre to the last's (3 gaps of 14px) */
    .map-col::after {
      content: '';
      position: absolute;
      top: calc((100% - 42px) / 8);
      bottom: calc((100% - 42px) / 8);
      width: 1.5px;
      background: var(--ink);
    }
    .map-left::after {
      right: -37px;
    }
    .map-right::after {
      left: -37px;
    }
    /* bus to core, with a joint where they meet */
    .map-core::before,
    .map-core::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 36px;
      height: 1.5px;
      background: var(--ink);
    }
    .map-core::before {
      right: 100%;
    }
    .map-core::after {
      left: 100%;
    }
    .map-grid {
      position: relative;
    }
  }

  .map-out {
    margin-top: 1.6rem;
    padding-top: 1.1rem;
    border-top: 1px dashed var(--blue);
  }
  .map-out ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }
  .map-out li {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--blue);
    background: var(--sheet);
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--blue);
  }

  .pspec-row {
    display: grid;
    gap: 0.35rem 2rem;
    padding: 1.1rem clamp(18px, 3vw, 40px);
    border-bottom: 1px solid var(--ink);
  }
  @media (min-width: 900px) {
    .pspec-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      align-items: baseline;
    }
  }
  .pspec-cols {
    padding-top: 0.7rem;
    padding-bottom: 0.7rem;
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }
  @media (max-width: 899px) {
    .pspec-cols {
      display: none;
    }
  }
  .pspec-cap {
    font-weight: 680;
    font-stretch: 90%;
    font-size: 1.12rem;
    line-height: 1.25;
  }
  .pspec-detail {
    color: var(--ink-2);
  }
  .walk {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.4rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .walk i {
    flex: none;
    width: 9px;
    height: 9px;
    background: var(--sig);
  }
  @media (prefers-reduced-motion: reduce) {
    .pblock div:last-child dd::before {
      animation: none;
    }
  }
  .sheet-foot {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1.5px solid var(--ink);
  }
  @media (min-width: 900px) {
    .sheet-foot {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .fig-cell {
    padding: 1.2rem 1.25rem 1.3rem;
    border-right: 1px solid var(--ink);
  }
  .fig-cell:last-child {
    border-right: 0;
  }
  @media (max-width: 899px) {
    .fig-cell:nth-child(2) {
      border-right: 0;
    }
    .fig-cell:nth-child(-n + 2) {
      border-bottom: 1px solid var(--ink);
    }
  }
  .fig-cell dt {
    font-weight: 800;
    font-stretch: 70%;
    font-size: clamp(2.4rem, 4.4vw, 3.4rem);
    line-height: 0.95;
  }
  .fig-cell dd {
    margin: 0.45rem 0 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--soft);
  }

  /* --- process --- */
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    border-top: 2px solid var(--ink);
    position: relative;
  }
  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .steps::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -2px;
    height: 4px;
    background: var(--sig);
    transform-origin: left center;
  }
  .step {
    padding: 1.6rem 1.5rem 1.8rem 0;
    border-bottom: 1px solid var(--ink);
  }
  @media (min-width: 900px) {
    .step {
      padding: 1.8rem 1.6rem 2rem;
      border-bottom: 0;
      border-right: 1px solid var(--ink);
    }
    .step:first-child {
      padding-left: 0;
    }
    .step:last-child {
      border-right: 0;
    }
  }
  .step-no {
    display: block;
    font-weight: 800;
    font-stretch: 70%;
    font-size: 3.6rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
  }
  .step h3 {
    margin-top: 0.9rem;
    font-weight: 750;
    font-stretch: 85%;
    font-size: 1.55rem;
    line-height: 1.1;
  }
  .step-tag {
    display: inline-block;
    margin-top: 0.7rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--blue);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .step p {
    margin-top: 0.9rem;
    color: var(--ink-2);
    font-size: 1rem;
  }

  /* --- who --- */
  .who {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .who {
      grid-template-columns: 200px 300px 1fr;
    }
    .who-photo {
      grid-column: 2;
    }
  }
  .who-photo {
    position: relative;
    max-width: 300px;
    border: 1.5px solid var(--ink);
    background: var(--sheet);
    padding: 10px;
  }
  .who-photo img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.08);
  }
  .who-body {
    font-size: clamp(1.1rem, 1.6vw, 1.28rem);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .who-body :global(p + p) {
    margin-top: 1rem;
  }
  .who-body :global(a) {
    color: var(--ink);
    font-weight: 650;
    border-bottom: 1.5px solid var(--sig);
  }
  .revs {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    border-top: 1.5px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  .revs li {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--hair);
  }
  .rev-no {
    color: var(--blue);
  }
  .rev-place {
    color: var(--soft);
    text-align: right;
  }
  .revs li:last-child .rev-role,
  .revs li:last-child .rev-place {
    color: var(--sig-text);
  }

  /* --- work --- */
  .cases {
    display: grid;
    gap: clamp(56px, 8vw, 96px);
  }
  .case {
    display: grid;
    gap: 2rem 4rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .case {
      grid-template-columns: 1.15fr 1fr;
    }
    .case:nth-child(even) .case-shot {
      order: 2;
    }
  }
  .case-shot {
    position: relative;
    display: block;
    border: 1.5px solid var(--ink);
    background: var(--sheet);
    padding: 10px;
  }
  .case-label {
    position: absolute;
    top: -0.75rem;
    left: 14px;
    z-index: 1;
    padding: 0.15rem 0.45rem;
    background: var(--ink);
    color: #fff;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .case-shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .case-meta {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .case h3 {
    margin-top: 0.6rem;
    font-weight: 800;
    font-stretch: 72%;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .case-body {
    margin-top: 1rem;
    color: var(--ink-2);
  }
  .case-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 1.6rem 0;
    border-top: 1.5px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .case-stats div {
    padding: 0.9rem 1rem 1rem 0;
  }
  .case-stats div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--ink);
  }
  .case-stats dt {
    font-weight: 800;
    font-stretch: 70%;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1;
  }
  .case-stats dd {
    margin: 0.4rem 0 0;
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--soft);
  }
  .more {
    margin-top: clamp(48px, 6vw, 72px);
  }

  /* --- prices --- */
  @media (min-width: 900px) {
    .prices .spec-row {
      grid-template-columns: 1fr 240px 1.4fr;
      align-items: baseline;
    }
  }
  @media (max-width: 899px) {
    .prices .spec-cols {
      display: none;
    }
  }
  .price-name {
    font-weight: 700;
    font-stretch: 88%;
    font-size: 1.35rem;
  }
  .price-amt {
    font-weight: 800;
    font-stretch: 75%;
    font-size: 1.55rem;
    color: var(--sig-text);
  }
  .price-body {
    color: var(--ink-2);
  }
  .spec-row.top {
    position: relative;
    background: var(--sheet);
  }
  .spec-row.top::before {
    content: '';
    position: absolute;
    left: -14px;
    top: -1px;
    bottom: -1px;
    width: 4px;
    background: var(--sig);
  }
  .founding {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.4rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--ink-2);
  }
  .founding i {
    flex: none;
    width: 9px;
    height: 9px;
    background: var(--sig);
  }

  /* --- the close and the footer: one black sheet --- */
  .start {
    background: var(--ink);
    color: #fff;
    padding: clamp(80px, 11vw, 140px) 0;
  }
  .start-in {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }
  @media (min-width: 900px) {
    .start-in {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .start h2 {
    font-weight: 820;
    font-stretch: 68%;
    font-size: clamp(3.2rem, 8vw, 7rem);
    line-height: 0.86;
    text-transform: uppercase;
    color: #fff;
  }
  .start-body {
    font-size: 1.2rem;
    color: #d8d8d2;
    margin-bottom: 1.6rem;
  }
  .start .btn-sig:hover {
    box-shadow: 4px 4px 0 #fff;
  }
  /* --- the note: the quick way in --- */
  .note {
    display: grid;
    gap: 1rem;
  }
  .note-pair {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 560px) {
    .note-pair {
      grid-template-columns: 1fr 1fr;
    }
  }
  .note label {
    display: grid;
    gap: 0.4rem;
  }
  .note label > span {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9a9a94;
  }
  .note input,
  .note textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1.5px solid #4a4a46;
    border-radius: 0;
    background: #1b1b1a;
    color: #fff;
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.3s var(--ease);
  }
  .note textarea {
    resize: vertical;
    min-height: 7.5rem;
  }
  .note input:focus,
  .note textarea:focus {
    outline: none;
    border-color: var(--sig);
  }
  .note-trap {
    position: absolute;
    left: -9999px;
  }
  .note-go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.4rem;
  }
  .note button {
    cursor: pointer;
  }
  .note button b {
    font-weight: inherit;
  }
  .note button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .note-status {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: #d8d8d2;
  }
  .note-error {
    color: #ff8a57;
  }
  .note-error a,
  .start-alt a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* shown after a send; without script the Worker redirects to /#sent */
  .note-sent {
    display: none;
    font-size: 1.2rem;
    color: #fff;
    border-left: 3px solid var(--sig);
    padding-left: 1rem;
  }
  .note-sent:focus {
    outline: none;
  }
  .note-sent:target,
  .start.is-sent .note-sent {
    display: block;
  }
  .start-side:has(.note-sent:target) .note,
  .start.is-sent .note {
    display: none;
  }
  .start-alt {
    margin-top: 1.4rem;
    color: #d8d8d2;
  }
  .start-area {
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: #9a9a94;
  }
  /* the close runs straight into the shared black footer */
  :global(html.drawing .foot) {
    margin-top: 0;
    border-top: 1px solid #2c2c2a;
  }

  /* --- entrances --- */
  .rise {
    animation: d-rise 0.9s var(--ease) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes d-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* longhands only: see the note in global.css */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .spec-row:not(.spec-cols),
      .caps-list li,
      .step,
      .case,
      .who,
      .project,
      .sec-head {
        animation-name: d-rise;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 50%;
      }
      .steps::after {
        animation-name: fill-rule;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 70% cover 45%;
      }
    }
  }
  @keyframes fill-rule {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  // the note posts in place; without script the form posts itself and the
  // Worker sends the browser back to /#sent
  const note = document.getElementById('note') as HTMLFormElement | null;
  if (note) {
    const button = note.querySelector('button')!;
    const label = button.querySelector('b')!;
    const status = note.querySelector('.note-status')!;
    const error = note.querySelector<HTMLElement>('.note-error')!;
    const idle = label.textContent;
    note.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      label.textContent = button.dataset.sending ?? idle;
      status.textContent = '';
      error.hidden = true;
      try {
        const res = await fetch(note.action, { method: 'POST', body: new FormData(note), headers: { Accept: 'application/json' } });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(res.status < 500 ? (out.error ?? '') : '');
        note.closest('.start')!.classList.add('is-sent');
        document.getElementById('sent')!.focus();
      } catch (err) {
        // the Worker's own words for a fixable problem; the email fallback for
        // anything else, a dropped connection included
        const msg = err instanceof TypeError ? '' : (err as Error).message;
        if (msg) status.textContent = msg;
        else error.hidden = false;
      } finally {
        button.disabled = false;
        label.textContent = idle;
      }
    });
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // the as-built drawing draws itself, then the signal starts running the
  // handoffs. reduced motion, or no script, gets the finished drawing.
  const drawing = document.getElementById('drawing');
  if (drawing && !reduced) {
    const svg = drawing.querySelector('svg')!;
    const wires = drawing.querySelectorAll<SVGPathElement>('.wires path');
    const dims = drawing.querySelectorAll('.dimline');
    const nodes = drawing.querySelectorAll('.node');
    const joints = drawing.querySelectorAll('.joints circle');
    const calls = drawing.querySelectorAll('.call');
    const fig = drawing.querySelector('.fig');

    gsap.set(wires, { strokeDasharray: 1, strokeDashoffset: 1 });
    gsap.set([...nodes, ...calls, ...joints, ...dims, fig], { opacity: 0 });
    gsap.set(nodes, { y: 8 });

    const start = (): void => {
      drawing.classList.add('is-running');
      drawing.querySelectorAll<SVGAnimationElement>('animateMotion').forEach((m) => {
        // each dot stays hidden until its own run starts, or it waits at the origin
        window.setTimeout(() => {
          m.beginElement();
          (m.parentNode as SVGElement).style.opacity = '1';
        }, Number(m.dataset.offset ?? 0) * 1000);
      });
    };

    const tl = gsap
      .timeline({ paused: true, delay: 0.3, defaults: { ease: 'power3.out' } })
      .to([fig, ...dims], { opacity: 1, duration: 0.6 })
      .to(nodes[0], { opacity: 1, y: 0, duration: 0.5 }, '<0.1')
      .to(wires[0], { strokeDashoffset: 0, duration: 0.55, ease: 'power2.inOut' })
      .to(nodes[1], { opacity: 1, y: 0, duration: 0.5 }, '-=0.1')
      .to(calls[0], { opacity: 1, duration: 0.4 }, '<')
      .to([wires[1], wires[2]], { strokeDashoffset: 0, duration: 0.6, ease: 'power2.inOut' })
      .to(joints[0], { opacity: 1, duration: 0.2 }, '<0.2')
      .to([nodes[2], nodes[3]], { opacity: 1, y: 0, duration: 0.5, stagger: 0.1 }, '-=0.15')
      .to([wires[3], wires[4]], { strokeDashoffset: 0, duration: 0.6, ease: 'power2.inOut' })
      .to(joints[1], { opacity: 1, duration: 0.2 }, '<0.3')
      .to(nodes[4], { opacity: 1, y: 0, duration: 0.5 }, '-=0.1')
      .to(calls[1], { opacity: 1, duration: 0.4 })
      .add(start);

    // draw once the drawing is actually in view; on a phone it sits below the copy
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        tl.play();
        seen.disconnect();
      },
      { threshold: 0.3 },
    );
    seen.observe(drawing);

    // the pulses are decoration; rest them while the drawing is off screen
    new IntersectionObserver((entries) => {
      if (!drawing.classList.contains('is-running')) return;
      if (entries.some((e) => e.isIntersecting)) svg.unpauseAnimations();
      else svg.pauseAnimations();
    }).observe(drawing);
  }
</script>
