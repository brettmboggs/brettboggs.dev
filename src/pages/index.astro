  @media (min-width: 560px) {
    .pair {
      grid-template-columns: 1fr 1fr;
    }
  }
  .note label {
    display: grid;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .note input,
  .note textarea {
    width: 100%;
    padding: 0.85rem 0.95rem;
    border: 0;
    border-radius: 12px;
    background: var(--bg);
    font: inherit;
    font-weight: 400;
    font-size: 1rem;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px transparent;
    transition: box-shadow 0.2s;
  }
  .note input:focus,
  .note textarea:focus {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--ink);
  }
  .note textarea {
    min-height: 7rem;
    resize: vertical;
  }
  .note-trap {
    position: absolute;
    left: -9999px;
  }
  .note-go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .note button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .note-status {
    font: 400 0.78rem var(--mono);
    color: var(--ink-2);
  }
  .note-error {
    color: var(--sig-text);
  }
  .note-error a,
  .start-alt a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* shown after a send; without script the Worker redirects to /#sent */
  .note-sent {
    display: none;
    padding: 1.2rem 1.3rem;
    border-radius: 14px;
    background: var(--bg);
    font-weight: 600;
    font-size: 1.1rem;
  }
  .note-sent:focus {
    outline: none;
  }
  .note-sent:target,
  .start:global(.is-sent) .note-sent {
    display: block;
  }
  .start-in > div:has(.note-sent:target) .note,
  .start:global(.is-sent) .note {
    display: none;
  }
  .start-alt {
    margin-top: 1.2rem;
    color: var(--ink-2);
  }
  .start-area {
    margin-top: 0.6rem;
    font: 400 0.72rem var(--mono);
    color: var(--soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .cut::after,
    .lines :global(.line.new),
    .tape-col:global(.is-cut) .after {
      animation: none;
    }
    .tape,
    .seal,
    .btn {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const money = (n: number): string => '$' + Math.round(n).toLocaleString('en-US');
  const cents = (n: number): string =>
    '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  /* ---------------- hero: the statement reads itself, once ---------------- */
  const sw = Array.from(document.querySelectorAll<HTMLElement>('.r.sw'));
  const one = document.getElementById('one');
  const cancel = document.getElementById('cancel');
  const replay = document.getElementById('replay');
  const softEl = document.getElementById('soft');
  const keptEl = document.getElementById('kept');
  const stmt = document.getElementById('stmt');
  if (!reduced && stmt && one && cancel && replay && softEl && keptEl && sw.length) {
    const amounts = sw.map((r) => Number(r.dataset.amount));
    const softTotal = amounts.reduce((a, b) => a + b, 0);
    const plan = Number(one.querySelector('.v')?.textContent ?? 0);
    const state = { soft: plan, kept: softTotal - plan };
    const paint = (): void => {
      softEl.textContent = cents(state.soft);
      keptEl.textContent = cents(state.kept);
    };
    const tl = gsap.timeline({ paused: true, defaults: { ease: 'power2.out' }, onComplete: () => replay.classList.add('on') });
    tl.call(() => {
      sw.forEach((r) => r.classList.remove('gone'));
      gsap.set(sw, { '--hl': 0, opacity: 1 });
      gsap.set(one, { opacity: 0, y: 10 });
      gsap.set(cancel, { opacity: 0, scale: 1.5 });
      state.soft = 0;
      state.kept = 0;
      paint();
      replay.classList.remove('on');
    });
    // the highlighter finds every software charge, the tally climbs with it
    sw.forEach((r, i) => {
      tl.to(r, { '--hl': 1, duration: 0.32, ease: 'power1.inOut' }, 0.3 + i * 0.2);
      tl.to(state, { soft: amounts.slice(0, i + 1).reduce((a, b) => a + b, 0), duration: 0.25, onUpdate: paint }, 0.36 + i * 0.2);
    });
    tl.to(cancel, { opacity: 1, scale: 1, duration: 0.3, ease: 'back.out(3)' }, '+=0.45');
    // cancelled: the charges stay on the page, struck out, and one line takes over
    tl.call(() => sw.forEach((r) => r.classList.add('gone')), undefined, '+=0.45');
    tl.to(sw, { opacity: 0.4, duration: 0.45, stagger: 0.03 }, '<');
    tl.to(cancel, { opacity: 0, duration: 0.3 }, '+=0.2');
    tl.to(one, { opacity: 1, y: 0, duration: 0.45 }, '<');
    tl.to(state, { soft: plan, kept: softTotal - plan, duration: 0.7, onUpdate: paint }, '<');

    // play when the statement is actually on screen, once
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        tl.play(0);
        seen.disconnect();
      },
      { threshold: 0.4 },
    );
    seen.observe(stmt);
    replay.addEventListener('click', () => tl.play(0));
  }

  /* ---------------- overhead: the tape prints what's switched on ---------------- */
  const tools = Array.from(document.querySelectorAll<HTMLLabelElement>('.tool')).map((row) => {
    const box = row.querySelector<HTMLInputElement>('input[type=checkbox]')!;
    const price = row.querySelector<HTMLInputElement>('.price input')!;
    // typing a price must not toggle the row
    price.addEventListener('click', (e) => e.preventDefault());
    return { name: box.dataset.name ?? '', box, price };
  });
  const hrs = document.getElementById('hrs') as HTMLInputElement | null;
  const wage = document.getElementById('wage') as HTMLInputElement | null;
  const linesEl = document.getElementById('lines');
  const totalEl = document.getElementById('totalY');
  const payback = document.getElementById('payback');
  let shown = new Set<string>();
  let shownTotal = 0;

  // the total rolls to its new value like a register
  const roll = (to: number): void => {
    if (!totalEl) return;
    const o = { v: shownTotal };
    shownTotal = to;
    if (reduced) {
      totalEl.textContent = money(to);
      return;
    }
    gsap.to(o, { v: to, duration: 0.6, ease: 'power3.out', onUpdate: () => { totalEl.textContent = money(o.v); } });
  };

  const priceOf = (t: (typeof tools)[number]): number => Math.max(0, parseFloat(t.price.value) || 0);
  function render(): void {
    if (!linesEl || !hrs || !wage) return;
    const on = tools.filter((t) => t.box.checked);
    linesEl.replaceChildren(
      ...on.map((t) => {
        const row = document.createElement('div');
        row.className = shown.has(t.name) ? 'line' : 'line new';
        const name = document.createElement('span');
        name.textContent = t.name;
        const year = document.createElement('span');
        year.textContent = money(priceOf(t) * 12);
        row.append(name, year);
        return row;
      }),
    );
    shown = new Set(on.map((t) => t.name));
    const soft = on.reduce((s, t) => s + priceOf(t) * 12, 0);
    const lost = Number(hrs.value) * Number(wage.value) * 52;
    document.getElementById('hrsOut')!.textContent = hrs.value;
    document.getElementById('wageOut')!.textContent = '$' + wage.value;
    document.getElementById('softY')!.textContent = money(soft);
    document.getElementById('hoursY')!.textContent = money(lost);
    roll(soft + lost);
    if (payback) payback.textContent = (payback.dataset.text ?? '').replace('{total}', `${money(soft + lost)} a year`);
  }
  tools.forEach((t) => {
    t.box.addEventListener('change', render);
    t.price.addEventListener('input', render);
  });
  hrs?.addEventListener('input', render);
  wage?.addEventListener('input', render);
  render();
  document.getElementById('cut')?.addEventListener('click', () => document.getElementById('tapeCol')?.classList.add('is-cut'));

  /* ---------------- ownership: the seal lands when the deed is read ---------------- */
  const deed = document.getElementById('deed');
  if (deed && !reduced) {
    deed.classList.add('unstamped');
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        window.setTimeout(() => deed.classList.remove('unstamped'), 450);
        io.disconnect();
      },
      { threshold: 0.5 },
    );
    io.observe(deed);
  }

  /* ---------------- contact: the note posts in place ---------------- */
  // without script the form posts itself and the Worker sends the browser back to /#sent
  const note = document.getElementById('note') as HTMLFormElement | null;
  if (note) {
    const button = note.querySelector('button')!;
    const label = button.querySelector('b')!;
    const status = note.querySelector('.note-status')!;
    const error = note.querySelector<HTMLElement>('.note-error')!;
    const idle = label.textContent;
    note.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      label.textContent = button.dataset.sending ?? idle;
      status.textContent = '';
      error.hidden = true;
      try {
        const res = await fetch(note.action, { method: 'POST', body: new FormData(note), headers: { Accept: 'application/json' } });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(res.status < 500 ? (out.error ?? '') : '');
        note.closest('.start')!.classList.add('is-sent');
        document.getElementById('sent')!.focus();
      } catch (err) {
        // the Worker's own words for a fixable problem; the email fallback for
        // anything else, a dropped connection included
        const msg = err instanceof TypeError ? '' : (err as Error).message;
        if (msg) status.textContent = msg;
        else error.hidden = false;
      } finally {
        button.disabled = false;
        label.textContent = idle;
      }
    });
  }
</script>
