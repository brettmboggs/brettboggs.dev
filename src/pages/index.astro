---
import Base from '../layouts/Base.astro';
import copy from '../data/copy/home.json';
import { md } from '../data/copy';

const { hero, problems, process, about, proof, pricing, contact } = copy;

// where each scrap of the old way lands on the board: percent of the board,
// plus a tilt. hand-placed so nothing covers a word at any board width.
const scatter = [
  { x: 6, y: 7, r: -4 },
  { x: 48, y: 15, r: 3 },
  { x: 14, y: 29, r: 2 },
  { x: 52, y: 38, r: -3 },
  { x: 8, y: 52, r: -2 },
  { x: 40, y: 62, r: 4 },
  { x: 12, y: 76, r: 3 },
  { x: 50, y: 85, r: -5 },
];
const mess = hero.mess.map((text, i) => ({ text, fee: text.includes('/mo'), ...scatter[i % scatter.length] }));
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(contact.subject)}`;
---

<Base title={copy.title} description={copy.description} home edit="pages/home">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow reveal">{hero.eyebrow}</p>
      <h1 class="reveal" style="--delay: 0.08s">{hero.title}</h1>
      <p class="hero-lede reveal" style="--delay: 0.18s">{hero.lede}</p>
      <div class="hero-actions reveal" style="--delay: 0.28s">
        <a class="button" href="#start">{hero.cta}</a>
        <a class="quiet" href="/work/">{hero.secondary}</a>
      </div>
    </div>

    <figure class="board reveal" id="board" style="--delay: 0.2s" aria-label={hero.boardLabel}>
      <div class="board-mess" aria-hidden="true">
        {
          mess.map((m) => (
            <span class:list={['chip', { fee: m.fee }]} style={`left:${m.x}%;top:${m.y}%`} data-r={m.r}>
              {m.text}
              {m.fee && <span class="strike" />}
            </span>
          ))
        }
      </div>
      <ol class="flow">
        <span class="flow-line" aria-hidden="true"></span>
        {
          hero.flow.map((f) => (
            <li class="flow-step">
              <span class="flow-dot" aria-hidden="true" />
              <span class="flow-name">{f.step}</span>
              <span class="flow-note">{f.note}</span>
            </li>
          ))
        }
      </ol>
      <p class="stamp">{hero.stamp}</p>
      <button class="replay" id="replay" type="button" hidden>{hero.replay}</button>
    </figure>
  </section>

  <section class="block" id="problems">
    <header class="block-head">
      <p class="eyebrow">{problems.eyebrow}</p>
      <h2>{problems.heading}</h2>
    </header>
    <ul class="rows">
      {
        problems.items.map((p) => (
          <li class="row">
            <p class="row-problem">{p.problem}</p>
            <p class="row-fix">{p.fix}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block" id="process">
    <header class="block-head">
      <p class="eyebrow">{process.eyebrow}</p>
      <h2>{process.heading}</h2>
    </header>
    <ol class="steps">
      {
        process.steps.map((s, i) => (
          <li class="step">
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="block who" id="who">
    <header class="block-head">
      <p class="eyebrow">{about.eyebrow}</p>
      <h2>{about.heading}</h2>
    </header>
    <div class="who-grid">
      <img class="who-portrait" src={about.portrait} alt={about.portraitAlt} width="480" height="600" loading="lazy" decoding="async" />
      <div class="prose who-body" set:html={md(about.body)} />
    </div>
  </section>

  <section class="block" id="work">
    <header class="block-head">
      <p class="eyebrow">{proof.eyebrow}</p>
      <h2>{proof.heading}</h2>
    </header>
    <div class="cases">
      {
        proof.items.map((c) => (
          <article class="case">
            <a class="case-shot" href={c.url} tabindex="-1" aria-hidden="true">
              <img src={c.image} alt="" width="1440" height="960" loading="lazy" />
            </a>
            <div class="case-text">
              <p class="case-meta">{c.meta}</p>
              <h3>{c.name}</h3>
              <p class="case-body">{c.body}</p>
              <dl class="stats">
                {c.stats.map((s) => (
                  <div class="stat">
                    <dt>{s.value}</dt>
                    <dd>{s.label}</dd>
                  </div>
                ))}
              </dl>
              <a class="case-link" href={c.url}>{c.link} →</a>
            </div>
          </article>
        ))
      }
    </div>
    <a class="more" href="/work/">{proof.more} →</a>
  </section>

  <section class="block" id="pricing">
    <header class="block-head">
      <p class="eyebrow">{pricing.eyebrow}</p>
      <h2>{pricing.heading}</h2>
    </header>
    <ul class="rows prices">
      {
        pricing.rows.map((r) => (
          <li class="row price-row">
            <p class="price-name">{r.name}</p>
            <p class="price-amount">{r.price}</p>
            <p class="price-body">{r.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="founding">{pricing.note}</p>
  </section>

  <section class="start" id="start">
    <h2>{contact.heading}</h2>
    <p class="start-body">{contact.body}</p>
    <a class="button big" href={mailto}>{contact.email}</a>
    <p class="start-area">{contact.area}</p>
  </section>
</Base>

<style>
  /* --- hero: the offer on the left, the week of jobs on the right --- */
  .hero {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding: 2.5rem 0 4.5rem;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
      min-height: calc(100svh - 7rem);
      padding-top: 1rem;
    }
  }
  .hero h1 {
    margin-top: 1rem;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .hero-lede {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.2rem;
    color: var(--ink-soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .button {
    display: inline-block;
    padding: 0.95rem 1.6rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    letter-spacing: 0.01em;
    background-image: none;
    transition:
      background-color 0.35s var(--ease-warm),
      color 0.35s var(--ease-warm),
      transform 0.35s var(--ease-warm);
  }
  .button:hover,
  .button:focus-visible {
    background: var(--sunflower);
    color: var(--ink);
    transform: translateY(-2px);
  }
  .button.big {
    padding: 1.15rem 2.1rem;
    font-size: 1.15rem;
  }
  .quiet {
    color: var(--ink);
  }

  /* the board: scraps of the old way, gathered into one line of work */
  .board {
    position: relative;
    width: 100%;
    max-width: 30rem;
    justify-self: center;
    aspect-ratio: 4 / 5;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--paper-deep);
    box-shadow: 10px 10px 0 -2px var(--sunflower), 10px 10px 0 0 var(--ink);
    overflow: hidden;
  }
  .board-mess {
    position: absolute;
    inset: 0;
    display: none;
  }
  .board.is-live .board-mess {
    display: block;
  }
  .chip {
    position: absolute;
    padding: 0.45rem 0.75rem;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
    background: var(--paper);
    font-family: var(--mono);
    font-size: 0.74rem;
    white-space: nowrap;
    color: var(--ink);
    box-shadow: 0 6px 14px -8px rgb(51 41 28 / 0.45);
  }
  .chip:nth-child(4),
  .chip:nth-child(8) {
    border-color: var(--rust);
    color: var(--rust);
  }
  .chip:nth-child(5) {
    background: #F2D88A;
    border-color: #C9A24A;
    font-family: var(--display);
    font-style: italic;
    font-size: 0.95rem;
  }
  .strike {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 50%;
    height: 2px;
    background: var(--rust);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .flow {
    position: absolute;
    inset: 2.25rem 2rem 5.5rem;
    list-style: none;
    padding: 0;
    display: grid;
    align-content: space-between;
  }
  .flow-line {
    position: absolute;
    left: 6px;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 2px;
    background: var(--ink);
    transform-origin: top center;
  }
  .flow-step {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-left: 2rem;
  }
  .flow-dot {
    position: absolute;
    left: 0;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-top: -7px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
  }
  .flow-step:last-child .flow-dot {
    background: var(--sunflower);
  }
  .flow-name {
    font-family: var(--display);
    font-variation-settings: 'opsz' 60, 'SOFT' 50, 'WONK' 1;
    font-weight: 600;
    font-size: clamp(1.4rem, 3vw, 1.85rem);
  }
  .flow-note {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--olive);
    text-align: right;
  }
  .stamp {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    padding: 0.5rem 0.9rem;
    border: 2px solid var(--rust);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rust);
    transform: rotate(-4deg);
  }
  .replay {
    position: absolute;
    left: 1.5rem;
    bottom: 1.6rem;
    padding: 0.2rem 0;
    border: 0;
    background: none;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .replay:hover,
  .replay:focus-visible {
    color: var(--rust);
  }

  /* --- section frame --- */
  .block {
    padding-top: 6rem;
  }
  .block-head h2 {
    margin-top: 0.4rem;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
  }

  /* problems and prices: editorial rows, never cards */
  .rows {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    border-bottom: 2px solid var(--ink);
  }
  .row {
    display: grid;
    gap: 0.5rem 3rem;
    padding: 1.6rem 0;
    border-top: 2px solid var(--ink);
  }
  @media (min-width: 760px) {
    .row {
      grid-template-columns: 1fr 1fr;
      align-items: baseline;
    }
  }
  .row-problem {
    font-family: var(--display);
    font-variation-settings: 'opsz' 48, 'SOFT' 50, 'WONK' 0;
    font-weight: 560;
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    line-height: 1.2;
  }
  .row-fix {
    position: relative;
    padding-left: 1.75rem;
    color: var(--ink-soft);
  }
  .row-fix::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--sienna);
    font-weight: 600;
  }

  /* process: four steps along one rule that fills as you read */
  .steps {
    position: relative;
    list-style: none;
    padding: 2.25rem 0 0;
    margin-top: 2.5rem;
    display: grid;
    gap: 2.25rem 2rem;
  }
  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .steps::before,
  .steps::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--ink);
  }
  .steps::after {
    height: 4px;
    top: -1px;
    background: var(--sunflower);
    transform-origin: left center;
    transform: scaleX(1);
  }
  .step-num {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--rust);
  }
  .step h3 {
    margin-top: 0.5rem;
    font-size: 1.6rem;
  }
  .step p {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  /* who */
  .who-grid {
    display: grid;
    gap: 2rem 3rem;
    margin-top: 2.5rem;
    align-items: start;
  }
  @media (min-width: 760px) {
    .who-grid {
      grid-template-columns: 15rem 1fr;
    }
  }
  .who-portrait {
    width: 100%;
    max-width: 15rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 2px solid var(--ink);
    border-radius: 6px;
    filter: sepia(0.12) saturate(0.95);
  }
  .who-body {
    font-size: 1.15rem;
  }

  /* proof */
  .cases {
    display: grid;
    gap: 4.5rem;
    margin-top: 2.75rem;
  }
  .case {
    display: grid;
    gap: 1.75rem 3rem;
    align-items: center;
  }
  @media (min-width: 860px) {
    .case {
      grid-template-columns: 1.1fr 1fr;
    }
    .case:nth-child(even) .case-shot {
      order: 2;
    }
  }
  .case-shot {
    display: block;
    border: 2px solid var(--ink);
    border-radius: 6px;
    overflow: hidden;
    background-image: none;
    box-shadow: 10px 10px 0 -2px var(--paper-deep), 10px 10px 0 0 var(--ink);
  }
  .case-shot img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.9s var(--ease-warm);
  }
  .case:hover .case-shot img {
    transform: scale(1.025);
  }
  .case-meta {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--olive);
  }
  .case h3 {
    margin-top: 0.4rem;
    font-size: clamp(1.7rem, 3.4vw, 2.3rem);
  }
  .case-body {
    margin-top: 0.9rem;
    color: var(--ink-soft);
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    margin-top: 1.5rem;
  }
  .stat dt {
    font-family: var(--display);
    font-variation-settings: 'opsz' 144, 'SOFT' 60, 'WONK' 1;
    font-weight: 600;
    font-size: clamp(1.8rem, 3.6vw, 2.4rem);
    line-height: 1;
    color: var(--ink);
  }
  .stat dd {
    margin: 0.35rem 0 0;
    max-width: 14rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }
  .case-link {
    display: inline-block;
    margin-top: 1.5rem;
  }
  .more {
    display: inline-block;
    margin-top: 3rem;
  }

  /* prices */
  @media (min-width: 760px) {
    .price-row {
      grid-template-columns: 1fr 10rem 1.4fr;
    }
  }
  .price-name {
    font-family: var(--display);
    font-variation-settings: 'opsz' 48, 'SOFT' 50, 'WONK' 0;
    font-weight: 560;
    font-size: 1.35rem;
  }
  .price-amount {
    font-family: var(--display);
    font-variation-settings: 'opsz' 144, 'SOFT' 60, 'WONK' 1;
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--rust);
  }
  .price-body {
    color: var(--ink-soft);
  }
  .founding {
    max-width: none;
    margin-top: 1.25rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  /* the close: a full-width band of deeper paper */
  .start {
    width: 100vw;
    margin: 7rem 0 -5rem calc(50% - 50vw);
    padding: 6rem 1.5rem 6.5rem;
    background: var(--paper-deep);
    border-top: 2px solid var(--ink);
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .start h2 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
  }
  .start-body {
    margin: 1.1rem 0 2.25rem;
    font-size: 1.2rem;
    color: var(--ink-soft);
  }
  .start-area {
    margin-top: 1.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  /* scroll-driven entrances, the same grammar as the index rows.
     longhands only: see the note in global.css */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .row,
      .step,
      .case,
      .who-grid {
        animation-name: rise;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
      .steps::after {
        animation-name: fill-rule;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 60% cover 45%;
      }
    }
  }
  @keyframes fill-rule {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const board = document.getElementById('board');
  const replay = document.getElementById('replay');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // without script, or with reduced motion, the board shows the finished line
  // of work and never the scraps
  if (board && replay && !reduced) {
    board.classList.add('is-live');
    const chips = Array.from(board.querySelectorAll<HTMLElement>('.chip'));
    const strikes = board.querySelectorAll('.strike');
    const line = board.querySelector('.flow-line');
    const steps = board.querySelectorAll('.flow-step');
    const stamp = board.querySelector('.stamp');

    // each scrap's pull toward the middle of the board, read at play time so a
    // resized board still gathers to its own centre
    const pull = (axis: 'x' | 'y') => (_: number, el: HTMLElement) => {
      const b = board.getBoundingClientRect();
      const c = el.getBoundingClientRect();
      return axis === 'x'
        ? b.left + b.width / 2 - (c.left + c.width / 2)
        : b.top + b.height * 0.55 - (c.top + c.height / 2);
    };

    const tl = gsap.timeline({ paused: true, defaults: { ease: 'power3.out' } });
    tl.set(chips, { x: 0, y: 0, opacity: 0, scale: 0.9, filter: 'blur(0px)', rotation: (_: number, el: HTMLElement) => Number(el.dataset.r) })
      .set(strikes, { scaleX: 0 })
      .set(line, { scaleY: 0 })
      .set(steps, { opacity: 0, y: 12 })
      .set(stamp, { opacity: 0, scale: 1.7, rotation: -16 })
      .set(replay, { opacity: 0 })
      .to(chips, { opacity: 1, scale: 1, duration: 0.6, stagger: { each: 0.1, from: 'random' } }, 0.3)
      .to(strikes, { scaleX: 1, duration: 0.45, stagger: 0.14, ease: 'power2.inOut' }, '+=0.7')
      .to(
        chips,
        { x: pull('x'), y: pull('y'), scale: 0.35, opacity: 0, filter: 'blur(3px)', duration: 0.85, stagger: 0.045, ease: 'power3.in' },
        '+=0.5',
      )
      .to(line, { scaleY: 1, duration: 1, ease: 'power2.inOut' }, '-=0.3')
      .to(steps, { opacity: 1, y: 0, duration: 0.6, stagger: 0.15 }, '<0.1')
      .to(stamp, { opacity: 1, scale: 1, rotation: -4, duration: 0.55, ease: 'back.out(2.4)' }, '+=0.1')
      .to(replay, { opacity: 1, duration: 0.4 }, '+=0.3');

    replay.hidden = false;
    replay.addEventListener('click', () => tl.restart());

    // play once the board is actually on screen; on a phone it sits below the fold
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          tl.play();
          io.disconnect();
        }
      },
      { threshold: 0.45 },
    );
    // hold the board blank until it plays, so the finished line never flashes first
    gsap.set(chips, { opacity: 0 });
    gsap.set([...steps, stamp, replay], { opacity: 0 });
    gsap.set(line, { scaleY: 0 });
    io.observe(board);
  }
</script>
