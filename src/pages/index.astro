---
import Base from '../layouts/Base.astro';
---

<Base title="Brett Boggs" description="Brett Boggs. Work, experiments, writing." home>
  <section class="film full-bleed" id="film">
    <img class="film-poster" src="/film/poster.webp" alt="" />
    <canvas class="film-canvas" id="film-canvas" aria-hidden="true"></canvas>
    <div class="film-fade" id="film-fade" aria-hidden="true"></div>

    <div class="portal" id="portal">
      <nav class="index" aria-label="Site sections">
        <a class="row" href="/work/">
          <span class="row-title">Work</span>
          <span class="row-note">case studies</span>
        </a>
        <a class="row" href="/lab/">
          <span class="row-title">Lab</span>
          <span class="row-note">experiments</span>
        </a>
        <a class="row" href="/writing/">
          <span class="row-title">Writing</span>
          <span class="row-note">notes</span>
        </a>
        <a class="row" href="mailto:brettmboggs@gmail.com">
          <span class="row-title">Contact</span>
          <span class="row-note">brettmboggs@gmail.com</span>
        </a>
      </nav>
    </div>

    <span class="scroll-line" aria-hidden="true"></span>
  </section>
</Base>

<style>
  .full-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }
  .film {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: var(--paper);
  }
  .film-poster,
  .film-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film-fade {
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: 0;
    pointer-events: none;
  }
  .portal {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
  }
  .portal .index {
    width: 100%;
    max-width: 62rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .scroll-line {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 2px;
    height: 4rem;
    background: var(--ink);
    transform-origin: top center;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.7rem 0;
    border-top: 2px solid var(--ink);
    color: var(--ink);
    background-image: none;
  }
  .row-title {
    font-family: var(--display);
    font-variation-settings: 'opsz' 90, 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
    font-size: clamp(2rem, 5.2vw, 3.4rem);
    line-height: 1.05;
    transition: translate 0.45s var(--ease-warm);
  }
  .row-note {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 0.45s var(--ease-warm);
    text-align: right;
  }
  .row:hover .row-title,
  .row:focus-visible .row-title {
    translate: 0.85rem 0;
  }
  .row:hover .row-note,
  .row:focus-visible .row-note {
    color: var(--sienna);
  }

  @media (max-width: 640px) {
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
      padding: 1.3rem 0;
    }
    .row-note {
      text-align: left;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row-title,
    .row-note {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;
  const film = document.getElementById('film')!;
  const poster = film.querySelector<HTMLImageElement>('.film-poster')!;
  const fade = document.getElementById('film-fade')!;
  const portal = document.getElementById('portal')!;
  const rows = Array.from(portal.querySelectorAll<HTMLElement>('.row'));

  // the reveal window: camera passes through the structure ~84-97% of the scrub
  const REVEAL_START = 0.84;
  const REVEAL_SPAN = 0.05;
  const ROW_STAGGER = 0.025;

  const scrollLine = film.querySelector<HTMLElement>('.scroll-line')!;

  function applyProgress(p: number): void {
    scrollLine.style.opacity = String(Math.max(0, 1 - p / 0.2));
    fade.style.opacity = String(Math.min(1, Math.max(0, (p - 0.86) / 0.1)));
    rows.forEach((row, i) => {
      const t = Math.min(1, Math.max(0, (p - (REVEAL_START + i * ROW_STAGGER)) / REVEAL_SPAN));
      const e = t * t * (3 - 2 * t);
      row.style.opacity = String(e);
      row.style.translate = `0 ${(1 - e) * 34}px`;
    });
  }

  if (reduced || saveData) {
    poster.src = '/film/poster-end.webp';
    fade.style.opacity = '0.55';
  } else {
    applyProgress(0);
    fetch('/film/manifest.json')
      .then((r) => r.json())
      .then(({ count }) => import('../scripts/filmScrub').then((m) =>
        m.initFilm({
          canvas: document.getElementById('film-canvas') as HTMLCanvasElement,
          pinTarget: film,
          frameCount: count,
          onProgress: applyProgress,
        }),
      ))
      .catch(() => {
        poster.src = '/film/poster-end.webp';
        fade.style.opacity = '0.55';
        applyProgress(1);
      });

    gsap.set('.scroll-line', { scaleY: 0 });
    gsap.to('.scroll-line', { scaleY: 1, duration: 0.9, ease: 'power2.inOut', delay: 1.0 });
  }
</script>
