---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import Base from '../layouts/Base.astro';
import copy from '../data/copy/home.json';
import { md } from '../data/copy';

const { nav, hero, problems, systems, process, about, proof, pricing, contact, footer } = copy;
const dg = hero.diagram;
const pad = (n: number): string => String(n).padStart(2, '0');

// the headline sets its last word in signal orange
const accent = hero.titleAccent;
const lead = hero.title.endsWith(accent) ? hero.title.slice(0, -accent.length).trim() : hero.title;

const total = pad(6);
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(contact.subject)}`;
const year = new Date().getFullYear();

// the as-built drawing: every connector, in the order it draws
const wires = [
  'M230 118 V 170 H 300 V 230',
  'M300 308 V 370 H 180 V 420',
  'M300 370 H 420 V 420',
  'M180 498 V 550 H 300 V 600',
  'M420 498 V 550 H 300',
];
// the routes the signal runs, start to finish
const runs = [
  'M230 118 V 170 H 300 V 370 H 180 V 550 H 300 V 640',
  'M230 118 V 170 H 300 V 370 H 420 V 550 H 300 V 640',
];
const nodes = [
  { x: 110, y: 40, w: 240, ...dg.in, tag: 'IN', hot: true },
  { x: 170, y: 230, w: 260, ...dg.core, tag: 'CORE', hot: false },
  { x: 80, y: 420, w: 200, ...dg.left, tag: '', hot: false },
  { x: 320, y: 420, w: 200, ...dg.right, tag: '', hot: false },
  { x: 170, y: 600, w: 260, ...dg.out, tag: 'OUT', hot: true },
];
---

<Base title={copy.title} description={copy.description} home theme="drawing" chrome={false} puck={false} edit="pages/home">
  <header class="bar">
    <div class="d-wrap bar-in">
      <a class="mark" href="/">
        <span class="mark-name">{nav.name}</span>
        <span class="mark-role">{nav.role}</span>
      </a>
      <nav class="bar-nav" aria-label={nav.label}>
        {nav.links.map((l) => <a href={l.url}>{l.text}</a>)}
      </nav>
      <a class="btn btn-ink bar-cta" href="#start">{nav.cta}</a>
    </div>
  </header>

  <!-- ===================================================== hero -->
  <section class="hero">
    <div class="d-wrap hero-in">
      <div class="hero-copy">
        <p class="tag rise"><i aria-hidden="true"></i>{hero.eyebrow}</p>
        <h1 class="hero-title rise" style="--d: 0.06s">
          {lead} <span>{accent}</span>
        </h1>
        <p class="dim rise" style="--d: 0.14s"><span>{hero.rule}</span></p>
        <p class="hero-lede rise" style="--d: 0.2s">{hero.lede}</p>
        <div class="hero-acts rise" style="--d: 0.26s">
          <a class="btn btn-sig" href="#start">{hero.cta} <span aria-hidden="true">→</span></a>
          <a class="btn btn-line" href={hero.secondaryUrl}>{hero.secondary}</a>
        </div>
        <dl class="tblock rise" style="--d: 0.32s">
          {
            hero.titleBlock.map((c) => (
              <div>
                <dt>{c.label}</dt>
                <dd>{c.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <figure class="drawing" id="drawing">
        <svg viewBox="0 0 560 750" role="img" aria-labelledby="fig-title">
          <title id="fig-title">{hero.figure}: {dg.in.name}, {dg.core.name}, {dg.left.name}, {dg.right.name}, {dg.out.name}.</title>
          <text class="fig" x="556" y="14" text-anchor="end">{hero.figure}</text>

          <!-- dimension line down the left edge -->
          <g class="dimline">
            <path d="M30 40 V 684 M22 40 H 38 M22 684 H 38" />
            <text x="18" y="362" transform="rotate(-90 18 362)" text-anchor="middle">{dg.dimension}</text>
          </g>

          <g class="wires">{wires.map((d) => <path d={d} pathLength="1" />)}</g>
          <g class="joints">
            <circle cx="300" cy="370" r="4" />
            <circle cx="300" cy="550" r="4" />
          </g>

          <!-- the signal runs under the boxes, so it vanishes inside each step -->
          <g class="pulses" aria-hidden="true">
            {
              runs.map((d, i) => (
                <circle r="4.5">
                  <animateMotion dur="4.8s" begin="indefinite" repeatCount="indefinite" path={d} data-offset={i * 2.4} />
                </circle>
              ))
            }
          </g>

          <g class="nodes">
            {
              nodes.map((n) => (
                <g class:list={['node', { hot: n.hot }]}>
                  <rect x={n.x} y={n.y} width={n.w} height="78" />
                  {n.tag && (
                    <g class="ntag">
                      <rect x={n.x + n.w - 40} y={n.y} width="40" height="16" />
                      <text x={n.x + n.w - 20} y={n.y + 11.5} text-anchor="middle">{n.tag}</text>
                    </g>
                  )}
                  <text class="nname" x={n.x + 16} y={n.y + 34}>{n.name}</text>
                  <text class="nnote" x={n.x + 16} y={n.y + 58}>{n.note}</text>
                </g>
              ))
            }
          </g>

          <g class="calls">
            <g class="call">
              <path d="M300 186 H 312" />
              <rect x="312" y="174" width="244" height="24" />
              <text x="322" y="190">① {dg.callA}</text>
            </g>
            <g class="call">
              <path d="M300 678 V 704" />
              <rect x="158" y="704" width="284" height="24" />
              <text x="168" y="720">② {dg.callB}</text>
            </g>
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <!-- ===================================================== 01 problems -->
  <section class="sec" id="problems">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{problems.eyebrow} / {total}</p>
        <h2>{problems.heading}</h2>
      </header>
      <div class="spec" role="table">
        <div class="spec-row spec-cols" role="row">
          <span role="columnheader">No.</span>
          <span role="columnheader">{problems.columns[0]}</span>
          <span role="columnheader">{problems.columns[1]}</span>
        </div>
        {
          problems.items.map((p, i) => (
            <div class="spec-row" role="row">
              <span class="spec-no" role="cell">{pad(i + 1)}</span>
              <p class="spec-problem" role="cell">{p.problem}</p>
              <p class="spec-fix" role="cell">{p.fix}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================================================== 02 systems -->
  <section class="sec" id="systems">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{systems.eyebrow} / {total}</p>
        <h2>{systems.heading}</h2>
      </header>
      <div class="sys-intro">
        <p class="sys-lede">{systems.lede}</p>
      </div>

      <div class="caps">
        <p class="caps-head">{systems.capsHeading}</p>
        <ol class="caps-list">
          {
            systems.caps.map((c, i) => (
              <li>
                <span class="cap-no">{pad(i + 1)}</span>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <p class="proof-label"><span>{systems.proofLabel}</span></p>
      <div class="dsheet" id="deck">
        <span class="crop tl" aria-hidden="true"></span><span class="crop tr" aria-hidden="true"></span>
        <span class="crop bl" aria-hidden="true"></span><span class="crop br" aria-hidden="true"></span>
        <div class="deck-tabs" role="tablist" aria-label={systems.tabsLabel}>
          {
            systems.tabs.map((t, i) => (
              <button
                class="deck-tab"
                type="button"
                role="tab"
                id={`deck-tab-${i}`}
                aria-controls={`deck-pane-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="deck-ref">A-{pad(i + 1)}</span>
                {t.name}
                <span class="deck-timer" aria-hidden="true" />
              </button>
            ))
          }
        </div>
        <div class="deck-panes">
          {
            systems.tabs.map((t, i) => (
              <figure class:list={['deck-pane', { 'is-on': i === 0 }]} role="tabpanel" id={`deck-pane-${i}`} aria-labelledby={`deck-tab-${i}`}>
                <img src={t.image} alt={t.alt} width="1200" height="525" loading="lazy" decoding="async" />
              </figure>
            ))
          }
        </div>
        <dl class="sheet-foot">
          {
            systems.figures.map((f) => (
              <div class="fig-cell">
                <dt>{f.number}</dt>
                <dd>{f.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ===================================================== 03 process -->
  <section class="sec" id="process">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{process.eyebrow} / {total}</p>
        <h2>{process.heading}</h2>
      </header>
      <ol class="steps">
        {
          process.steps.map((s, i) => (
            <li class="step">
              <span class="step-no">{pad(i + 1)}</span>
              <h3>{s.title}</h3>
              <span class="step-tag">{s.tag}</span>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================================================== 04 who -->
  <section class="sec" id="who">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{about.eyebrow} / {total}</p>
        <h2>{about.heading}</h2>
      </header>
      <div class="who">
        <figure class="who-photo">
          <span class="crop tl" aria-hidden="true"></span><span class="crop br" aria-hidden="true"></span>
          <img src={about.portrait} alt={about.portraitAlt} width="480" height="600" loading="lazy" decoding="async" />
        </figure>
        <div>
          <div class="who-body" set:html={md(about.body)} />
          <ol class="revs">
            {
              about.timeline.map((t, i) => (
                <li>
                  <span class="rev-no">{String.fromCharCode(65 + i)}</span>
                  <span class="rev-role">{t.role}</span>
                  <span class="rev-place">{t.place}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== 05 work -->
  <section class="sec" id="work">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{proof.eyebrow} / {total}</p>
        <h2>{proof.heading}</h2>
      </header>
      <div class="cases">
        {
          proof.items.map((c, i) => (
            <article class="case">
              <a class="case-shot" href={c.url} tabindex="-1" aria-hidden="true">
                <span class="case-label">Detail {String.fromCharCode(65 + i)} · {c.name}</span>
                <img src={c.image} alt="" width="1440" height="960" loading="lazy" decoding="async" />
              </a>
              <div class="case-text">
                <p class="case-meta">{c.meta}</p>
                <h3>{c.name}</h3>
                <p class="case-body">{c.body}</p>
                <dl class="case-stats">
                  {c.stats.map((s) => (
                    <div>
                      <dt>{s.value}</dt>
                      <dd>{s.label}</dd>
                    </div>
                  ))}
                </dl>
                <a class="arrow-link" href={c.url}>{c.link} →</a>
              </div>
            </article>
          ))
        }
      </div>
      <a class="arrow-link more" href="/work/">{proof.more} →</a>
    </div>
  </section>

  <!-- ===================================================== 06 pricing -->
  <section class="sec" id="pricing">
    <div class="d-wrap">
      <header class="sec-head">
        <p class="sec-num">{pricing.eyebrow} / {total}</p>
        <h2>{pricing.heading}</h2>
      </header>
      <div class="spec prices" role="table">
        <div class="spec-row spec-cols" role="row">
          {pricing.columns.map((c) => <span role="columnheader">{c}</span>)}
        </div>
        {
          pricing.rows.map((r) => (
            <div class:list={['spec-row', { top: r.name.startsWith('Company') }]} role="row">
              <p class="price-name" role="cell">{r.name}</p>
              <p class="price-amt" role="cell">{r.price}</p>
              <p class="price-body" role="cell">{r.body}</p>
            </div>
          ))
        }
      </div>
      <p class="founding"><i aria-hidden="true"></i>{pricing.note}</p>
    </div>
  </section>

  <!-- ===================================================== close -->
  <section class="start" id="start">
    <div class="d-wrap start-in">
      <h2>{contact.heading}</h2>
      <div class="start-side">
        <p class="start-body">{contact.body}</p>
        <a class="btn btn-sig big" href={mailto}>{contact.email} <span aria-hidden="true">→</span></a>
        <p class="start-area">{contact.area}</p>
      </div>
    </div>
  </section>

  <footer class="foot">
    <div class="d-wrap foot-in">
      <p>© {year} {nav.name}</p>
      <nav aria-label="More">{footer.links.map((l) => <a href={l.url}>{l.text}</a>)}</nav>
    </div>
  </footer>
</Base>

<style>
  /* ================================================================
     The drawing set: the homepage's own visual system. White sheet,
     engineering grid, black ink, one signal orange, blueprint blue for
     annotation. Everything else on the site keeps Golden Hour.
     ================================================================ */
  :global(html.drawing) {
    --bg: #f5f5f1;
    --sheet: #ffffff;
    --ink: #111111;
    --ink-2: #33332f;
    --soft: #64645e;
    --hair: #d6d6cf;
    --grid: #e7e7e1;
    --sig: #ff4f00;
    --sig-text: #c23800;
    --blue: #1f4fd8;
    --sans: 'Archivo Variable', 'Helvetica Neue', Arial, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    scroll-padding-top: 84px;
  }
  :global(html.drawing body) {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  :global(html.drawing body::after) {
    display: none;
  }
  :global(html.drawing ::selection) {
    background: var(--sig);
    color: #fff;
  }
  :global(html.drawing main) {
    min-height: 0;
  }
  :global(html.drawing a) {
    color: inherit;
    font-weight: inherit;
    background-image: none;
  }
  :global(html.drawing a:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .d-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  p {
    max-width: none;
  }
  h2,
  h3 {
    font-family: var(--sans);
    font-variation-settings: normal;
    text-wrap: balance;
  }

  /* --- buttons and links --- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.35rem;
    border: 1.5px solid var(--ink);
    font-family: var(--sans);
    font-weight: 650;
    font-size: 0.98rem;
    letter-spacing: 0.005em;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .btn span {
    transition: transform 0.3s var(--ease);
  }
  .btn:hover span {
    transform: translateX(4px);
  }
  .btn-sig {
    background: var(--sig);
    border-color: var(--sig);
    color: var(--ink);
  }
  .btn-sig:hover {
    box-shadow: 4px 4px 0 var(--ink);
    transform: translate(-2px, -2px);
  }
  .btn-ink {
    background: var(--ink);
    color: #fff;
  }
  .btn-ink:hover {
    background: var(--sig);
    border-color: var(--sig);
  }
  .btn-line {
    background: var(--bg);
  }
  .btn-line:hover {
    background: var(--ink);
    color: #fff;
  }
  .btn.big {
    padding: 1.2rem 1.6rem;
    font-size: 1.1rem;
  }
  .arrow-link {
    display: inline-block;
    font-weight: 650;
    border-bottom: 1.5px solid var(--sig);
    padding-bottom: 2px;
    transition: color 0.25s var(--ease);
  }
  .arrow-link:hover {
    color: var(--sig-text);
  }

  /* --- top bar --- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1px solid var(--ink);
  }
  .bar-in {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 68px;
  }
  .mark {
    display: grid;
    line-height: 1;
    gap: 4px;
  }
  .mark-name {
    font-weight: 800;
    font-stretch: 72%;
    font-size: 1.35rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .mark-name::after {
    content: '.';
    color: var(--sig);
  }
  .mark-role {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .bar-nav {
    display: flex;
    gap: 2rem;
    margin-left: auto;
  }
  .bar-nav a {
    font-size: 0.92rem;
    font-weight: 550;
    position: relative;
  }
  .bar-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--sig);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .bar-nav a:hover::after {
    transform: scaleX(1);
  }
  .bar-cta {
    padding: 0.7rem 1rem;
    font-size: 0.88rem;
  }
  @media (max-width: 900px) {
    .bar-nav {
      display: none;
    }
    .bar-cta {
      margin-left: auto;
    }
  }

  /* --- hero --- */
  .hero {
    position: relative;
    border-bottom: 1px solid var(--ink);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
  }
  .hero-in {
    display: grid;
    gap: 3rem;
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }
  @media (min-width: 1000px) {
    .hero-in {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      gap: 0;
      min-height: calc(100svh - 69px);
      align-items: stretch;
    }
    .hero-copy {
      padding-right: clamp(32px, 4vw, 64px);
      border-right: 1px solid var(--ink);
    }
    .drawing {
      padding-left: clamp(24px, 3vw, 48px);
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .tag {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .tag i {
    flex: none;
    width: 9px;
    height: 9px;
    background: var(--sig);
  }
  .hero-title {
    margin-top: 1.5rem;
    font-family: var(--sans);
    font-variation-settings: normal;
    font-weight: 820;
    font-stretch: 68%;
    font-size: clamp(3.6rem, 8vw, 7.2rem);
    line-height: 0.86;
    letter-spacing: -0.012em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .hero-title span {
    color: var(--sig);
  }
  .dim {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.6rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .dim::before,
  .dim::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--blue);
  }
  .dim::before {
    max-width: 2.5rem;
  }
  .hero-lede {
    margin-top: 1.6rem;
    max-width: 33rem;
    font-size: clamp(1.08rem, 1.5vw, 1.22rem);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .hero-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .tblock {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--ink);
    background: var(--sheet);
    font-family: var(--mono);
  }
  .tblock div {
    padding: 0.55rem 0.7rem;
    border-right: 1px solid var(--ink);
    min-width: 0;
  }
  .tblock div:last-child {
    border-right: 0;
  }
  .tblock dt {
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .tblock dd {
    margin: 0.15rem 0 0;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 560px) {
    .tblock {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tblock div:nth-child(2) {
      border-right: 0;
    }
    .tblock div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--ink);
    }
  }

  /* --- the as-built drawing --- */
  .drawing {
    display: flex;
    align-items: center;
