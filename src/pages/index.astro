  /* --- contact --- */
  .start {
    background: var(--sheet);
    border-radius: 28px 28px 0 0;
  }
  .start-in {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 980px) {
    .start-in {
      grid-template-columns: 1fr 1fr;
