---
import Base from '../../layouts/Base.astro';
import copy from '../../data/copy/ladle.json';
import { md, inline } from '../../data/copy';

// The recipe app's page: the App Store support and marketing URL, and what
// the app links to from Settings. Indexed, because this is the one that has
// to be findable.
---

<Base
  title={copy.title}
  description={copy.description}
  puck={false}
  edit="ladle/ladle"
>
  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  <section class="body">
    <Fragment set:html={md(copy.intro)} />

    {copy.sections.map((s) => (
      <>
        <h2>{s.heading}</h2>
        <Fragment set:html={md(s.body)} />
      </>
    ))}

    <p class="fine" set:html={inline(copy.fine)} />

    <ul class="links">
      {copy.links.map((l) => (
        <li><a href={l.url}>{l.text}</a></li>
      ))}
    </ul>
  </section>

  <a class="back-link" href="/">{copy.backLink}</a>
</Base>

<style>
  .body {
    max-width: 38rem;
    margin: 2rem 0 3rem;
  }
  .body p {
    margin: 0 0 1rem;
  }
  .body h2 {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.05rem;
  }
  .fine {
    margin-top: 2.5rem;
    font-size: 0.95rem;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    gap: 1.5rem;
  }
</style>
