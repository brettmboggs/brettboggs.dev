---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import copy from '../../data/copy/writing.json';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title={copy.title} description={copy.description} edit="pages/writing">
  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </header>
  {posts.length === 0 && <p class="empty-note">{copy.empty}</p>}
  <ul class="entry-list">
    {
      posts.map((p) => (
        <li>
          <a class="entry-row" href={`/writing/${p.id}/`}>
            <span>
              <span class="entry-title">{p.data.title}</span>
              <span class="entry-desc">{p.data.description}</span>
            </span>
            <time class="entry-meta" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
