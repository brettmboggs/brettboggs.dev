---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Ask from '../../components/Ask.astro';
import copy from '../../data/copy/writing.json';
import { SITE, PERSON, breadcrumb } from '../../data/schema';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = `${SITE}/writing/${post.id}/`;
const fmt = (date: Date) => date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const graph = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    headline: d.title,
    description: d.description,
    url,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    author: PERSON,
    publisher: PERSON,
    image: `${SITE}/og/writing-${post.id}.png`,
    inLanguage: 'en',
  },
  breadcrumb(url, [
    { name: 'Brett Boggs', url: `${SITE}/` },
    { name: copy.eyebrow, url: `${SITE}/writing/` },
    { name: d.title, url },
  ]),
];
---

<Base
  title={`${d.title} · Brett Boggs`}
  description={d.description}
  edit={`writing/${post.id}`}
  graph={graph}
  article={{ published: d.date, modified: d.updated }}
  ogImage={`/og/writing-${post.id}.png`}
>
  <article>
    <header class="page-head">
      <p class="eyebrow">{copy.byline} · <time datetime={d.date.toISOString()}>{fmt(d.date)}</time></p>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <Ask />
    <a class="back-link" href="/writing/">{copy.backLink}</a>
  </article>
</Base>
