---
import Base from '../layouts/Base.astro';
import copy from '../data/copy/about.json';
import { md } from '../data/copy';
---

<Base title={copy.title} description={copy.description} scene="about" edit="pages/about">
  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  <div class="opener">
    <div class="prose opener-copy" set:html={md(copy.opener)} />
    <figure class="portrait">
      <span class="portrait-plate">
        <img src={copy.portrait.image} alt={copy.portrait.alt} width="880" height="1121" loading="eager" />
      </span>
      <figcaption>{copy.portrait.caption}</figcaption>
    </figure>
  </div>

  <div class="prose" set:html={md(copy.body)} />

  <section class="reach">
    <p class="reach-head">{copy.reachHeading}</p>
    <ul>
      {copy.reach.map((r) => (
        <li>
          <span class="reach-label">{r.label}</span>
          <a href={r.url} rel={r.url.startsWith('http') ? 'noopener' : undefined}>{r.text}</a>
        </li>
      ))}
    </ul>
  </section>

  <a class="back-link" href="/">{copy.backLink}</a>
</Base>

<style>
  /* magazine-profile opener: copy left, printed plate right */
  .opener {
    display: grid;
    grid-template-columns: minmax(18rem, 3fr) minmax(14rem, 2fr);
    gap: 2.8rem;
    align-items: start;
    margin-top: 2.5rem;
  }
  .opener-copy {
    margin-top: 0;
  }

  /* the portrait in real color, mounted like a print: a warm mat cut from
     the site's own paper, flat, no shadows, the same rule-and-mono language
     as every figure on the site. */
  .portrait {
    margin: 0;
  }
  .portrait-plate {
    display: block;
    padding: 0.7rem;
    background: var(--paper-deep);
    border-top: 2px solid var(--ink);
  }
  .portrait img {
    display: block;
    width: 100%;
    height: auto;
  }
  .portrait figcaption {
    margin-top: 0.8rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  @media (max-width: 720px) {
    .opener {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait {
      max-width: 19rem;
      order: -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait img {
      transition: none;
    }
  }
  .reach {
    margin-top: 4rem;
    padding-top: 1.6rem;
    border-top: 2px solid var(--ink);
    max-width: var(--measure);
  }
  .reach-head {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .reach ul {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .reach li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .reach-label {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
