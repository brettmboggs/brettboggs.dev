---
import Base from '../layouts/Base.astro';
import copy from '../data/copy/about.json';
import { md } from '../data/copy';
import { SITE, PERSON, breadcrumb } from '../data/schema';

const url = `${SITE}/about/`;
// the page Google and the answer engines should treat as the profile of the
// Person the homepage declares
const graph = [
  {
    '@type': 'ProfilePage',
    '@id': `${url}#page`,
    url,
    name: copy.title,
    mainEntity: { ...PERSON, image: `${SITE}${copy.portrait.image}` },
  },
  breadcrumb(url, [
    { name: 'Home', url: `${SITE}/` },
    { name: 'About', url },
  ]),
];
---

<Base title={copy.title} description={copy.description} scene="about" edit="pages/about" graph={graph}>
  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  <div class="opener">
    <div class="opener-main">
      <div class="prose opener-copy" set:html={md(copy.opener)} />
      <div class="prose" set:html={md(copy.body)} />

      <section class="reach">
        <p class="reach-head">{copy.reachHeading}</p>
        <ul>
          {copy.reach.map((r) => (
            <li>
              <span class="reach-label">{r.label}</span>
              <a href={r.url} rel={r.url.startsWith('http') ? 'noopener' : undefined}>{r.text}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>
    <figure class="portrait">
      <span class="portrait-plate">
        <img src={copy.portrait.image} alt={copy.portrait.alt} width="720" height="900" loading="eager" fetchpriority="high" />
      </span>
      <figcaption>{copy.portrait.caption}</figcaption>
    </figure>
  </div>

  <a class="back-link" href="/">{copy.backLink}</a>
</Base>

<style>
  /* magazine-profile opener: copy left, printed plate right */
  .opener {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 22rem);
    gap: clamp(2.8rem, 6vw, 6rem);
    align-items: start;
    margin-top: 2.5rem;
  }
  .opener-copy {
    margin-top: 0;
  }

  /* the portrait in real color, mounted like a plate on the drawing set:
     a white mat inside an ink frame, flat, no shadows. */
  .portrait {
    position: sticky;
    top: 100px;
    margin: 2.5rem 0 0;
  }
  .portrait-plate {
    display: block;
    padding: 10px;
    background: var(--sheet);
    border: 1.5px solid var(--ink);
  }
  .portrait img {
    display: block;
    width: 100%;
    height: auto;
  }
  .portrait figcaption {
    margin-top: 0.8rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  @media (max-width: 720px) {
    .opener {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait {
      position: static;
      max-width: 19rem;
      margin-top: 0;
      order: -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait img {
      transition: none;
    }
  }
  .reach {
    margin-top: 4rem;
    padding-top: 1.6rem;
    border-top: 2px solid var(--ink);
    max-width: var(--measure);
  }
  .reach-head {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .reach ul {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .reach li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .reach-label {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
