---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft && !data.bespoke);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<Base title={`${entry.data.title} · Brett Boggs`} description={entry.data.description}>
  <article>
    <header class="page-head">
      <p class="eyebrow">Work · {fmt(entry.data.date)}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <a class="back-link" href="/work/">&larr; All work</a>
  </article>
</Base>
