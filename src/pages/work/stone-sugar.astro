---
import Base from '../../layouts/Base.astro';

const stages = [
  { src: 'f01', alt: 'The Big Top marquee for Circus Flora against a bright sky.' },
  { src: 'f02', alt: 'A club stage washed in blue and green beams over a silhouetted crowd.' },
  { src: 'f03', alt: 'A quonset stage lit deep pink at night, a fire performer out front.' },
  { src: 'f04', alt: 'A guitarist under teal light, head down over the neck.' },
  { src: 'f05', alt: 'A guitarist lit hard teal and green, mid phrase.' },
  { src: 'f06', alt: 'Two players in warm smoke, one in a cowboy hat.' },
  { src: 'f07', alt: 'A bassist in a tie dye shirt under red stage light.' },
  { src: 'f08', alt: 'An outdoor stage set under a steel bridge in daylight.' },
  { src: 'f09', alt: 'A fire dancer working in front of a festival banner.' },
];
const studio = [
  { src: 's01', alt: 'A large analogue mixing console raking away in shallow focus.' },
  { src: 's02', alt: 'A red condenser microphone in a shock mount, warm light behind.' },
  { src: 's03', alt: 'Warm light across the strings and frame of an open piano.' },
];
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<Base
  title="Stone Sugar · Brett Boggs"
  description="Two years with a band. Festivals, bar stages, and a studio session."
>
  <article>
    <header class="page-head">
      <p class="eyebrow">Work · 2021 to 2022</p>
      <h1>Stone Sugar</h1>
      <p class="lede">Two years with a band. Festivals, bar stages, and a studio session.</p>
    </header>

    <figure class="bleed">
      <img src="/work/stone-sugar/hero.webp" alt="The band standing in a field by the water, black and white." width="2400" height="1600" loading="eager" />
    </figure>

    <div class="prose">
      <p>
        Stone Sugar plays festivals, bar stages, and the occasional open field. Two years of shows,
        plus a session at Sawhorse Studio.
      </p>
      <p>
        Almost all of it is available light, which on a stage means whatever the wash happens to be
        doing that second. You learn the rig, then you wait.
      </p>
    </div>

    <figure class="select">
      <img src="/work/stone-sugar/lights.webp" alt="A drummer silhouetted against red and green light bars." width="1920" height="1280" loading="lazy" />
    </figure>

    <section class="sheet-block">
      <p class="sheet-label">Stages · 2021 to 2022</p>
      <div class="sheet">
        {stages.map((f, i) => (
          <figure>
            <img src={`/work/stone-sugar/${f.src}.webp`} alt={f.alt} width="900" height="600" loading="lazy" />
            <figcaption>{pad(i)}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <figure class="select">
      <img src="/work/stone-sugar/case.webp" alt="A sticker covered hard case propped against an amplifier." width="1920" height="1280" loading="lazy" />
    </figure>

    <section class="sheet-block">
      <p class="sheet-label">Sawhorse Studio · May 2022</p>
      <div class="sheet">
        {studio.map((f, i) => (
          <figure>
            <img src={`/work/stone-sugar/${f.src}.webp`} alt={f.alt} width="900" height="600" loading="lazy" />
            <figcaption>{pad(i)}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <a class="back-link" href="/work/">All work</a>
  </article>
</Base>

<style>
  .bleed {
    width: 100vw;
    margin: 3rem 0 0 calc(50% - 50vw);
  }
  .bleed img {
    display: block;
    width: 100%;
    height: auto;
  }
  .select {
    margin: 3rem 0 0;
  }
  .select img {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--ink);
  }

  /* a proof sheet, not a gallery: frames butt together and the ink shows
     through as the rebate, with the frame number printed on it */
  .sheet-block {
    margin-top: 3rem;
  }
  .sheet-label {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }
  .sheet {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    padding: 2px;
    background: var(--ink);
    border: 2px solid var(--ink);
  }
  .sheet figure {
    margin: 0;
    display: grid;
  }
  .sheet img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sheet figcaption {
    padding: 0.3rem 0.4rem 0.35rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--paper-deep);
    opacity: 0.7;
  }
  @media (max-width: 640px) {
    .sheet {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
