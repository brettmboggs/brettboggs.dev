---
import Base from '../../../layouts/Base.astro';
import data from '../../../data/eclipse.json';

const A = '/photo/eclipse';

// how the shadow reads at each stage, so the alt text says something true
const phase = (i: number, n: number) =>
  i === 0
    ? 'full and white, before the shadow'
    : i < n * 0.3
      ? 'a bite taken out of one limb'
      : i < n * 0.55
        ? 'the shadow across half the disc'
        : i < n * 0.8
          ? 'most of the disc copper, a bright rind left'
          : 'nearly all copper, a thin sunlit edge at the top';

const stages = data.stages.map((s, i) => ({
  ...s,
  alt: `The moon at ${s.time}, ${phase(i, data.stages.length)}.`,
}));
---

<Base
  title="The Copper Hour · Brett Boggs"
  description="The moon going into the earth's shadow on 27 August 2026, and two aeroplanes that crossed it."
  ogImage="/photo/eclipse/plane-transit-760.webp"
  article={{ published: new Date('2026-08-27') }}
>
  <article>
    <header class="page-head">
      <p class="eyebrow">Photography · 27 August 2026</p>
      <h1>The Copper Hour</h1>
      <p class="lede">
        The moon going into the earth's shadow, and two aeroplanes that crossed it on the way.
      </p>
    </header>

    <figure
      class="plate night-bleed hero-plate"
      data-plate
      data-full={`${A}/plane-transit-1536.webp`}
      data-w="1536"
      data-h="1536"
      data-title="22:42:06"
      data-meta="An airliner across the bright edge"
      tabindex="0"
      role="button"
      aria-label="Open the airliner transit at full size"
    >
      <img
        src={`${A}/plane-transit-760.webp`}
        srcset={`${A}/plane-transit-760.webp 760w, ${A}/plane-transit-1536.webp 1536w`}
        sizes="(min-width: 52rem) 46rem, 100vw"
        alt="An airliner in silhouette against the bright edge of a partly eclipsed copper moon, its navigation lights showing as red and white dashes above."
        width="1536"
        height="1536"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>
        <span class="cap-time">22:42:06</span>
        <span>
          An airliner crossing the bright edge. The wings and tail come through as a black outline
          against the last of the direct sun, and its navigation lights sit just above, red on one
          side and white on the other.
        </span>
      </figcaption>
    </figure>

    <section class="band night-bleed arc-band" aria-labelledby="arc-h">
      <div class="band-head wrap">
        <h2 id="arc-h">The arc</h2>
        <div
          class="arc-toggle"
          role="group"
          aria-label="Arc brightness"
        >
          <button type="button" data-arc="even" class="is-on">Evened out</button>
          <button type="button" data-arc="true">As it looked</button>
        </div>
      </div>

      <figure
        class="arc"
        id="arc-plate"
        data-plate
        data-full={`${A}/arc-even-6000.webp`}
        data-w="6000"
        data-h="983"
        data-title="The arc, evened out"
        data-meta="21:40 to 23:10"
        tabindex="0"
        role="button"
        aria-label="Open the progression arc at full size"
      >
        <div class="arc-scroll">
          <img
            id="arc-img"
            src={`${A}/arc-even-2400.webp`}
            srcset={`${A}/arc-even-1200.webp 1200w, ${A}/arc-even-2400.webp 2400w, ${A}/arc-even-6000.webp 6000w`}
            sizes="2320px"
            alt="Twenty one moons in a shallow arc, running from a full white moon on the left through a shadow crossing the disc to a deep copper moon on the right."
            width="6000"
            height="983"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="wrap arc-cap">
          <span class="cap-time">21:40 to 23:10</span>
          <span class="arc-caption-even">
            Twenty one moons in a row, left to right. It starts full and white, the shadow comes in
            from the lower left, and by the right hand end the disc is copper with only a thin
            bright edge left along the top. Drag it sideways.
          </span>
          <span class="arc-caption-true" hidden>
            The same twenty one moons with the brightness left where it was. The white moon at the
            start is the brightest thing in the row by a long way, and the copper ones at the end
            really are that dark.
          </span>
        </figcaption>
      </figure>
    </section>

    <section class="band night-bleed sheet-band" aria-labelledby="sheet-h">
      <div class="band-head wrap">
        <h2 id="sheet-h">Twenty one moons</h2>
        <p class="band-hint">Every stage on its own. Click any of them.</p>
      </div>
      <div class="wrap">
        <ol class="sheet">
          {
            stages.map((s, i) => (
              <li>
                <figure
                  class="moon"
                  data-plate
                  data-full={`${A}/stage/${s.slug}-1360.webp`}
                  data-w="1360"
                  data-h="1360"
                  data-title={s.time}
                  data-meta={`Stage ${i + 1} of 21`}
                  tabindex="0"
                  role="button"
                  aria-label={`Open the ${s.time} stage at full size`}
                >
                  <img
                    src={`${A}/stage/${s.slug}-560.webp`}
                    srcset={`${A}/stage/${s.slug}-560.webp 560w, ${A}/stage/${s.slug}-1360.webp 1360w`}
                    sizes="(min-width: 900px) 11rem, 45vw"
                    alt={s.alt}
                    width="560"
                    height="560"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    <b>{s.time}</b>
                    <span class="moon-n">{String(i + 1).padStart(2, '0')} / 21</span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <figure
      class="plate"
      data-plate
      data-full={`${A}/ring-2040.webp`}
      data-w="2040"
      data-h="2040"
      data-title="22:44"
      data-meta="The bright rim and the shadowed disc"
      tabindex="0"
      role="button"
      aria-label="Open the eclipse ring at full size"
    >
      <img
        src={`${A}/ring-1020.webp`}
        srcset={`${A}/ring-1020.webp 1020w, ${A}/ring-2040.webp 2040w`}
        sizes="(min-width: 52rem) 48rem, 100vw"
        alt="The partly eclipsed moon with a brilliant white and gold rim along the upper right edge and the rest of the disc a dim copper, with maria visible through the shadow."
        width="2040"
        height="2040"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <span class="cap-time">22:44</span>
        <span>
          A white and gold rim along the top right edge, and the rest of the moon a dim copper. The
          dark maria still show through the shadowed part.
        </span>
      </figcaption>
    </figure>

    <div class="pair">
      <figure
        class="plate"
        data-plate
        data-full={`${A}/plane-track-a-3200.webp`}
        data-w="3200"
        data-h="3200"
        data-title="22:42"
        data-meta="The pass that went across"
        tabindex="0"
        role="button"
        aria-label="Open the 22:42 aircraft track at full size"
      >
        <img
          src={`${A}/plane-track-a-1200.webp`}
          srcset={`${A}/plane-track-a-1200.webp 1200w, ${A}/plane-track-a-2400.webp 2400w`}
          sizes="(min-width: 760px) 24rem, 100vw"
          alt="A copper eclipsed moon with a diagonal trail of red and white aircraft navigation lights running up across it from lower left to upper right."
          width="1200"
          height="1200"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span class="cap-time">22:42</span>
          <span>
            The same aircraft as the first picture, with its lights laid out across the whole pass.
            It comes in from the lower left and goes straight over the top of the moon.
          </span>
        </figcaption>
      </figure>

      <figure
        class="plate"
        data-plate
        data-full={`${A}/plane-track-b-3200.webp`}
        data-w="3200"
        data-h="3200"
        data-title="22:36"
        data-meta="The pass that missed"
        tabindex="0"
        role="button"
        aria-label="Open the 22:36 aircraft track at full size"
      >
        <img
          src={`${A}/plane-track-b-1200.webp`}
          srcset={`${A}/plane-track-b-1200.webp 1200w, ${A}/plane-track-b-2400.webp 2400w`}
          sizes="(min-width: 760px) 24rem, 100vw"
          alt="The same eclipsed moon lower in the frame, with a line of coloured navigation lights arcing above and to the left of it."
          width="1200"
          height="1200"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span class="cap-time">22:36</span>
          <span>
            An earlier one, six minutes before, that went over the top left and never touched the
            moon. Its lights arc away to the upper right.
          </span>
        </figcaption>
      </figure>
    </div>

    <p class="credit">Canon EOS R6, RF 70-200mm f/2.8. 27 August 2026.</p>

    <a class="back-link" href="/work/photography/">All photography</a>
  </article>
</Base>

<script>
  import { mountEclipseGallery } from '../../../scripts/eclipseGallery';

  mountEclipseGallery();

  // the arc has two cuts of the same picture: evened out, and left alone
  const arcPlate = document.getElementById('arc-plate');
  const arcImg = document.getElementById('arc-img') as HTMLImageElement | null;
  const toggle = document.querySelector('.arc-toggle') as HTMLElement | null;

  if (arcPlate && arcImg && toggle) {
    const copy = {
      even: document.querySelector('.arc-caption-even') as HTMLElement,
      true: document.querySelector('.arc-caption-true') as HTMLElement,
    };
    toggle.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest('button');
      if (!btn) return;
      const key = btn.dataset.arc === 'true' ? 'true' : 'even';
      toggle.querySelectorAll('button').forEach((b) => b.classList.toggle('is-on', b === btn));
      arcImg.srcset = `/photo/eclipse/arc-${key}-1200.webp 1200w, /photo/eclipse/arc-${key}-2400.webp 2400w, /photo/eclipse/arc-${key}-6000.webp 6000w`;
      arcImg.src = `/photo/eclipse/arc-${key}-2400.webp`;
      arcPlate.dataset.full = `/photo/eclipse/arc-${key}-6000.webp`;
      arcPlate.dataset.title = key === 'true' ? 'The arc, as it looked' : 'The arc, evened out';
      copy.even.hidden = key === 'true';
      copy.true.hidden = key !== 'true';
    });
  }
</script>

<style is:global>
  /* the viewer lives on the body, so its rules cannot be scoped to the page */
  html.ec-locked,
  html.ec-locked body {
    overflow: hidden;
  }

  .ec-viewer {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #0b0805;
    opacity: 0;
    transition: opacity 0.3s var(--ease-warm);
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  /* [hidden] has to beat the display above, or the shell sits over the page */
  .ec-viewer[hidden] {
    display: none;
  }
  .ec-viewer.is-on {
    opacity: 1;
  }
  .ec-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    touch-action: none;
    cursor: zoom-in;
  }
  .ec-stage.is-zoomed {
    cursor: grab;
  }
  .ec-stage.is-zoomed:active {
    cursor: grabbing;
  }
  .ec-img {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    max-width: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .ec-bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(11, 8, 5, 0.85), rgba(11, 8, 5, 0));
  }
  .ec-bar-bottom {
    align-self: end;
    background: linear-gradient(to top, rgba(11, 8, 5, 0.85), rgba(11, 8, 5, 0));
  }
  .ec-bar > * {
    pointer-events: auto;
  }
  .ec-label {
    margin: 0;
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.9rem;
  }
  .ec-title {
    font-family: var(--display);
    font-variation-settings: 'opsz' 60, 'SOFT' 40, 'WONK' 0;
    font-size: 1.15rem;
    color: #f4eddf;
  }
  .ec-meta,
  .ec-hint {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.09em;
    color: #b09a78;
    margin: 0;
  }
  .ec-tools {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .ec-btn {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: #f4eddf;
    background: rgba(244, 237, 223, 0.06);
    border: 1px solid rgba(244, 237, 223, 0.28);
    border-radius: 0;
    padding: 0.34rem 0.72rem;
    min-width: 2.4rem;
    cursor: pointer;
    background-image: none;
    font-weight: 400;
    transition:
      background 0.25s var(--ease-warm),
      border-color 0.25s var(--ease-warm);
  }
  .ec-btn:hover,
  .ec-btn:focus-visible {
    background: rgba(244, 237, 223, 0.16);
    border-color: #f4eddf;
  }
  .ec-zoom {
    min-width: 4rem;
  }
  .ec-loading {
    position: absolute;
    left: 50%;
    bottom: 4.6rem;
    transform: translateX(-50%);
    margin: 0;
    z-index: 3;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b09a78;
    pointer-events: none;
  }

  @media (max-width: 620px) {
    /* tools on their own row, title underneath and clipped rather than stacked letter by letter */
    .ec-bar-top {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 0.55rem;
      padding: 0.7rem 0.8rem;
    }
    .ec-tools {
      justify-content: flex-end;
      flex-wrap: wrap;
    }
    .ec-label {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ec-title {
      font-size: 0.95rem;
    }
    .ec-meta {
      display: none;
    }
    .ec-btn {
      padding: 0.3rem 0.6rem;
      min-width: 2.1rem;
    }
  }
</style>

<style>
  /* --- night ground: the photographs bring their own weather --- */
  .night-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: #100c08;
    color: #f4eddf;
  }

  .plate {
    margin: 3rem 0 0;
    cursor: zoom-in;
  }
  .plate:focus-visible {
    outline: 2px solid var(--sunflower);
    outline-offset: 4px;
  }
  .plate img {
    display: block;
    width: 100%;
    height: auto;
    background: #100c08;
  }
  .plate:not(.night-bleed) img {
    border: 2px solid var(--ink);
  }
  .plate figcaption,
  .band-hint,
  .credit {
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.55;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
  }
  .plate figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-top: 0.7rem;
    max-width: 58ch;
  }
  .cap-time {
    color: var(--sienna);
    letter-spacing: 0.14em;
    flex-shrink: 0;
  }

  .hero-plate {
    margin-top: 2.6rem;
    padding: 0 0 1.4rem;
  }
  .hero-plate img {
    /* the plate is square, so capping the width caps the height with it */
    max-width: min(46rem, 74vh);
    margin: 0 auto;
  }
  .hero-plate figcaption {
    max-width: 46rem;
    margin: 1rem auto 0;
    padding: 0 1.5rem;
    color: #b09a78;
  }
  .hero-plate .cap-time {
    color: var(--sunflower);
  }

  /* --- bands --- */
  .band {
    margin-top: 4.5rem;
    padding: 3.2rem 0 3.4rem;
  }
  .band-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem 1.5rem;
    padding-bottom: 1.2rem;
  }
  .band-head h2 {
    margin: 0;
    color: #f4eddf;
  }
  .band-hint {
    margin: 0;
    color: #b09a78;
  }

  /* --- the arc --- */
  .arc-toggle {
    display: flex;
    gap: 0.4rem;
  }
  .arc-toggle button {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    color: #f4eddf;
    background: transparent;
    border: 1px solid rgba(244, 237, 223, 0.3);
    border-radius: 0;
    padding: 0.32rem 0.7rem;
    cursor: pointer;
    transition:
      background 0.25s var(--ease-warm),
      border-color 0.25s var(--ease-warm);
  }
  .arc-toggle button:hover {
    border-color: #f4eddf;
  }
  .arc-toggle button.is-on {
    background: var(--sunflower);
    border-color: var(--sunflower);
    color: #100c08;
  }

  .arc {
    margin: 0;
    cursor: zoom-in;
  }
  .arc:focus-visible {
    outline: 2px solid var(--sunflower);
    outline-offset: -2px;
  }
  .arc-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgba(244, 237, 223, 0.3) transparent;
  }
  .arc-scroll img {
    display: block;
    height: clamp(190px, 34vw, 380px);
    width: auto;
    max-width: none;
  }
  .arc-cap {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }
  .arc-cap span {
    max-width: 64ch;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: #b09a78;
  }
  .arc .cap-time {
    color: var(--sunflower);
  }

  /* --- contact sheet --- */
  .sheet {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    gap: 1.1rem 0.9rem;
  }
  .moon {
    margin: 0;
    cursor: zoom-in;
    transition: transform 0.4s var(--ease-warm);
  }
  .moon:hover,
  .moon:focus-visible {
    transform: translateY(-4px);
    outline: none;
  }
  .moon:focus-visible img {
    outline: 2px solid var(--sunflower);
    outline-offset: 2px;
  }
  .moon img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(244, 237, 223, 0.14);
  }
  .moon:hover img {
    border-color: rgba(244, 237, 223, 0.4);
  }
  .moon figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.45rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: #8d7a5e;
  }
  .moon figcaption b {
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--sunflower);
  }
  .moon-n {
    color: #5f523f;
  }

  /* --- pair --- */
  .pair {
    display: grid;
    gap: 2rem;
    margin-top: 1rem;
  }
  .pair .plate {
    margin-top: 2rem;
  }

  .credit {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 2px solid var(--ink);
  }

  @media (min-width: 760px) {
    .pair {
      grid-template-columns: 1fr 1fr;
      gap: 1.4rem;
    }
    .pair .plate figcaption {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moon {
      transition: none;
    }
  }
</style>
