---
import Base from '../../../layouts/Base.astro';
import Viewer from '../../../components/Viewer.astro';
import data from '../../../data/eclipse.json';
import copy from '../../../data/copy/work-photography-eclipse.json';

const A = '/photo/eclipse';

// how the shadow reads at each stage, so the alt text says something true
const ph = copy.stages.phases;
const phase = (i: number, n: number) =>
  i === 0
    ? ph.full
    : i < n * 0.3
      ? ph.bite
      : i < n * 0.55
        ? ph.half
        : i < n * 0.8
          ? ph.most
          : ph.nearly;

const stages = data.stages.map((s, i) => ({
  ...s,
  alt: `The moon at ${s.time}, ${phase(i, data.stages.length)}.`,
}));
---

<Base
  title={copy.title}
  description={copy.description}
  ogImage="/photo/eclipse/plane-transit-760.webp"
  article={{ published: new Date('2026-08-27') }}
  edit="work-pages/work-photography-eclipse"
>
  <article>
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <figure
      class="plate night-bleed hero-plate"
      data-plate
      data-full={`${A}/plane-transit-1536.webp`}
      data-w="1536"
      data-h="1536"
      data-title={copy.transit.time}
      data-meta={copy.transit.viewerNote}
      tabindex="0"
      role="button"
      aria-label={copy.transit.openLabel}
    >
      <img
        src={`${A}/plane-transit-760.webp`}
        srcset={`${A}/plane-transit-760.webp 760w, ${A}/plane-transit-1536.webp 1536w`}
        sizes="(min-width: 52rem) 46rem, 100vw"
        alt={copy.transit.alt}
        width="1536"
        height="1536"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>
        <span class="cap-time">{copy.transit.time}</span>
        <span>{copy.transit.caption}</span>
      </figcaption>
    </figure>

    <section class="band night-bleed arc-band" aria-labelledby="arc-h">
      <div class="band-head wrap">
        <h2 id="arc-h">{copy.arc.heading}</h2>
        <div
          class="arc-toggle"
          role="group"
          aria-label={copy.arc.toggleLabel}
        >
          <button type="button" data-arc="even" class="is-on">{copy.arc.evenButton}</button>
          <button type="button" data-arc="true">{copy.arc.trueButton}</button>
        </div>
      </div>

      <figure
        class="arc"
        id="arc-plate"
        data-plate
        data-full={`${A}/arc-even-6000.webp`}
        data-w="6000"
        data-h="983"
        data-title={copy.arc.evenTitle}
        data-meta={copy.arc.time}
        tabindex="0"
        role="button"
        aria-label={copy.arc.openLabel}
      >
        <div class="arc-scroll">
          <img
            id="arc-img"
            src={`${A}/arc-even-2400.webp`}
            srcset={`${A}/arc-even-1200.webp 1200w, ${A}/arc-even-2400.webp 2400w, ${A}/arc-even-6000.webp 6000w`}
            sizes="2320px"
            alt={copy.arc.alt}
            width="6000"
            height="983"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="wrap arc-cap">
          <span class="cap-time">{copy.arc.time}</span>
          <span class="arc-caption-even">{copy.arc.evenCaption}</span>
          <span class="arc-caption-true" hidden>{copy.arc.trueCaption}</span>
        </figcaption>
      </figure>
    </section>

    <section class="band night-bleed sheet-band" aria-labelledby="sheet-h">
      <div class="band-head wrap">
        <h2 id="sheet-h">{copy.stages.heading}</h2>
        <p class="band-hint">{copy.stages.hint}</p>
      </div>
      <div class="wrap">
        <ol class="sheet">
          {
            stages.map((s, i) => (
              <li>
                <figure
                  class="moon"
                  data-plate
                  data-full={`${A}/stage/${s.slug}-1360.webp`}
                  data-w="1360"
                  data-h="1360"
                  data-title={s.time}
                  data-meta={`Stage ${i + 1} of 21`}
                  tabindex="0"
                  role="button"
                  aria-label={`Open the ${s.time} stage at full size`}
                >
                  <img
                    src={`${A}/stage/${s.slug}-560.webp`}
                    srcset={`${A}/stage/${s.slug}-560.webp 560w, ${A}/stage/${s.slug}-1360.webp 1360w`}
                    sizes="(min-width: 900px) 11rem, 45vw"
                    alt={s.alt}
                    width="560"
                    height="560"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    <b>{s.time}</b>
                    <span class="moon-n">{String(i + 1).padStart(2, '0')} / 21</span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <figure
      class="plate"
      data-plate
      data-full={`${A}/ring-2040.webp`}
      data-w="2040"
      data-h="2040"
      data-title={copy.ring.time}
      data-meta={copy.ring.viewerNote}
      tabindex="0"
      role="button"
      aria-label={copy.ring.openLabel}
    >
      <img
        src={`${A}/ring-1020.webp`}
        srcset={`${A}/ring-1020.webp 1020w, ${A}/ring-2040.webp 2040w`}
        sizes="(min-width: 52rem) 48rem, 100vw"
        alt={copy.ring.alt}
        width="2040"
        height="2040"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <span class="cap-time">{copy.ring.time}</span>
        <span>{copy.ring.caption}</span>
      </figcaption>
    </figure>

    <div class="pair">
      <figure
        class="plate"
        data-plate
        data-full={`${A}/plane-track-a-3200.webp`}
        data-w="3200"
        data-h="3200"
        data-title={copy.trackA.time}
        data-meta={copy.trackA.viewerNote}
        tabindex="0"
        role="button"
        aria-label={copy.trackA.openLabel}
      >
        <img
          src={`${A}/plane-track-a-1200.webp`}
          srcset={`${A}/plane-track-a-1200.webp 1200w, ${A}/plane-track-a-2400.webp 2400w`}
          sizes="(min-width: 760px) 24rem, 100vw"
          alt={copy.trackA.alt}
          width="1200"
          height="1200"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span class="cap-time">{copy.trackA.time}</span>
          <span>{copy.trackA.caption}</span>
        </figcaption>
      </figure>

      <figure
        class="plate"
        data-plate
        data-full={`${A}/plane-track-b-3200.webp`}
        data-w="3200"
        data-h="3200"
        data-title={copy.trackB.time}
        data-meta={copy.trackB.viewerNote}
        tabindex="0"
        role="button"
        aria-label={copy.trackB.openLabel}
      >
        <img
          src={`${A}/plane-track-b-1200.webp`}
          srcset={`${A}/plane-track-b-1200.webp 1200w, ${A}/plane-track-b-2400.webp 2400w`}
          sizes="(min-width: 760px) 24rem, 100vw"
          alt={copy.trackB.alt}
          width="1200"
          height="1200"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span class="cap-time">{copy.trackB.time}</span>
          <span>{copy.trackB.caption}</span>
        </figcaption>
      </figure>
    </div>

    <p class="credit">{copy.credit}</p>

    <a class="back-link" href="/work/photography/">{copy.backLink}</a>
  </article>
  <Viewer />
</Base>

<script>
  import { arc as arcCopy } from '../../../data/copy/work-photography-eclipse.json';

  // the arc has two cuts of the same picture: evened out, and left alone
  const arcPlate = document.getElementById('arc-plate');
  const arcImg = document.getElementById('arc-img') as HTMLImageElement | null;
  const toggle = document.querySelector('.arc-toggle') as HTMLElement | null;

  if (arcPlate && arcImg && toggle) {
    const copy = {
      even: document.querySelector('.arc-caption-even') as HTMLElement,
      true: document.querySelector('.arc-caption-true') as HTMLElement,
    };
    toggle.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest('button');
      if (!btn) return;
      const key = btn.dataset.arc === 'true' ? 'true' : 'even';
      toggle.querySelectorAll('button').forEach((b) => b.classList.toggle('is-on', b === btn));
      arcImg.srcset = `/photo/eclipse/arc-${key}-1200.webp 1200w, /photo/eclipse/arc-${key}-2400.webp 2400w, /photo/eclipse/arc-${key}-6000.webp 6000w`;
      arcImg.src = `/photo/eclipse/arc-${key}-2400.webp`;
      arcPlate.dataset.full = `/photo/eclipse/arc-${key}-6000.webp`;
      arcPlate.dataset.title = key === 'true' ? arcCopy.trueTitle : arcCopy.evenTitle;
      copy.even.hidden = key === 'true';
      copy.true.hidden = key !== 'true';
    });
  }
</script>

<style>
  /* --- night ground: the photographs bring their own weather --- */
  .night-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: #100c08;
    color: #f4eddf;
  }

  .plate {
    margin: 3rem 0 0;
    cursor: zoom-in;
  }
  .plate:focus-visible {
    outline: 2px solid var(--sunflower);
    outline-offset: 4px;
  }
  .plate img {
    display: block;
    width: 100%;
    height: auto;
    background: #100c08;
  }
  .plate:not(.night-bleed) img {
    border: 2px solid var(--ink);
  }
  .plate figcaption,
  .band-hint,
  .credit {
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.55;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
  }
  .plate figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-top: 0.7rem;
    max-width: 58ch;
  }
  .cap-time {
    color: var(--sienna);
    letter-spacing: 0.14em;
    flex-shrink: 0;
  }

  .hero-plate {
    margin-top: 2.6rem;
    padding: 0 0 1.4rem;
  }
  .hero-plate img {
    /* the plate is square, so capping the width caps the height with it */
    max-width: min(46rem, 74vh);
    margin: 0 auto;
  }
  .hero-plate figcaption {
    max-width: 46rem;
    margin: 1rem auto 0;
    padding: 0 1.5rem;
    color: #b09a78;
  }
  .hero-plate .cap-time {
    color: var(--sunflower);
  }

  /* --- bands --- */
  .band {
    margin-top: 4.5rem;
    padding: 3.2rem 0 3.4rem;
  }
  .band-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem 1.5rem;
    padding-bottom: 1.2rem;
  }
  .band-head h2 {
    margin: 0;
    color: #f4eddf;
  }
  .band-hint {
    margin: 0;
    color: #b09a78;
  }

  /* --- the arc --- */
  .arc-toggle {
    display: flex;
    gap: 0.4rem;
  }
  .arc-toggle button {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    color: #f4eddf;
    background: transparent;
    border: 1px solid rgba(244, 237, 223, 0.3);
    border-radius: 0;
    padding: 0.32rem 0.7rem;
    cursor: pointer;
    transition:
      background 0.25s var(--ease-warm),
      border-color 0.25s var(--ease-warm);
  }
  .arc-toggle button:hover {
    border-color: #f4eddf;
  }
  .arc-toggle button.is-on {
    background: var(--sunflower);
    border-color: var(--sunflower);
    color: #100c08;
  }

  .arc {
    margin: 0;
    cursor: zoom-in;
  }
  .arc:focus-visible {
    outline: 2px solid var(--sunflower);
    outline-offset: -2px;
  }
  .arc-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgba(244, 237, 223, 0.3) transparent;
  }
  .arc-scroll img {
    display: block;
    height: clamp(190px, 34vw, 380px);
    width: auto;
    max-width: none;
  }
  .arc-cap {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }
  .arc-cap span {
    max-width: 64ch;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: #b09a78;
  }
  .arc .cap-time {
    color: var(--sunflower);
  }

  /* --- contact sheet --- */
  .sheet {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    gap: 1.1rem 0.9rem;
  }
  .moon {
    margin: 0;
    cursor: zoom-in;
    transition: transform 0.4s var(--ease-warm);
  }
  .moon:hover,
  .moon:focus-visible {
    transform: translateY(-4px);
    outline: none;
  }
  .moon:focus-visible img {
    outline: 2px solid var(--sunflower);
    outline-offset: 2px;
  }
  .moon img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(244, 237, 223, 0.14);
  }
  .moon:hover img {
    border-color: rgba(244, 237, 223, 0.4);
  }
  .moon figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.45rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: #8d7a5e;
  }
  .moon figcaption b {
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--sunflower);
  }
  .moon-n {
    color: #5f523f;
  }

  /* --- pair --- */
  .pair {
    display: grid;
    gap: 2rem;
    margin-top: 1rem;
  }
  .pair .plate {
    margin-top: 2rem;
  }

  .credit {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 2px solid var(--ink);
  }

  @media (min-width: 760px) {
    .pair {
      grid-template-columns: 1fr 1fr;
      gap: 1.4rem;
    }
    .pair .plate figcaption {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moon {
      transition: none;
    }
  }
</style>
