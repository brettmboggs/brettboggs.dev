---
import Base from '../../../layouts/Base.astro';
import Sheet from '../../../components/Sheet.astro';
import Viewer from '../../../components/Viewer.astro';
import copy from '../../../data/copy/work-photography-product.json';
import { md, inline } from '../../../data/copy';
---

<Base
  title={copy.title}
  description={copy.description}
  edit="work-pages/work-photography-product"
>
  <article>
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <figure class="bleed" data-plate data-title={copy.heading} tabindex="0" role="button" aria-label={copy.openLabel}>
      <img
        src={copy.hero.image}
        alt={copy.hero.alt}
        width="2400"
        height="1600"
        loading="eager"
      />
    </figure>

    <div class="prose" set:html={md(copy.intro)} />

    <figure class="select" data-plate data-title={copy.heading} tabindex="0" role="button" aria-label={copy.openLabel}>
      <img
        src={copy.select1.image}
        alt={copy.select1.alt}
        width="1600"
        height="1067"
        loading="lazy"
      />
    </figure>

    <Sheet label={copy.sheet1.label} frames={copy.sheet1.frames} />

    <figure class="select" data-plate data-title={copy.heading} tabindex="0" role="button" aria-label={copy.openLabel}>
      <img
        src={copy.select2.image}
        alt={copy.select2.alt}
        width="1600"
        height="1067"
        loading="lazy"
      />
    </figure>

    <Sheet label={copy.sheet2.label} frames={copy.sheet2.frames} />

    <p class="colophon" set:html={inline(copy.storeNote)} />

    <a class="back-link" href="/work/photography/">{copy.backLink}</a>
  </article>
  <Viewer />
</Base>
