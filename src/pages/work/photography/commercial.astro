---
import Base from '../../../layouts/Base.astro';
import Sheet from '../../../components/Sheet.astro';

const ked = [
  { src: '/photo/ked/k01.webp', alt: 'The front quarter of a Panamera under a thick coat of white foam.' },
  { src: '/photo/ked/k02.webp', alt: 'Foam running off a pair of polished exhaust tips.' },
  { src: '/photo/ked/k03.webp', alt: 'Hands working a red cloth over a yellow brake caliper.' },
  { src: '/photo/ked/k04.webp', alt: 'Water beading across a dark hood while the detailer rinses behind.' },
  { src: '/photo/ked/k05.webp', alt: 'A clean Panamera headlight, the lens catching an iridescent sheen.' },
  { src: '/photo/ked/k06.webp', alt: 'The grille and star of a finished G-Wagon against warm stone.' },
];
const tidal = [
  { src: '/photo/tidal/t01.webp', alt: 'A car nosing through blue tunnel brushes, headlights lit.' },
  { src: '/photo/tidal/t02.webp', alt: 'A red pickup coming out of the wash tunnel into daylight.' },
  { src: '/photo/tidal/t03.webp', alt: 'Two staff drying a dark sedan by hand at the vacuum bays.' },
  { src: '/photo/tidal/t04.webp', alt: 'A staff portrait in the forecourt, sunglasses pushed up.' },
  { src: '/photo/tidal/t05.webp', alt: 'A Cadillac under grey cloth brushes mid wash.' },
  { src: '/photo/tidal/t06.webp', alt: 'An attendant towelling down the back of a Bentley.' },
];
---

<Base
  title="Commercial · Brett Boggs"
  description="Detailing, a car wash chain, and the people running them."
>
  <article>
    <header class="page-head">
      <p class="eyebrow">Photography · 2021 to 2023</p>
      <h1>Commercial</h1>
      <p class="lede">Detailing, a car wash chain, and the people running them.</p>
    </header>

    <figure class="bleed">
      <img
        src="/photo/ked/estate.webp"
        alt="A black G-Wagon on a brick drive before a stone estate, headlights on, pink sky behind."
        width="2400"
        height="1600"
        loading="eager"
      />
    </figure>

    <div class="prose">
      <p>
        Knock Em Down details cars where they sit, in driveways instead of a shop. Tidal Wave runs
        tunnels. Both of them sell a finish, so the pictures have to make the finish look worth
        paying for.
      </p>
      <p>On location either way, on their schedule, working around customers.</p>
    </div>

    <figure class="select">
      <img
        src="/photo/ked/flare.webp"
        alt="A white Panamera being rinsed into the low sun, spray hanging in the light."
        width="1920"
        height="1280"
        loading="lazy"
      />
    </figure>

    <Sheet label="Knock Em Down · 2021 to 2022" frames={ked} />

    <figure class="select">
      <img
        src="/photo/tidal/sel.webp"
        alt="A Bentley grille emerging from grey cloth brushes."
        width="1920"
        height="1280"
        loading="lazy"
      />
    </figure>

    <Sheet label="Tidal Wave Auto Spa · May 2023" frames={tidal} />

    <div class="prose">
      <p class="colophon">
        I also built and ran <a href="https://www.kedservice.com" rel="noopener">the Knock Em Down site</a>.
      </p>
    </div>

    <a class="back-link" href="/work/photography/">All photography</a>
  </article>
</Base>
