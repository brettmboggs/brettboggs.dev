---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// a spanning entry sorts by when it finished, not when it started
const ended = (e: { data: { date: Date; dateEnd?: Date } }) => e.data.dateEnd ?? e.data.date;
const entries = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => ended(b).valueOf() - ended(a).valueOf(),
);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
function when(date: Date, dateEnd?: Date): string {
  if (!dateEnd) return fmt(date);
  const a = date.getFullYear();
  const b = dateEnd.getFullYear();
  return a === b ? String(a) : `${a} to ${b}`;
}
---

<Base title="Work · Brett Boggs" description="Case studies and shipped things.">
  <header class="page-head">
    <p class="eyebrow">01</p>
    <h1>Work</h1>
    <p class="lede">Case studies. The problem, the build, and what came of it.</p>
  </header>
  {
    entries.length > 0 ? (
      <ul class="entry-list">
        {entries.map((entry) => (
          <li>
            <a class="entry-row" href={`/work/${entry.id}/`}>
              <span>
                <span class="entry-title">{entry.data.title}</span>
                <span class="entry-desc">{entry.data.description}</span>
              </span>
              <time class="entry-meta" datetime={entry.data.date.toISOString()}>
                {when(entry.data.date, entry.data.dateEnd)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-note">First case study is being written. Datum is up first.</p>
    )
  }
</Base>
