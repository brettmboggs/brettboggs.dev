---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
// a spanning entry shows the years it ran rather than a single day
function when(date: Date, dateEnd?: Date): string {
  if (!dateEnd) return fmt(date);
  const a = date.getFullYear();
  const b = dateEnd.getFullYear();
  return a === b ? String(a) : `${a} to ${b}`;
}

const ended = (e: { data: { date: Date; dateEnd?: Date } }) => e.data.dateEnd ?? e.data.date;
const all = await getCollection('work', ({ data }) => !data.draft);
const photo = all.filter((e) => e.data.group === 'photography');

interface Row {
  href: string;
  title: string;
  desc: string;
  when: string;
  datetime: string;
  sort: number;
}

const rows: Row[] = all
  .filter((e) => !e.data.group && !e.data.unlisted)
  .map((e) => ({
    href: `/work/${e.id}/`,
    title: e.data.title,
    desc: e.data.description,
    when: when(e.data.date, e.data.dateEnd),
    datetime: e.data.date.toISOString(),
    sort: ended(e).valueOf(),
  }));

// the photo sets collapse into a single row rather than crowding out everything else
if (photo.length) {
  const opened = photo.reduce((a, b) => (a.data.date < b.data.date ? a : b)).data.date;
  const closed = photo.map(ended).reduce((a, b) => (a > b ? a : b));
  rows.push({
    href: '/work/photography/',
    title: 'Photography',
    desc: `Sets shot on location. ${photo.map((e) => e.data.title).join(', ')}.`,
    when: when(opened, closed),
    datetime: opened.toISOString(),
    sort: closed.valueOf(),
  });
}

rows.sort((a, b) => b.sort - a.sort);
---

<Base title="Work · Brett Boggs" description="Case studies and shipped things." scene="work">
  <header class="page-head">
    <p class="eyebrow">01</p>
    <h1>Work</h1>
    <p class="lede">Case studies. The problem, the build, and what came of it.</p>
  </header>
  {
    rows.length > 0 ? (
      <ul class="entry-list">
        {rows.map((row) => (
          <li>
            <a class="entry-row" href={row.href}>
              <span>
                <span class="entry-title">{row.title}</span>
                <span class="entry-desc">{row.desc}</span>
              </span>
              <time class="entry-meta" datetime={row.datetime}>
                {row.when}
              </time>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-note">First case study is being written. Datum is up first.</p>
    )
  }
</Base>
