---
import Base from '../../layouts/Base.astro';
import DatumSystem from '../../components/DatumSystem.astro';
import copy from '../../data/copy/work-datum.json';

// Bespoke project page for Datum.
// Every <figure data-media-slot> is a swap point: replace the <img>/<video>
// with a rendered 3D/4D asset later without touching the layout around it.
const deptSlots = ['estimating', 'finance', 'safety', 'people', 'equipment', 'strategy'];
---

<Base title={copy.title} description={copy.description} edit="work-pages/work-datum">
  <section class="band datum-hero full-bleed">
    <div class="band-inner wrap">
      <img class="datum-mark reveal" src="/datum/datum-mark.svg" alt="" width="76" height="76" style="--delay: 0s" />
      <h1 class="reveal" style="--delay: 0.1s">{copy.hero.heading}</h1>
      <p class="hero-tag reveal" style="--delay: 0.2s">{copy.hero.tagline}</p>
      <p class="hero-meta reveal" style="--delay: 0.3s">{copy.hero.meta}</p>
    </div>
  </section>

  <section class="statement rise">
    <h2>{copy.statement.heading}</h2>
    <p>
      {copy.statement.text}
    </p>
  </section>

  <figure class="shot full-bleed rise" data-media-slot="pm-hero">
    <link rel="stylesheet" href="/datum-stack-hero/stack-hero.css" />
    <div
      data-stack-hero
      data-frame-path="/datum-stack-hero/frames/"
      data-frame-count="120"
      data-scroll-length="3"
      data-poster="/datum-stack-hero/poster.webp"
      data-fallback-video="/datum-stack-hero/fallback.mp4"
    ></div>
    <script type="module" src="/datum-stack-hero/stack-hero.js" is:inline></script>
  </figure>

  <section class="duo rise">
    <div class="duo-copy">
      <h3>{copy.field.heading}</h3>
      <p>
        {copy.field.text}
      </p>
    </div>
    <figure class="shot" data-media-slot="field">
      <img src={copy.field.image} alt={copy.field.alt} loading="lazy" />
      <figcaption>{copy.field.caption}</figcaption>
    </figure>
  </section>

  <section class="duo duo-flip rise">
    <div class="duo-copy">
      <h3>{copy.yourWork.heading}</h3>
      <p>
        {copy.yourWork.text}
      </p>
    </div>
    <figure class="shot" data-media-slot="your-work">
      <img src={copy.yourWork.image} alt={copy.yourWork.alt} loading="lazy" />
      <figcaption>{copy.yourWork.caption}</figcaption>
    </figure>
  </section>

  <section class="dept rise">
    <h2>{copy.deptHeading}</h2>
    <div class="dept-grid">
      {copy.departments.map((d, i) => (
        <figure class="dept-tile" data-media-slot={deptSlots[i]}>
          <img src={d.image} alt={d.alt} loading="lazy" />
          <figcaption>{d.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="band film-band full-bleed rise">
    <div class="band-inner wrap">
      <h2>{copy.film.heading}</h2>
      <p class="film-note">{copy.film.note}</p>
      <figure class="film" data-media-slot="brand-film">
        <video src="/datum/dapple.mp4" controls preload="metadata" playsinline></video>
      </figure>
    </div>
  </section>

  <section class="statement rise">
    <h2>{copy.building.heading}</h2>
    <p>
      {copy.building.text}
    </p>
  </section>

  <section class="band build-band full-bleed rise">
    <div class="band-inner wrap">
      <h2>{copy.shipped.heading}</h2>
      <p class="build-lede">
        {copy.shipped.lede}
      </p>
      <dl class="figures">
        {copy.shipped.figures.map((f) => (
          <div>
            <dt>{f.number}</dt>
            <dd>{f.label}</dd>
          </div>
        ))}
      </dl>
      <div class="build-notes">
        {copy.shipped.notes.map((n) => (
          <p>
            {n.text}
          </p>
        ))}
      </div>
      <DatumSystem />
      <div class="logs">
        <p class="logs-head">{copy.logs.heading}</p>
        <p class="logs-note">{copy.logs.note}</p>
        <ul>
          {copy.logs.items.map((l) => (
            <li>
              <a href={l.url}>{l.label}</a>
              <span>{l.summary}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="page-end rise">
    <a class="cta" href={copy.cta.url} rel="noopener">{copy.cta.label}</a>
    <a class="back-link" href="/work/">{copy.backLink}</a>
  </div>
</Base>

<style>
  .full-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  /* Datum palette: ink #1E2022, light #F3F1EC. the page owns its own weather */
  .band {
    background: #1e2022;
    color: #f3f1ec;
  }
  .band-inner {
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
  }
  .datum-hero {
    margin-top: 1rem;
  }
  .datum-mark {
    display: block;
    background: #f3f1ec;
    border-radius: 18px;
    margin-bottom: 1.8rem;
  }
  .datum-hero h1 {
    color: #f3f1ec;
    font-size: clamp(2.8rem, 7vw, 4.8rem);
  }
  .hero-tag {
    margin-top: 1rem;
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    color: #cfccc2;
    max-width: 30ch;
    text-wrap: balance;
  }
  .hero-meta {
    margin-top: 2.4rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8f8c83;
  }

  .build-band {
    margin-top: 5.5rem;
  }
  .build-band h2 {
    font-size: clamp(1.9rem, 4.2vw, 2.9rem);
  }
  .build-lede {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: 1.1rem;
    color: #cfccc2;
  }
  /* figures as editorial rows, the way the index reads. no tiles. */
  .figures {
    margin: 3rem 0 0;
  }
  .figures > div {
    display: grid;
    grid-template-columns: minmax(6rem, 8rem) 1fr;
    align-items: baseline;
    gap: 0.4rem 1.6rem;
    padding: 1.3rem 0;
    border-top: 2px solid rgba(243, 241, 236, 0.22);
  }
  .figures dt {
    font-family: var(--display);
    font-variation-settings: 'opsz' 90, 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    line-height: 1;
    color: #f3f1ec;
  }
  .figures dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: #a9a69c;
  }
  .build-notes {
    margin-top: 3rem;
    display: grid;
    gap: 1.1rem;
    max-width: 62ch;
  }
  .build-notes p {
    max-width: none;
    color: #cfccc2;
  }
  /* decision logs: a quiet appendix for the reader who got this far */
  .logs {
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 2px solid rgba(243, 241, 236, 0.22);
    max-width: 62ch;
  }
  .logs-head {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8f8c83;
  }
  .logs-note {
    margin-top: 0.7rem;
    color: #a9a69c;
    font-size: 0.95rem;
  }
  .logs ul {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }
  .logs a {
    font-family: var(--display);
    font-variation-settings: 'opsz' 40, 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
    font-size: 1.05rem;
    color: #f3f1ec;
  }
  .logs li span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.9rem;
    color: #a9a69c;
  }
  @media (max-width: 560px) {
    .figures > div {
      grid-template-columns: 1fr;
    }
  }

  .statement {
    margin-top: 5.5rem;
  }
  .statement h2 {
    font-size: clamp(1.9rem, 4.2vw, 2.9rem);
    max-width: 22ch;
  }
  .statement p {
    margin-top: 1.2rem;
    font-size: 1.1rem;
    color: var(--ink-soft);
  }

  .shot img,
  .shot video {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 0.8rem;
  }
  .shot.full-bleed {
    margin-top: 3.5rem;
  }
  .shot.full-bleed figcaption {
    max-width: 62rem;
    margin: 0.8rem auto 0;
    padding: 0 1.5rem;
  }

  .duo {
    display: grid;
    grid-template-columns: minmax(16rem, 2fr) 3fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 5.5rem;
  }
  .duo-flip .duo-copy {
    order: 2;
  }
  .duo h3 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }
  .duo-copy p {
    margin-top: 1rem;
    color: var(--ink-soft);
  }

  .dept {
    margin-top: 5.5rem;
  }
  .dept h2 {
    font-size: clamp(1.9rem, 4.2vw, 2.9rem);
  }
  .dept-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 1.5rem;
    margin-top: 2.2rem;
  }
  .dept-tile {
    margin: 0;
  }
  .dept-tile img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--paper-deep);
  }

  .film-band {
    margin-top: 5.5rem;
  }
  .film-band h2 {
    color: #f3f1ec;
    font-size: clamp(1.9rem, 4.2vw, 2.9rem);
  }
  .film-note {
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8f8c83;
  }
  .film {
    margin-top: 2rem;
  }
  .film video {
    display: block;
    width: 100%;
    height: auto;
  }

  .page-end {
    margin-top: 4.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2rem;
  }
  .cta {
    font-family: var(--display);
    font-variation-settings: 'opsz' 40, 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
    font-size: 1.25rem;
  }
  .back-link {
    margin-top: 0;
  }

  /* rise-on-enter: sections fade up as they arrive, once */
  .rise {
    opacity: 0;
    translate: 0 28px;
    transition:
      opacity 0.85s var(--ease-warm),
      translate 0.85s var(--ease-warm);
  }
  .rise.in {
    opacity: 1;
    translate: 0 0;
  }

  @media (max-width: 720px) {
    .duo {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
    .duo-flip .duo-copy {
      order: 0;
    }
    .dept-grid {
      grid-template-columns: 1fr 1fr;
    }
    .band-inner {
      padding-top: 3.5rem;
      padding-bottom: 3.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise {
      opacity: 1;
      translate: none;
      transition: none;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const risers = document.querySelectorAll('.rise');
  if (reduced || !('IntersectionObserver' in window)) {
    risers.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -48px' },
    );
    risers.forEach((el) => io.observe(el));
  }
</script>
