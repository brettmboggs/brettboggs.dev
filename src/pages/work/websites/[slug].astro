---
// sites written up in Markdown alone, without a hand-built page
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import copy from '../../../data/copy/work-websites.json';
import { SITE, PERSON, breadcrumb } from '../../../data/schema';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft && !data.bespoke && data.group === 'websites');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });

const url = `${SITE}/work/websites/${entry.id}/`;
// a client build, credited to Brett so it counts toward his work in search
const graph = [
  {
    '@type': 'CreativeWork',
    '@id': `${url}#work`,
    url,
    name: entry.data.title,
    description: entry.data.description,
    dateCreated: entry.data.date.toISOString().slice(0, 10),
    creator: PERSON,
  },
  breadcrumb(url, [
    { name: 'Home', url: `${SITE}/` },
    { name: 'Work', url: `${SITE}/work/` },
    { name: 'Websites', url: `${SITE}/work/websites/` },
    { name: entry.data.title, url },
  ]),
];
---

<Base title={`${entry.data.title} · Brett Boggs`} description={entry.data.description} edit={`work/${entry.id}`} graph={graph}>
  <article>
    <header class="page-head">
      <p class="eyebrow">Websites · {fmt(entry.data.date)}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <a class="back-link" href="/work/websites/">{copy.backLink}</a>
  </article>
</Base>
