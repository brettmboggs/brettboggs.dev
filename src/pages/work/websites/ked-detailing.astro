---
import Base from '../../../layouts/Base.astro';
import copy from '../../../data/copy/work-websites-ked-detailing.json';
import { md } from '../../../data/copy';
---

<Base
  title={copy.title}
  description={copy.description}
  edit="work-pages/work-websites-ked-detailing"
>
  <article>
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <!-- The point of this page is the build itself, so the way in comes first. -->
    <a class="launch" href={copy.launch.url}>
      <span class="launch-go">{copy.launch.label} <span aria-hidden="true">&rarr;</span></span>
      <span class="launch-meta">{copy.launch.meta}</span>
    </a>

    <a class="shot" href={copy.launch.url} aria-label={copy.shot.ariaLabel}>
      <img
        src={copy.shot.image}
        alt={copy.shot.alt}
        width="1440"
        height="960"
        loading="eager"
      />
      <span class="shot-chip">{copy.shot.chip}</span>
    </a>

    <div class="prose">
      <Fragment set:html={md(copy.body)} />
      <p class="note">
        {copy.note}
      </p>
    </div>

    <a class="back-link" href="/work/websites/">{copy.backLink}</a>
  </article>
</Base>

<style>
  .launch {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin: 2.5rem 0 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--ink);
    text-decoration: none;
  }
  .launch-go {
    font-family: var(--display);
    font-variation-settings: 'opsz' 60, 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.05;
    color: var(--sienna);
  }
  .launch-go span {
    display: inline-block;
    transition: translate 0.4s var(--ease-warm);
  }
  .launch:hover .launch-go span,
  .launch:focus-visible .launch-go span {
    translate: 0.35rem 0;
  }
  .launch-meta {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  /* The screenshot is a second, larger target for the same link. */
  .shot {
    position: relative;
    display: block;
    overflow: hidden;
    border: 2px solid var(--ink);
    line-height: 0;
  }
  .shot img {
    width: 100%;
    height: auto;
    transition: scale 0.7s var(--ease-warm);
  }
  .shot:hover img,
  .shot:focus-visible img {
    scale: 1.02;
  }
  .shot-chip {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.5rem 0.9rem;
    background: var(--paper);
    border-top: 2px solid var(--ink);
    border-right: 2px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
  }

  .prose {
    margin-top: 2.75rem;
  }
  .note {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .launch-go span,
    .shot img {
      transition: none;
    }
  }
</style>
