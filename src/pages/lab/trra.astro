---
import Base from '../../layouts/Base.astro';
import copy from '../../data/copy/lab-trra.json';
import { md } from '../../data/copy';

const v = copy.viewer;
---

<Base
  title={copy.title}
  description={copy.description}
  ogImage={copy.ogImage}
  edit="lab-pages/lab-trra"
>
  <article>
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <figure class="shot">
      <img
        src={copy.hero.image}
        alt={copy.hero.alt}
        width="1920"
        height="1033"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{copy.hero.caption}</figcaption>
    </figure>

    <div class="prose" set:html={md(copy.intro)} />

    <section class="viewer" aria-label={v.ariaLabel}>
      <div class="viewer-head">
        <h2>{v.heading}</h2>
        <p class="viewer-hint"><span class="hint-pointer">{v.hintPointer}</span><span class="hint-touch">{v.hintTouch}</span></p>
      </div>

      <div class="stage">
        <canvas id="trra-canvas"></canvas>
        <p class="stage-note" id="trra-status">{v.loading}</p>
      </div>

      <div class="controls">
        <div class="control-group" role="group" aria-label={v.extentLabel}>
          <span class="control-label">{v.extentLabel}</span>
          <div class="control-row" id="trra-extent">
            <button type="button" data-url="/lab/trra/job.glb" class="is-on">{v.extentJob}</button>
            <button type="button" data-url="/lab/trra/network.glb">{v.extentNetwork}</button>
          </div>
        </div>
        <div class="control-group" role="group" aria-label={v.groundLabel}>
          <span class="control-label">{v.groundLabel}</span>
          <div class="control-row" id="trra-ground">
            <button type="button" data-ground="off" class="is-on">{v.groundOff}</button>
            <button type="button" data-ground="on">{v.groundOn}</button>
          </div>
        </div>
        <div class="control-group">
          <span class="control-label">{v.viewLabel}</span>
          <div class="control-row">
            <button type="button" id="trra-recenter">{v.recenter}</button>
            <button type="button" id="trra-fullscreen" hidden>{v.fullscreen}</button>
          </div>
        </div>
        <div class="control-group" role="group" aria-label={v.systemLabel}>
          <span class="control-label">{v.systemLabel}</span>
          <div class="control-row" id="trra-systems">
            {
              v.systems.map((s) => (
                <button type="button" data-system={s.key} class={s.key === '' ? 'is-on' : ''}>
                  {s.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <p class="viewer-caption">{v.caption}</p>
    </section>

    <div class="prose">
      <h2>{copy.whereHeading}</h2>
      <Fragment set:html={md(copy.whereBody)} />
    </div>

    <figure class="locator">
      <div class="locator-frame">
        <img
          src={copy.locator.image}
          alt={copy.locator.alt}
          width="1400"
          height="1400"
          loading="lazy"
        />
        <svg viewBox="0 0 1000 1000" aria-hidden="true">
          <line class="reach" x1="592.0" y1="574.5" x2="706.0" y2="581.0" />
          <line class="job" x1="388.2" y1="504.4" x2="592.0" y2="574.5" />
          <circle class="pin" cx="592.0" cy="574.5" r="9" />
          <circle class="dot" cx="459.5" cy="171.4" r="5" />
          <text class="tag" x="474" y="176">{copy.locator.archLabel}</text>
          <circle class="dot" cx="228.3" cy="248.0" r="5" />
          <text class="tag" x="243" y="253">{copy.locator.stadiumLabel}</text>
          <line class="rule" x1="60" y1="946" x2="228.4" y2="946" />
          <text class="tag" x="60" y="932">{copy.locator.scaleLabel}</text>
          <line class="rule" x1="946" y1="946" x2="946" y2="898" />
          <text class="tag" x="939" y="884">{copy.locator.northLabel}</text>
        </svg>
      </div>
      <figcaption>{copy.locator.caption}</figcaption>
    </figure>

    <div class="prose">
      <h2>{copy.wallHeading}</h2>
      <Fragment set:html={md(copy.wallBody)} />
    </div>

    <figure class="shot">
      <img
        src={copy.wallPhoto.image}
        alt={copy.wallPhoto.alt}
        width="1800"
        height="968"
        loading="lazy"
      />
      <figcaption>{copy.wallPhoto.caption}</figcaption>
    </figure>

    <div class="prose">
      <h2>{copy.bridgeHeading}</h2>
      <Fragment set:html={md(copy.bridgeBody)} />
    </div>

    <figure class="shot">
      <img
        src={copy.spanPhoto.image}
        alt={copy.spanPhoto.alt}
        width="1600"
        height="861"
        loading="lazy"
      />
      <figcaption>{copy.spanPhoto.caption}</figcaption>
    </figure>

    <figure class="shot">
      <img
        src={copy.deckPhoto.image}
        alt={copy.deckPhoto.alt}
        width="1600"
        height="861"
        loading="lazy"
      />
      <figcaption>{copy.deckPhoto.caption}</figcaption>
    </figure>

    <div class="prose">
      <h2>{copy.trackHeading}</h2>
      <Fragment set:html={md(copy.trackBody)} />

      <table>
        <thead>
          <tr><th>{copy.runsTable.headRun}</th><th>{copy.runsTable.headLength}</th><th>{copy.runsTable.headRadius}</th><th>{copy.runsTable.headGrade}</th></tr>
        </thead>
        <tbody>
          {
            copy.runsTable.rows.map((r) => (
              <tr><td>{r.run}</td><td>{r.length}</td><td>{r.radius}</td><td>{r.grade}</td></tr>
            ))
          }
        </tbody>
      </table>

      <h2>{copy.passesHeading}</h2>
      <Fragment set:html={md(copy.passesBody)} />
    </div>

    <ol class="progression">
      {
        copy.progression.map((p) => (
          <li>
            <img src={p.image} alt={p.alt} width="1200" height="675" loading="lazy" />
            <div class="progression-note">
              <span class="progression-step">{p.step}</span>
              <span>{p.note}</span>
            </div>
          </li>
        ))
      }
    </ol>

    <figure class="shot">
      <img
        src={copy.yardPhoto.image}
        alt={copy.yardPhoto.alt}
        width="1600"
        height="861"
        loading="lazy"
      />
      <figcaption>{copy.yardPhoto.caption}</figcaption>
    </figure>

    <div class="prose">
      <h2>{copy.sceneHeading}</h2>
      <table>
        <tbody>
          {
            copy.sceneTable.map((r) => (
              <tr><td>{r.item}</td><td>{r.detail}</td></tr>
            ))
          }
        </tbody>
      </table>

      <h2>{copy.openHeading}</h2>
      <Fragment set:html={md(copy.openBody)} />
    </div>

    <a class="back-link" href="/lab/">{copy.backLink}</a>
  </article>
</Base>

<script>
  import { mountTrraViewer } from '../../scripts/trraViewer';

  const canvas = document.getElementById('trra-canvas') as HTMLCanvasElement | null;
  const status = document.getElementById('trra-status');
  if (canvas) {
    const viewer = mountTrraViewer(canvas, '/lab/trra/job.glb', (text) => {
      if (status) status.textContent = text;
    });

    if (!viewer) {
      // no WebGL: the controls would be inert, so retire them and leave the
      // stills and the text, which are the majority of the page anyway
      document.querySelector('.controls')?.setAttribute('hidden', '');
      document.querySelector('.viewer-hint')?.setAttribute('hidden', '');
    }

    if (viewer) {
      const arm = (id: string, run: (btn: HTMLButtonElement) => void) => {
        const host = document.getElementById(id);
        host?.addEventListener('click', (event) => {
          const btn = (event.target as HTMLElement).closest('button');
          if (!btn || !host.contains(btn)) return;
          host.querySelectorAll('button').forEach((b) => b.classList.toggle('is-on', b === btn));
          run(btn as HTMLButtonElement);
        });
      };

      arm('trra-systems', (btn) => viewer.isolate(btn.dataset.system ?? ''));
      arm('trra-ground', (btn) => viewer.setGround(btn.dataset.ground === 'on'));
      document.getElementById('trra-recenter')?.addEventListener('click', () => viewer.recenter());

      // Fullscreen takes the whole viewer, controls and all, because isolating a
      // system is the reason to be big in the first place. iOS Safari has no
      // element fullscreen, so the button only appears where it will work.
      const shell = document.querySelector('.viewer') as HTMLElement | null;
      const fsBtn = document.getElementById('trra-fullscreen') as HTMLButtonElement | null;
      if (shell && fsBtn && shell.requestFullscreen) {
        fsBtn.hidden = false;
        fsBtn.addEventListener('click', () => {
          if (document.fullscreenElement) document.exitFullscreen();
          else shell.requestFullscreen().catch(() => {});
        });
        document.addEventListener('fullscreenchange', () => {
          const on = document.fullscreenElement === shell;
          fsBtn.textContent = on ? 'Exit fullscreen' : 'Fullscreen';
          fsBtn.classList.toggle('is-on', on);
        });
      }
      arm('trra-extent', (btn) => {
        const url = btn.dataset.url;
        if (url) viewer.setModel(url);
      });
    }
  }
</script>

<style>
  .shot {
    margin: 3rem 0 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--ink);
  }
  .shot figcaption,
  .stage-note,
  .control-label,
  .progression-note {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .shot figcaption {
    margin-top: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .locator {
    margin: 3rem 0 0;
  }
  .locator-frame {
    position: relative;
    border: 2px solid var(--ink);
    line-height: 0;
  }
  .locator-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .locator-frame svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .locator .job {
    stroke: var(--sienna);
    stroke-width: 7;
    stroke-linecap: round;
  }
  .locator .reach {
    stroke: var(--sunflower);
    stroke-width: 4.5;
    stroke-linecap: round;
  }
  .locator .pin {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
  }
  .locator .dot {
    fill: none;
    stroke: #fff;
    stroke-width: 2.5;
  }
  .locator .rule {
    stroke: #fff;
    stroke-width: 4;
  }
  .locator .tag {
    fill: #fff;
    font-family: var(--mono);
    font-size: 15px;
    letter-spacing: 0.06em;
    paint-order: stroke;
    stroke: rgba(24, 20, 14, 0.55);
    stroke-width: 3.5;
  }
  .locator figcaption {
    margin-top: 0.7rem;
    max-width: var(--measure);
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.55;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .viewer {
    margin-top: 4rem;
  }
  .viewer-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.6rem;
  }
  .viewer-head h2 {
    margin: 0;
  }
  .hint-touch {
    display: none;
  }
  @media (hover: none) and (pointer: coarse) {
    .hint-pointer {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }
  .viewer-hint {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .stage {
    position: relative;
    margin-top: 1.2rem;
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  /* fullscreen: the stage takes whatever the controls and the head leave */
  .viewer:fullscreen {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 1.1rem 1.4rem 1.4rem;
    background: var(--paper);
    overflow: hidden;
  }
  .viewer:fullscreen .stage {
    flex: 1;
    min-height: 0;
  }
  .viewer:fullscreen .stage canvas {
    height: 100%;
  }
  .viewer:fullscreen .viewer-caption {
    display: none;
  }
  .stage canvas {
    display: block;
    width: 100%;
    height: clamp(300px, 56vw, 620px);
    /* one finger keeps scrolling the page; two fingers drive the model */
    touch-action: pan-y;
  }
  .stage-note {
    position: absolute;
    left: 0.6rem;
    bottom: 0.5rem;
    margin: 0;
    pointer-events: none;
    /* it sits over aerial photography once the ground is on, so it carries its
       own backing rather than relying on the paper behind it */
    padding: 0.2rem 0.45rem;
    background: rgba(244, 237, 223, 0.82);
    color: var(--ink);
  }

  /* touch only: the viewer stays inert until tapped so the page can still be
     scrolled past it, then hands back one finger orbit and two finger pan */
  .stage :global(.stage-grab),
  .stage :global(.stage-release) {
    position: absolute;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    border: 2px solid var(--ink);
    border-radius: 0;
    cursor: pointer;
  }
  .stage :global(.stage-grab) {
    inset: 0;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    border: 0;
    background: rgba(244, 237, 223, 0.34);
    color: var(--ink);
    text-transform: uppercase;
  }
  .stage :global(.stage-release) {
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.3rem 0.7rem;
    background: var(--ink);
    color: var(--paper);
  }
  .stage :global([hidden]) {
    display: none;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem 2.4rem;
    margin-top: 1.1rem;
  }
  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .control-label {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.7rem;
  }
  .control-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .control-row button {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    background: transparent;
    border: 2px solid rgba(51, 41, 28, 0.28);
    border-radius: 0;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease-warm),
      background 0.25s var(--ease-warm);
  }
  .control-row button:hover {
    border-color: var(--ink);
  }
  .control-row button.is-on {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .viewer-caption {
    margin-top: 1.4rem;
    max-width: var(--measure);
  }

  .progression {
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .progression img {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--ink);
  }
  .progression-note {
    display: flex;
    gap: 0.9rem;
    margin-top: 0.7rem;
    align-items: baseline;
  }
  .progression-step {
    color: var(--sienna);
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .progression {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
    }
    .progression-note {
      display: block;
    }
    .progression-step {
      display: block;
      margin-bottom: 0.25rem;
    }
  }
</style>
