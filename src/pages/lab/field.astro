---
import Base from '../../layouts/Base.astro';
import FieldScene from '../../components/FieldScene.astro';
import copy from '../../data/copy/lab-field.json';
---

<Base
  title={copy.title}
  description={copy.description}
  edit="lab-pages/lab-field"
>
  <FieldScene tall>
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lede">{copy.lede}</p>
    </header>
  </FieldScene>

  <div class="colophon">
    <p>{copy.colophon}</p>
  </div>

  <a class="back-link" href="/lab/">{copy.backLink}</a>
</Base>
