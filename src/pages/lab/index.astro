---
import Base from '../../layouts/Base.astro';
import copy from '../../data/copy/lab.json';

const entries = copy.entries;
---

<Base title={copy.title} description={copy.description} scene="lab" edit="pages/lab">
  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </header>
  {
    entries.length > 0 ? (
      <ul class="entry-list">
        {entries.map((entry) => (
          <li>
            <a class="entry-row" href={entry.href} data-peek={entry.peek}>
              <span>
                <span class="entry-title">{entry.title}</span>
                <span class="entry-desc">{entry.desc}</span>
              </span>
              <span class="entry-meta">{entry.meta}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-note">{copy.empty}</p>
    )
  }
</Base>
