---
import Base from '../../layouts/Base.astro';
import copy from '../../data/copy/lab-sprout-siege.json';
import { md } from '../../data/copy';
---

<Base
  title={copy.title}
  description={copy.description}
  edit="lab-pages/lab-sprout-siege"
>
  <article>
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <figure class="shot">
      <img src={copy.farmShot.image} width="1600" height="782"
           alt={copy.farmShot.alt} />
      <figcaption>{copy.farmShot.caption}</figcaption>
    </figure>

    <dl class="figures">
      {copy.figures.map((f) => (
        <div>
          <dt>{f.value}</dt>
          <dd>{f.label}</dd>
        </div>
      ))}
    </dl>

    <div class="prose">
      <Fragment set:html={md(copy.rule)} />

      <figure class="shot">
        <img src={copy.defenseShot.image} width="1600" height="782"
             alt={copy.defenseShot.alt} loading="lazy" />
        <figcaption>{copy.defenseShot.caption}</figcaption>
      </figure>

      <Fragment set:html={md(copy.body)} />

      <figure class="shot">
        <img src={copy.riskShot.image} width="1600" height="782"
             alt={copy.riskShot.alt} loading="lazy" />
        <figcaption>{copy.riskShot.caption}</figcaption>
      </figure>

      <p class="colophon">{copy.colophon}</p>
    </div>

    <a class="back-link" href="/lab/">{copy.backLink}</a>
  </article>
</Base>

<style>
  .shot {
    margin: 3rem 0 0;
    padding: 0;
  }
  .prose .shot {
    margin: 2.2rem 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--ink);
  }
  .shot figcaption {
    margin-top: 0.7rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
  /* figures as editorial rows, matching the index. no tiles. */
  .figures {
    margin: 3rem 0 0;
  }
  .figures > div {
    display: grid;
    grid-template-columns: minmax(5rem, 7rem) 1fr;
    align-items: baseline;
    gap: 0.4rem 1.6rem;
    padding: 1.3rem 0;
    border-top: 2px solid var(--ink);
  }
  .figures dt {
    font-family: var(--display);
    font-variation-settings: 'opsz' 90, 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    line-height: 1;
    color: var(--ink);
  }
  .figures dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
  .prose code {
    font-family: var(--mono);
    font-size: 0.92em;
    background: var(--paper-deep);
    padding: 0.1em 0.35em;
  }
  @media (max-width: 560px) {
    .figures > div {
      grid-template-columns: 1fr;
    }
  }
</style>
