---
import Base from '../../layouts/Base.astro';
import copy from '../../data/copy/lab-ridge.json';
import { md } from '../../data/copy';
---

<Base
  title={copy.title}
  description={copy.description}
  edit="lab-pages/lab-ridge"
>
  <article>
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <figure class="shot">
      <img src={copy.still.image} alt={copy.still.alt} width="1600" height="900" loading="eager" />
    </figure>

    <div class="prose" set:html={md(copy.body)} />

    <figure class="shot">
      <img src={copy.framing.image} alt={copy.framing.alt} width="1600" height="900" loading="lazy" />
      <figcaption>{copy.framing.caption}</figcaption>
    </figure>

    <a class="back-link" href="/lab/">{copy.backLink}</a>
  </article>
</Base>

<style>
  .shot {
    margin: 3rem 0 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--ink);
  }
  .shot figcaption {
    margin-top: 0.7rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
