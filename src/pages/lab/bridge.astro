---
// The Bridge. Datum's very first landing intro (datum-core eb8bbde, PR #446,
// July 2026): a scroll-scrubbed 3D film in which a cable-stayed river
// crossing surveys, drafts, builds, opens, and lights up with data, then
// dissolves into dawn. Retired two days later by the landing's rule against
// literal construction imagery. The film itself did nothing wrong.
import Base from '../../layouts/Base.astro';
import copy from '../../data/copy/lab-bridge.json';

// Chip ids and the centered last beat are plumbing the film script reads by
// DOM order; the words live in the JSON.
const chipIds = ['report', 'rfi', 'pour', 'payapp'];
---

<Base
  title={copy.title}
  description={copy.description}
  edit="lab-pages/lab-bridge"
>
  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  <section class="film-bleed">
    <p class="cin-sr">{copy.screenReaderStory}</p>

    <div class="cin" data-film hidden>
      <div class="cin-stage">
        <canvas class="cin-canvas" aria-hidden="true"></canvas>
        <div class="cin-overlay" aria-hidden="true">
          {copy.beats.map((b, i) => (
            <div class:list={['cin-beat', { 'cin-beat--center': i === copy.beats.length - 1 }]}>
              <div class="cin-kicker">{b.kicker}</div>
              <h2 class="cin-line">
                {b.lines.map((seg) => (
                  <span>{seg}<br /></span>
                ))}
              </h2>
            </div>
          ))}
          {copy.chips.map((c, i) => (
            <div class="cin-chip" data-chip={chipIds[i]}>
              <span class="cin-chip-dot"></span>
              <div>
                <div class="cin-chip-label">{c.label}</div>
                <div class="cin-chip-meta">{c.meta}</div>
              </div>
              <span class="cin-chip-stem"></span>
            </div>
          ))}
          <div class="cin-brand">
            <span class="cin-wordmark">{copy.wordmark}</span>
          </div>
          <div class="cin-hint">
            <span>{copy.scrollHint}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </div>
        </div>
        <button type="button" class="cin-skip">{copy.skipButton}</button>
        <div class="cin-veil" aria-hidden="true"></div>
      </div>
    </div>

    <div class="cin-unsupported" data-film-fallback>
      <p class="cin-kicker">{copy.fallbackKicker}</p>
      <p class="cin-line">{copy.fallbackLines.map((seg, i) => (i === 0 ? seg : <><br />{seg}</>))}</p>
      <p class="cin-unsupported-note">{copy.fallbackNote}</p>
    </div>
  </section>

  <div class="colophon">
    {copy.colophon.map((para) => (
      <p>{para}</p>
    ))}
  </div>

  <a class="back-link" href="/lab/">{copy.backLink}</a>
</Base>

<script>
  import { mountBridgeFilm, hasWebGL2 } from '../../scripts/bridgeFilm';

  const track = document.querySelector<HTMLElement>('[data-film]');
  const fallback = document.querySelector<HTMLElement>('[data-film-fallback]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const supported = !reduced && hasWebGL2();

  if (track && supported) {
    track.hidden = false;
    if (fallback) fallback.style.display = 'none';
    mountBridgeFilm(track);
  }
</script>

<style>
  .film-bleed {
    width: 100vw;
    margin: 3rem 0 0 calc(50% - 50vw);
  }

  /* The film's palette, scoped. The render paints its own colors; these
     tokens style the overlay copy, the chips, and the one brand color the
     scene reads at runtime (the hologram azure, via --cta on the canvas). */
  .cin,
  .cin-unsupported {
    --bg-app: #070b12;
    --text-primary: #f2f5f7;
    --text-secondary: #c3cbd4;
    --text-muted: #8b95a3;
    --cta: #0a84ff;
    --glass-bg: rgba(10, 16, 26, 0.55);
    --border-subtle: rgba(242, 245, 247, 0.16);
    --border-strong: rgba(242, 245, 247, 0.4);
    --glass-blur: 12px;
    --radius-pill: 999px;
    --ease-out: var(--ease-warm);
    --font-display: var(--display);
    --font-body: var(--body);
    --font-crumb: var(--mono);
    --tracking-label: 0.16em;
    --tracking-display: -0.015em;
    --tracking-body-sm: 0.01em;
    --text-caption: 0.75rem;
  }

  .cin-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .cin {
    position: relative;
    height: 500vh; /* ~4 scroll-lengths of film + the release */
    background: var(--bg-app);
  }
  .cin[hidden] {
    display: none;
  }
  .cin-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--bg-app);
  }
  .cin-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.9s var(--ease-out);
  }
  .cin-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cin-beat {
    position: absolute;
    left: clamp(24px, 7vw, 110px);
    bottom: clamp(72px, 16vh, 160px);
    max-width: 700px;
    opacity: 0;
    visibility: hidden;
  }
  .cin-beat--center {
    left: 50%;
    right: auto;
    bottom: auto;
    top: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    max-width: 760px;
  }
  .cin-beat--center .cin-line {
    font-size: clamp(34px, 4.6vw, 62px);
  }
  .cin-kicker {
    font-family: var(--font-crumb);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .cin-line {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'SOFT' 60, 'WONK' 1;
    font-size: clamp(28px, 3.4vw, 50px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
    margin: 0;
    text-wrap: balance;
  }

  .cin-chip {
    position: absolute;
    transform: translate(-50%, calc(-100% - 26px));
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 10px 14px 11px;
    border-radius: 14px;
    background: var(--glass-bg);
    border: 1px solid var(--border-subtle);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    opacity: 0;
    visibility: hidden;
    white-space: nowrap;
  }
  .cin-chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cta);
    margin-top: 5px;
    flex-shrink: 0;
  }
  .cin-chip-label {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: var(--tracking-body-sm);
    color: var(--text-primary);
  }
  .cin-chip-meta {
    font-family: var(--font-crumb);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .cin-chip-stem {
    position: absolute;
    left: 50%;
    top: 100%;
    width: 1px;
    height: 26px;
    background: linear-gradient(to bottom, var(--border-strong), transparent);
  }

  .cin-brand {
    position: absolute;
    top: 20px;
    left: 26px;
  }
  .cin-wordmark {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 21px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .cin-hint {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    color: var(--text-muted);
    font-family: var(--font-crumb);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .cin-hint svg {
    animation: cin-hint-bob 2.2s var(--ease-out) infinite;
  }
  @keyframes cin-hint-bob {
    0%,
    100% {
      transform: none;
    }
    50% {
      transform: translateY(4px);
    }
  }

  .cin-skip {
    position: absolute;
    top: 18px;
    right: 22px;
    z-index: 5;
    background: var(--glass-bg);
    border: 1px solid var(--border-subtle);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 12.5px;
    letter-spacing: var(--tracking-body-sm);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .cin-skip:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .cin-veil {
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: 0;
    pointer-events: none;
  }

  /* Shown until the script confirms WebGL2 + motion; then the film takes over. */
  .cin-unsupported {
    background: var(--bg-app);
    padding: 18vh 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cin-unsupported .cin-line {
    font-size: clamp(28px, 4.4vw, 54px);
  }
  .cin-unsupported-note {
    margin-top: 2rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .cin-beat {
      bottom: 96px;
    }
    .cin-line {
      font-size: clamp(26px, 7.4vw, 38px);
    }
    .cin-chip {
      display: none;
    }
  }
</style>
