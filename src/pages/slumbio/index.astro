---
import Base from '../../layouts/Base.astro';
import copy from '../../data/copy/slumbio.json';
import { md, inline } from '../../data/copy';

// The app's page. Linked from inside the app, from the App Store listing as
// both the support and marketing URL, and from anywhere Brett points people.
// Indexed, unlike the policy pages, because this is the one that has to be
// findable.
---

<Base
  title={copy.title}
  description={copy.description}
  puck={false}
  edit="slumbio/slumbio"
>
  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  <section class="body">
    <Fragment set:html={md(copy.intro)} />

    <figure class="shots">
      {copy.shots.map((shot) => (
        <img src={shot.image} width="420" height="913" alt={shot.alt} loading="lazy" />
      ))}
    </figure>

    {copy.sections.map((s) => (
      <>
        <h2>{s.heading}</h2>
        <Fragment set:html={md(s.body)} />
      </>
    ))}

    <p class="cta">
      <a href={copy.cta.url}>{copy.cta.text}</a>
    </p>

    <p class="fine" set:html={inline(copy.fine)} />

    <ul class="links">
      {copy.links.map((l) => (
        <li><a href={l.url}>{l.text}</a></li>
      ))}
    </ul>
  </section>

  <a class="back-link" href="/">{copy.backLink}</a>
</Base>

<style>
  .body {
    max-width: 38rem;
    margin: 2rem 0 3rem;
  }
  .body p {
    margin: 0 0 1rem;
  }
  .body h2 {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.05rem;
  }
  .cta {
    margin: 2.5rem 0 1.5rem;
  }
  .fine {
    font-size: 0.95rem;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 0;
  }
  .shots img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid rgba(51, 41, 28, 0.18);
  }
  @media (max-width: 34rem) {
    .shots {
      grid-template-columns: repeat(2, 1fr);
    }
    .shots img:last-child {
      display: none;
    }
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    gap: 1.5rem;
  }
</style>
