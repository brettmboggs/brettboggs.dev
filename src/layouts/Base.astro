---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Brett Boggs — builder, co-founder of Datum.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Brett Boggs</a>
        <a href="/work/">Work</a>
        <a href="/lab/">Lab</a>
        <a href="/writing/">Writing</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Brett Boggs</p>
    </footer>
  </body>
</html>
