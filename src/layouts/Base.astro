---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '@fontsource/spline-sans-mono/400.css';
import '@fontsource/spline-sans-mono/500.css';
import '../styles/global.css';
import { ogFor } from '../data/og';

interface Props {
  title: string;
  description?: string;
  home?: boolean;
  /** page-specific social card, resolved against the site root */
  ogImage?: string;
  /** marks the page as an article and stamps its dates */
  article?: { published: Date; modified?: Date };
  /** working pages that should stay out of search results */
  noindex?: boolean;
  /** section pages carry their scene of the landing frame as a faint ghost */
  scene?: 'work' | 'lab' | 'about';
  /** pages that bring their own station furniture can retire the puck */
  puck?: boolean;
  /** payment pages: a strict CSP forbids inline scripts, and production builds
   *  inline this one. A service worker has no business on a checkout anyway. */
  noServiceWorker?: boolean;
}

const {
  title,
  description = 'Brett Boggs. Work and experiments.',
  home = false,
  ogImage: ogGiven,
  article,
  noindex = false,
  scene,
  puck = true,
  noServiceWorker = false,
} = Astro.props;

// which section the visitor is in, for the puck's needle and current mark
const path = Astro.url.pathname;
const here = path.startsWith('/work')
  ? 'work'
  : path.startsWith('/lab')
    ? 'lab'
    : path.startsWith('/about')
      ? 'about'
      : path.startsWith('/store')
        ? 'store'
        : '';

// the social card: a page's own picture if it brought one, else the card drawn
// for it at build time (src/data/og.ts), else the film
const card = ogFor(path);
const ogImage = ogGiven ?? (card ? `/og/${card.id}.png` : '/og.png');
const ogAlt = ogGiven || !card ? 'Brett Boggs. Work and experiments.' : `${card.title} ${card.note}`;

const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site);
const social = new URL(ogImage, Astro.site);

// Only the homepage carries the identity graph. Repeating it on every page
// hands crawlers duplicate entities to reconcile, which weakens rather than
// reinforces the one they should be reading.
const schema = home
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': 'https://brettboggs.dev/#brett',
          name: 'Brett Boggs',
          url: 'https://brettboggs.dev',
          email: 'brettmboggs@gmail.com',
          image: 'https://brettboggs.dev/og.png',
          affiliation: {
            '@type': 'Organization',
            name: 'Datum',
            url: 'https://datumci.com',
          },
          sameAs: ['https://github.com/brettmboggs'],
        },
        {
          '@type': 'WebSite',
          '@id': 'https://brettboggs.dev/#site',
          url: 'https://brettboggs.dev',
          name: 'Brett Boggs',
          description: 'Brett Boggs. Work and experiments.',
          publisher: { '@id': 'https://brettboggs.dev/#brett' },
          inLanguage: 'en',
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Brett Boggs" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <!-- ico first for browsers that only read ico, svg for everything current -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F4EDDF" />
    <meta name="apple-mobile-web-app-title" content="Brett Boggs" />
    {
      !home && (
        <script is:inline>
          /* dusk, decided before first paint: after sunset the paper cools. sunset is
             guessed from the clock and the month, never from location. ?dusk=1 or
             ?dusk=0 in the address sets a choice that stays on this device. */
          (function () {
            try {
              var q = new URLSearchParams(location.search).get('dusk');
              if (q === '0' || q === '1') localStorage.setItem('bb.dusk', q);
              var pick = localStorage.getItem('bb.dusk');
              var d = new Date();
              var h = d.getHours() + d.getMinutes() / 60;
              var set = [17, 17.5, 18, 19, 19.5, 20, 20, 19.5, 18.5, 18, 17, 16.5][d.getMonth()];
              var rise = [7.2, 6.9, 6.4, 5.7, 5.3, 5.1, 5.3, 5.7, 6.1, 6.5, 6.9, 7.2][d.getMonth()];
              var dusk = pick ? pick === '1' : h >= set || h < rise;
              if (dusk) {
                document.documentElement.dataset.dusk = '1';
                var m = document.querySelector('meta[name="theme-color"]');
                if (m) m.setAttribute('content', '#E3D8C4');
              }
            } catch (e) {}
          })();
        </script>
      )
    }

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Brett Boggs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && (
      <meta property="article:modified_time" content={article.modified.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <slot name="head" />
  </head>
  <body>
    {home && <div class="ridge-ghost" id="ridge-ghost" aria-hidden="true"></div>}
    {scene && <div class="scene-ghost" id="scene-ghost" data-scene={scene} aria-hidden="true"></div>}
    <header class:list={['site-header', 'wrap', { 'over-film': home }]}>
      <a class="wordmark" href="/" aria-label="Brett Boggs, home">B<span class="wordmark-rest" aria-hidden="true">rett</span><span class="wordmark-b">B</span><span class="wordmark-rest" aria-hidden="true">oggs</span><span class="wordmark-dot">.</span></a>
      <nav>
        <a href="/work/">Work</a>
        <a href="/lab/">Lab</a>
        <a href="/about/">About</a>
        <a href="/store/">Store</a>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class:list={['site-footer', 'wrap', { floating: home }]} id="site-footer">
      <p>&copy; {year} Brett Boggs</p>
      {!home && (
        <nav class="foot-nav" aria-label="About this site">
          <a href="/colophon/">Colophon</a>
          <a href="/log/">Log</a>
          <a href="/resume/">Resume</a>
        </nav>
      )}
    </footer>
    {puck && (
      <nav class="puck" id="puck" aria-label="Quick navigation" data-here={here} data-home={home ? '1' : ''}>
        <button class="puck-face" id="puck-face" type="button" aria-expanded="false" aria-controls="puck-menu">
          <svg viewBox="0 0 56 56" fill="none" aria-hidden="true">
            <circle cx="28" cy="28" r="19" stroke="currentColor" stroke-width="1.75" />
            <g stroke="currentColor" stroke-width="1.5">
              <line x1="28" y1="3" x2="28" y2="9" />
              <line x1="28" y1="47" x2="28" y2="53" />
              <line x1="3" y1="28" x2="9" y2="28" />
              <line x1="47" y1="28" x2="53" y2="28" />
            </g>
            <line class="puck-needle" id="puck-needle" x1="28" y1="28" x2="28" y2="13" stroke="var(--sienna)" stroke-width="2" stroke-linecap="round" />
            <circle cx="28" cy="28" r="3" fill="var(--sunflower)" />
          </svg>
          <span class="puck-hidden">Open navigation</span>
        </button>
        <svg class="puck-stems" viewBox="0 0 160 160" aria-hidden="true">
          <line pathLength="1" x1="128.4" y1="112.3" x2="113.6" y2="30.4" />
          <line pathLength="1" x1="120.5" y1="115.8" x2="75.2" y2="56" />
          <line pathLength="1" x1="114.6" y1="122.3" x2="43.2" y2="88" />
          <line pathLength="1" x1="112.1" y1="129.2" x2="27.2" y2="126.4" />
        </svg>
        <ul class="puck-menu" id="puck-menu">
          <li><a href="/work/" data-deg="0" aria-current={here === 'work' ? 'page' : undefined}><span class="pk-num">01</span>Work</a></li>
          <li><a href="/lab/" data-deg="64" aria-current={here === 'lab' ? 'page' : undefined}><span class="pk-num">02</span>Lab</a></li>
          <li><a href="/about/" data-deg="-50" aria-current={here === 'about' ? 'page' : undefined}><span class="pk-num">03</span>About</a></li>
          <li><a href="/store/" data-deg="30" aria-current={here === 'store' ? 'page' : undefined}><span class="pk-num">04</span>Store</a></li>
        </ul>
      </nav>
    )}
    {!noServiceWorker && (
      <script>
        if (import.meta.env.PROD && 'serviceWorker' in navigator) {
          navigator.serviceWorker.register('/sw.js');
        }
      </script>
    )}
    <script>
      import { paintGhost, type SceneKey } from '../scripts/station';
      import { mountPeek } from '../scripts/peek';

      // index rows that carry a still show it beside the cursor
      mountPeek();

      // section pages: the zoomed crop stays under the page, ghost-faint
      const ghost = document.getElementById('scene-ghost');
      if (ghost) {
        const scene = ghost.dataset.scene as SceneKey;
        const paint = (): void => paintGhost(ghost, scene);
        paint();
        let raf = 0;
        window.addEventListener('resize', () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(paint);
        });
      }

      // the puck: the benchmark travelling with you once the header is gone
      const puckEl = document.getElementById('puck');
      if (puckEl) {
        const face = document.getElementById('puck-face')!;
        const needle = document.getElementById('puck-needle')!;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const links = Array.from(puckEl.querySelectorAll<HTMLElement>('.puck-menu a'));
        const homeDeg =
          links.find((a) => a.getAttribute('aria-current') === 'page')?.dataset.deg ?? '0';

        function aim(deg: string): void {
          needle.style.transform = `rotate(${deg}deg)`;
        }
        aim(homeDeg);

        // on the homepage the film owns the whole pinned stretch; everywhere
        // else the puck arrives as soon as the header has scrolled away
        function threshold(): number {
          if (puckEl!.dataset.home) return window.innerHeight * (reduced ? 0.9 : 2.9);
          return 200;
        }
        function onScroll(): void {
          const on = window.scrollY > threshold();
          puckEl!.classList.toggle('is-on', on);
          if (!on) setOpen(false);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        function setOpen(open: boolean): void {
          puckEl!.classList.toggle('is-open', open);
          face.setAttribute('aria-expanded', String(open));
          if (!open) aim(homeDeg);
        }
        face.addEventListener('click', () => setOpen(!puckEl.classList.contains('is-open')));
        puckEl.addEventListener('pointerenter', () => setOpen(true));
        puckEl.addEventListener('pointerleave', () => setOpen(false));
        puckEl.addEventListener('focusin', () => setOpen(true));
        puckEl.addEventListener('focusout', (e) => {
          if (!puckEl.contains(e.relatedTarget as Node)) setOpen(false);
        });
        links.forEach((a) => {
          const point = (): void => aim(a.dataset.deg ?? '0');
          a.addEventListener('pointerenter', point);
          a.addEventListener('focus', point);
        });
      }
    </script>
  </body>
</html>

<style>
  /* the film's last frame, left under the rest of the page. z-index -1 sits
     behind every section but still above the paper that propagates from body,
     so the footer reads over a ridge the scroll never quite finishes leaving.
     opacity is driven by the film scrub; it holds wherever the scrub left it. */
  .ridge-ghost {
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 0;
    pointer-events: none;
    background: center bottom / cover no-repeat;
    /* jpeg first so a browser without webp still gets the ridge; the image-set
       overrides it wherever webp is understood */
    background-image: url('/film/poster-end.jpg');
    background-image: image-set(
      url('/film/poster-end.webp') type('image/webp'),
      url('/film/poster-end.jpg') type('image/jpeg')
    );
    /* no top edge to give it away: the frame dissolves upward into paper and
       only the ridge and the low glow survive */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.4) 44%, #000 86%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.4) 44%, #000 86%);
  }
  /* same crop the film falls back to, so a phone gets the ridge framed rather
     than a 16:9 frame cropped to a sliver */
  @media (max-width: 500px) and (max-aspect-ratio: 3 / 4) {
    .ridge-ghost {
      background-image: url('/film/poster-end-portrait.jpg');
      background-image: image-set(
        url('/film/poster-end-portrait.webp') type('image/webp'),
        url('/film/poster-end-portrait.jpg') type('image/jpeg')
      );
    }
  }
  .site-header {
    /* held steady while the page beneath it turns (cross-document view transitions) */
    view-transition-name: site-header;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.75rem;
    padding-bottom: 1.75rem;
  }
  .site-header.over-film {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    z-index: 10;
  }
  .wordmark {
    font-family: var(--display);
    font-variation-settings: 'opsz' 40, 'SOFT' 60, 'WONK' 1;
    font-weight: 640;
    font-size: 1.35rem;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .wordmark-b {
    font-style: italic;
  }
  .wordmark-rest {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    opacity: 0;
    transition:
      max-width 0.55s var(--ease-warm),
      opacity 0.4s var(--ease-warm);
  }
  .wordmark:hover .wordmark-rest,
  .wordmark:focus-visible .wordmark-rest {
    max-width: 3.5em;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .wordmark-rest {
      transition: none;
    }
  }
  .wordmark-dot {
    color: var(--sunflower);
  }
  nav {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }
  nav a {
    color: var(--ink);
    font-weight: 500;
    font-size: 0.95rem;
  }
  main {
    min-height: 60vh;
  }
  .site-footer {
    margin-top: 5rem;
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    border-top: 2px solid var(--ink);
  }
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 2rem;
    flex-wrap: wrap;
  }
  .site-footer p {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .foot-nav {
    display: flex;
    gap: 1.4rem;
    margin-left: auto;
  }
  .foot-nav a {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--ink-soft);
  }
  .foot-nav a:hover,
  .foot-nav a:focus-visible {
    color: var(--rust);
  }
  /* the homepage ends on the film's settled frame: the footer is not part of
     the scroll there. it floats up over the render as the station assembles,
     driven by the scrub. */
  .site-footer.floating {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    max-width: none;
    margin: 0;
    padding: 0 1.5rem 1.1rem;
    border-top: none;
    z-index: 20;
    opacity: 0;
    pointer-events: none;
  }
  .site-footer.floating p {
    color: var(--paper);
    opacity: 0.85;
  }

  /* --- scene ghost: the zoom's landing crop, left under the page --- */
  .scene-ghost {
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 0;
    pointer-events: none;
    background: no-repeat;
    background-image: url('/film/poster-end.jpg');
    background-image: image-set(
      url('/film/poster-end-2x.webp') type('image/webp'),
      url('/film/poster-end.jpg') type('image/jpeg')
    );
    transition: opacity 0.9s var(--ease-warm);
  }

  /* --- the puck: the benchmark, condensed and travelling with you --- */
  .puck {
    position: fixed;
    right: 1.4rem;
    bottom: 1.4rem;
    z-index: 60;
    opacity: 0;
    transform: translateY(14px) scale(0.85);
    pointer-events: none;
    transition: opacity 0.4s var(--ease-warm), transform 0.5s var(--ease-warm);
  }
  .puck.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  /* The flags bloom OUTSIDE the puck's own box, which is just the 3.4rem face.
     Reaching for one takes the pointer out of .puck, pointerleave fires, and the
     menu closes before it can be clicked. This is an invisible bridge covering
     the bloom, so the pointer stays inside. It exists only while open, or it
     would sit over the page swallowing clicks, and z-index keeps it behind the
     flags rather than in front of them. */
  .puck.is-open::before {
    content: '';
    position: absolute;
    right: -0.6rem;
    bottom: -0.6rem;
    width: 14rem;
    height: 11rem;
    z-index: -1;
  }
  .puck-face {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 2px 14px rgba(51, 41, 28, 0.18);
    cursor: pointer;
  }
  .puck-face svg {
    width: 2.5rem;
    height: 2.5rem;
    overflow: visible;
  }
  .puck-face:focus-visible {
    outline: 2px solid var(--sienna);
    outline-offset: 3px;
  }
  .puck-needle {
    transform-origin: 28px 28px;
    transition: transform 0.55s var(--ease-warm);
  }
  /* a compass never sits perfectly still */
  @keyframes needle-drift {
    from { rotate: -2.5deg; }
    to { rotate: 2.5deg; }
  }
  .puck-needle {
    animation: needle-drift 2.4s ease-in-out infinite alternate;
  }
  /* stems draw from the puck's rim to each flag as the bloom opens, the same
     survey-leader language as the plate */
  .puck-stems {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 160px;
    height: 160px;
    overflow: visible;
    pointer-events: none;
  }
  .puck-stems line {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.4s var(--ease-warm);
    transition-delay: var(--out-delay, 0s);
  }
  .puck.is-open .puck-stems line {
    stroke-dashoffset: 0;
    transition-delay: var(--in-delay, 0s);
  }
  .puck-stems line:nth-child(1) { --in-delay: 0s;    --out-delay: 0.15s; }
  .puck-stems line:nth-child(2) { --in-delay: 0.05s; --out-delay: 0.1s; }
  .puck-stems line:nth-child(3) { --in-delay: 0.1s;  --out-delay: 0.05s; }
  .puck-stems line:nth-child(4) { --in-delay: 0.15s; --out-delay: 0s; }

  .puck-menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .puck-menu li {
    position: absolute;
    right: 1.7rem;
    bottom: 1.7rem;
  }
  /* flags, not buttons: numbered mono labels on a baseline rule, the rule
     carrying the graphic weight instead of a shadow */
  .puck-menu a {
    position: absolute;
    right: 0;
    bottom: 0;
    display: inline-block;
    transform: translate(0, 0) scale(0.8);
    opacity: 0;
    pointer-events: none;
    padding: 0.32rem 0.55rem 0.27rem;
    background: var(--paper);
    background-image: none;
    border-bottom: 2px solid var(--ink);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: transform 0.5s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.3s var(--ease-warm),
      border-color 0.3s var(--ease-warm), color 0.3s var(--ease-warm);
    transition-delay: var(--out-delay, 0s);
  }
  .puck.is-open .puck-menu a {
    transform: translate(var(--bloom-x), var(--bloom-y)) scale(1);
    opacity: 1;
    pointer-events: auto;
    transition-delay: var(--in-delay, 0s);
  }
  .pk-num {
    margin-right: 0.45rem;
    color: var(--ink-soft);
    transition: color 0.3s var(--ease-warm);
  }
  .puck-menu a:hover,
  .puck-menu a:focus-visible {
    border-color: var(--sunflower);
    color: var(--sienna);
  }
  .puck-menu a:hover .pk-num,
  .puck-menu a:focus-visible .pk-num {
    color: var(--sienna);
  }
  .puck-menu a[aria-current='page'] {
    border-color: var(--sunflower);
  }
  .puck-menu a[aria-current='page'] .pk-num {
    color: var(--sunflower);
  }
  .puck-menu li:nth-child(1) a { --bloom-x: -1.2rem; --bloom-y: -6.4rem; --in-delay: 0s;    --out-delay: 0.15s; }
