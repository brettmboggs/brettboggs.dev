---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '@fontsource/spline-sans-mono/400.css';
import '@fontsource/spline-sans-mono/500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  home?: boolean;
}

const { title, description = 'Brett Boggs. Work, experiments, writing.', home = false } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class:list={['site-header', 'wrap', { 'over-film': home }]}>
      <a class="wordmark" href="/" aria-label="Brett Boggs, home">B<span class="wordmark-rest" aria-hidden="true">rett</span><span class="wordmark-b">B</span><span class="wordmark-rest" aria-hidden="true">oggs</span><span class="wordmark-dot">.</span></a>
      <nav>
        <a href="/work/">Work</a>
        <a href="/lab/">Lab</a>
        <a href="/writing/">Writing</a>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>&copy; {year} Brett Boggs</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.75rem;
    padding-bottom: 1.75rem;
  }
  .site-header.over-film {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 100%;
    z-index: 10;
  }
  .wordmark {
    font-family: var(--display);
    font-variation-settings: 'opsz' 40, 'SOFT' 60, 'WONK' 1;
    font-weight: 640;
    font-size: 1.35rem;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .wordmark-b {
    font-style: italic;
  }
  .wordmark-rest {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    opacity: 0;
    transition:
      max-width 0.55s var(--ease-warm),
      opacity 0.4s var(--ease-warm);
  }
  .wordmark:hover .wordmark-rest,
  .wordmark:focus-visible .wordmark-rest {
    max-width: 3.5em;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .wordmark-rest {
      transition: none;
    }
  }
  .wordmark-dot {
    color: var(--sunflower);
  }
  nav {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }
  nav a {
    color: var(--ink);
    font-weight: 500;
    font-size: 0.95rem;
  }
  main {
    min-height: 60vh;
  }
  .site-footer {
    margin-top: 5rem;
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    border-top: 2px solid var(--ink);
  }
  .site-footer p {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
</style>
