# Both store values now DEFAULT to production in the code, because the CI build
# has no .env and a page built without one has to work. Everything here is an
# optional local override.
#
# Point at a Worker running locally (npx wrangler dev in tools/store):
# PUBLIC_STORE_API=http://127.0.0.1:8788
#
# Use a different Stripe publishable key. Publishable keys are meant to be in
# the browser; the SECRET key lives only in Cloudflare, set with wrangler secret.
# PUBLIC_STRIPE_PK=pk_test_...
