# Store front end. Both values are PUBLIC by design: the publishable key is
# meant to be in the browser bundle, and the API URL is just a hostname.
# The Stripe SECRET key is never here. It lives only in Cloudflare, set with
# `wrangler secret put` from tools/store.

# The deployed Worker. Point this at http://127.0.0.1:8788 instead only while
# running `wrangler dev` in tools/store, and remember to point it back.
PUBLIC_STORE_API=https://brettboggs-store.brettmboggs.workers.dev
PUBLIC_STRIPE_PK=pk_test_replace_me
